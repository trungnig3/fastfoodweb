@model IEnumerable<FastFoodWeb.Models.Product>
@{
    ViewData["Title"] = "FastFood Premium POS";
}

<!-- THÊM FONT CHỮ CAO CẤP VÀ CSS CUSTOM -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* ẨN HEADER MẶC ĐỊNH CỦA HỆ THỐNG ĐỂ LÀM FULL MÀN HÌNH POS */
    header, nav.navbar, .navbar { display: none !important; }
    main { padding-top: 0 !important; padding-bottom: 0 !important; }

    :root {
        --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
        --bg-color: #F8F9FA;
        --card-bg: #FFFFFF;
        --text-main: #2D3436;
        --text-muted: #636E72;
        --shadow-sm: 0 4px 15px rgba(0,0,0,0.03);
        --shadow-md: 0 10px 30px rgba(0,0,0,0.06);
        --shadow-hover: 0 20px 40px rgba(255, 107, 107, 0.15);
        --radius-lg: 24px;
        --radius-md: 16px;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
    }

    /* CUSTOM HEADER PREMIUM MỚI */
    .pos-header {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
        padding: 12px 24px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid rgba(255,255,255,0.4);
    }
    .pos-logo {
        font-weight: 900;
        font-size: 1.6rem;
        letter-spacing: -0.5px;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .shift-info-capsule {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--bg-color);
        padding: 8px 24px;
        border-radius: 100px;
        font-weight: 600;
        color: var(--text-muted);
        border: 1px solid #EBEBEB;
    }
    .btn-close-shift {
        background: white;
        border: 2px solid #FF6B6B;
        color: #FF6B6B;
        font-weight: 800;
        padding: 8px 24px;
        border-radius: 100px;
        transition: all 0.3s ease;
    }
    .btn-close-shift:hover {
        background: var(--primary-gradient);
        color: white;
        border-color: transparent;
        box-shadow: var(--shadow-hover);
        transform: translateY(-2px);
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #DFE6E9; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #B2BEC3; }

    .category-scroll {
        display: flex;
        overflow-x: auto;
        gap: 12px;
        padding-bottom: 10px;
        scrollbar-width: none; 
    }
    .category-scroll::-webkit-scrollbar { display: none; }
    
    .filter-btn {
        border: none;
        background: #fff;
        color: var(--text-muted);
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 100px;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }
    .filter-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }
    .filter-btn.active-filter {
        background: var(--primary-gradient);
        color: white;
        box-shadow: var(--shadow-hover);
    }

    .product-card {
        background: var(--card-bg);
        border-radius: var(--radius-lg);
        border: none;
        box-shadow: var(--shadow-sm);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
        cursor: pointer;
        position: relative;
    }
    .product-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: var(--shadow-hover);
    }
    .product-img-wrapper {
        padding: 12px;
        border-radius: var(--radius-lg);
    }
    .product-img {
        height: 140px;
        width: 100%;
        object-fit: cover;
        border-radius: var(--radius-md);
        transition: transform 0.5s ease;
    }
    .product-card:hover .product-img {
        transform: scale(1.05);
    }
    .product-price {
        font-weight: 800;
        font-size: 1.1rem;
        color: #FF6B6B;
    }
    .badge-combo {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #FDCB6E;
        color: #2D3436;
        font-weight: 700;
        border-radius: 8px;
        padding: 4px 10px;
        box-shadow: 0 4px 10px rgba(253, 203, 110, 0.3);
    }

    .bill-panel {
        background: var(--card-bg);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        border: none;
    }
    .bill-header {
        background: transparent;
        border-bottom: 1px dashed #DFE6E9;
        padding: 24px;
    }
    .cart-item-row {
        border-bottom: 1px solid #F1F2F6;
        transition: background 0.2s;
    }
    .cart-item-row:hover { background: #F8F9FA; }
    
    .btn-checkout {
        background: var(--primary-gradient);
        border: none;
        color: white;
        font-weight: 800;
        font-size: 1.2rem;
        border-radius: var(--radius-md);
        padding: 18px;
        box-shadow: var(--shadow-hover);
        transition: all 0.3s;
    }
    .btn-checkout:hover {
        transform: translateY(-3px);
        box-shadow: 0 25px 50px rgba(255, 107, 107, 0.25);
    }
    .btn-checkout:active { transform: translateY(0); }

    .custom-radio .form-check-input:checked {
        background-color: #FF6B6B;
        border-color: #FF6B6B;
    }
</style>

<div class="container-fluid py-3 px-4">
    
    <!-- HEADER PREMIUM MỚI -->
    <div class="pos-header">
        <div class="pos-logo">
            <i class="fas fa-hamburger me-2 text-warning"></i>FASTFOOD POS
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <div class="shift-info-capsule shadow-sm">
                <span><i class="far fa-clock text-primary me-1"></i> <span id="realTimeClock">00:00:00</span></span>
                <span class="border-start border-2 ps-3"><i class="fas fa-sun text-warning me-1"></i> Ca: @(DateTime.Now.Hour < 12 ? "Sáng" : (DateTime.Now.Hour < 18 ? "Chiều" : "Tối"))</span>
                <span class="border-start border-2 ps-3 text-dark fw-bold"><i class="fas fa-user-circle text-secondary fs-5 align-middle me-1"></i> @ViewBag.CashierName</span>
            </div>
            <button type="button" class="btn-close-shift" data-bs-toggle="modal" data-bs-target="#endShiftModal">
                <i class="fas fa-power-off me-1"></i> Đóng ca
            </button>
        </div>
    </div>
    
    <div class="row g-4">
        <!-- KHU VỰC THỰC ĐƠN (TRÁI) -->
        <div class="col-xl-8 col-lg-7">
            <div class="category-scroll mb-4">
                <button class="filter-btn active-filter" onclick="filterProducts('all', '', this)">🍔 Tất cả món</button>
                <button class="filter-btn" onclick="filterProducts('combo', '', this)">🔥 Combo Tiết Kiệm</button>
                @if (ViewBag.Categories != null)
                {
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <button class="filter-btn" onclick="filterProducts('category', '@cat.CategoryId', this)">@cat.CategoryName</button>
                    }
                }
            </div>
            
            <div class="pe-2" style="height: calc(100vh - 200px); overflow-y: auto;">
                <div class="row g-4" id="productGrid">
                    @if (!Model.Any())
                    {
                        <div class="col-12 text-center mt-5">
                            <img src="https://cdn-icons-png.flaticon.com/512/4359/4359695.png" width="120" style="opacity: 0.5" class="mb-3" />
                            <h4 class="text-muted fw-bold">Chưa có món ăn nào!</h4>
                        </div>
                    }
                    
                    @foreach (var item in Model)
                    {
                        <div class="col-xxl-3 col-xl-4 col-md-6 product-item" data-category="@item.CategoryId" data-combo="@item.IsCombo.ToString().ToLower()">
                            <div class="product-card h-100" onclick="addToCart(@item.ProductId, '@item.ProductName', @item.Price)">
                                @if (item.IsCombo) { <span class="badge-combo">Combo</span> }
                                
                                <div class="product-img-wrapper">
                                    <img src="@(string.IsNullOrEmpty(item.ImageURL) ? "https://placehold.co/300x300?text=" + item.ProductName : item.ImageURL)" class="product-img" alt="@item.ProductName">
                                </div>
                                <div class="card-body px-3 pb-4 text-center">
                                    <h6 class="fw-bold mb-2 text-truncate" title="@item.ProductName">@item.ProductName</h6>
                                    <div class="product-price">@item.Price.ToString("N0") <span style="font-size:0.8rem">đ</span></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- KHU VỰC HÓA ĐƠN (PHẢI) -->
        <div class="col-xl-4 col-lg-5">
            <div class="bill-panel h-100 d-flex flex-column">
                
                <div class="bill-header d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Hóa đơn hiện tại</h5>
                    <span id="cartBadgeCount" class="badge bg-dark rounded-pill fs-6 px-3 py-2 shadow-sm">0 món</span>
                </div>
                
                <div class="flex-grow-1 p-0" style="overflow-y: auto; min-height: 220px;">
                    <table class="table table-borderless mb-0 align-middle">
                        <tbody id="cartItems">
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <img src="https://cdn-icons-png.flaticon.com/512/102/102665.png" width="50" style="opacity: 0.2" class="mb-3" />
                                    <p class="text-muted fw-medium mb-0">Chưa có món nào được chọn</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="p-4" style="background: #FAFBFC; border-radius: 0 0 var(--radius-lg) var(--radius-lg);">
                    <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden">
                        <span class="input-group-text bg-white border-0 ps-4"><i class="fas fa-search text-muted"></i> SĐT:</span>
                        <input type="text" id="txtPhone" class="form-control border-0 px-2" placeholder="Nhập tích điểm...">
                        <button class="btn btn-dark px-4 fw-bold" type="button" onclick="searchCustomer()">Tìm</button>
                    </div>
                    
                    <!-- THÔNG TIN KHÁCH HÀNG & TÙY CHỌN DÙNG ĐIỂM -->
                    <div id="customerInfo" class="d-none mb-3 bg-white p-3 rounded-3 shadow-sm border border-success border-opacity-25">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <p class="mb-0 text-success fw-bold fs-6" id="cusName">Khách: ...</p>
                                <p class="mb-0 text-muted small">Điểm tích lũy: <span class="text-danger fw-bold" id="cusPoints">0</span> (<span id="cusTier">Đồng</span>)</p>
                            </div>
                            <i class="fas fa-check-circle text-success fs-3"></i>
                        </div>
                        
                        <!-- Ô TÍCH CHỌN DÙNG ĐIỂM GIẢM GIÁ -->
                        <div class="form-check pt-2 border-top d-none" id="pointCheckboxWrapper">
                            <input class="form-check-input" type="checkbox" id="chkUsePoints" onchange="updateCartUI()">
                            <label class="form-check-label fw-bold text-primary" style="font-size: 0.85rem;" for="chkUsePoints">
                                🔥 Dùng điểm giảm giá (1 điểm = 1.000đ)
                            </label>
                        </div>
                        
                        <input type="hidden" id="currentCustomerId" value="" />
                    </div>

                    <div id="customerNotFound" class="d-none mb-3 text-center">
                        <span class="badge bg-success bg-opacity-10 text-success py-2 px-3 border border-success border-opacity-25 rounded-pill">
                            ✨ Khách mới. Tự động tạo thẻ tích điểm khi thanh toán!
                        </span>
                    </div>

                    <div class="d-flex gap-4 mb-3 custom-radio justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="payCash" value="Cash" checked>
                            <label class="form-check-label fw-bold text-secondary" for="payCash">💵 Tiền mặt</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="payVnPay" value="VnPay">
                            <label class="form-check-label fw-bold text-primary" for="payVnPay">
                                <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/9/06ncktiwd6dc1694418196384.png" height="18" class="me-1"> QR Code
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted fw-semibold">Tạm tính:</span>
                        <span class="fw-bold" id="subTotalAmount">0 đ</span>
                    </div>

                    <!-- DÒNG HIỂN THỊ GIẢM GIÁ ĐIỂM -->
                    <div id="pointDiscountRow" class="d-flex justify-content-between mb-2 text-danger d-none">
                        <span class="fw-semibold">Dùng điểm giảm:</span>
                        <span id="pointDiscountAmount" class="fw-bold">-0 đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4 align-items-end">
                        <span class="text-muted fw-bold">Tổng tiền:</span>
                        <span id="totalAmount" class="fw-black" style="font-size: 2rem; font-weight: 800; color: #FF6B6B; line-height: 1;">0 đ</span>
                    </div>
                    
                    <button class="btn-checkout w-100" onclick="processCheckout()">
                        THANH TOÁN NGAY
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- KHU VỰC LỊCH SỬ HÓA ĐƠN -->
    <div class="card shadow-sm mt-4 border-0" style="border-radius: var(--radius-lg);">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center" style="border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
            <h5 class="mb-0 fw-bold" style="color: #2F3542;">
                <i class="fas fa-receipt me-2 text-primary"></i>Lịch sử hóa đơn trong ca
            </h5>
            
            <div class="d-flex gap-2">
                <input type="text" id="searchOrderCode" class="form-control form-control-sm rounded-pill px-3" placeholder="Tìm theo mã đơn..." style="width: 200px;">
                <select id="filterPayment" class="form-select form-select-sm rounded-pill px-3" style="width: 150px;">
                    <option value="">Tất cả</option>
                    <option value="VNPAY">VNPAY</option>
                    <option value="Cash">Tiền mặt</option>
                </select>
                <button class="btn btn-sm btn-dark rounded-pill px-3 fw-bold" onclick="loadOrderHistory()">
                    <i class="fas fa-filter"></i> Lọc
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th class="ps-4 text-muted fw-bold">Mã Đơn</th>
                            <th class="text-muted fw-bold">Thời gian</th>
                            <th class="text-muted fw-bold">Khách hàng / Địa chỉ</th>
                            <th class="text-muted fw-bold">Thanh toán</th>
                            <th class="text-end text-muted fw-bold">Tổng tiền</th>
                            <th class="text-center text-muted fw-bold">Trạng thái</th>
                            <th class="text-center pe-4 text-muted fw-bold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="orderHistoryBody">
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu hóa đơn...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- POPUP MỞ CA -->
<div class="modal fade" id="startCashModal" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: var(--radius-lg); overflow: hidden;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h4 class="modal-title fw-bold text-primary">👋 Bắt đầu ca làm việc</h4>
            </div>
            <div class="modal-body px-4 py-3">
                <p class="text-muted mb-4">Nhập số tiền lẻ có sẵn trong két để hệ thống đối soát chính xác cuối ngày.</p>
                <div class="form-floating mb-3">
                    <input type="number" id="inputStartingCash" class="form-control fw-bold text-primary fs-4" style="height: 70px; border-radius: var(--radius-md);" value="500000" min="0" step="10000">
                    <label>Số tiền đầu ca (VNĐ)</label>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-primary w-100 fw-bold py-3 fs-5" style="border-radius: var(--radius-md);" onclick="saveStartCash()">XÁC NHẬN VÀO CA</button>
            </div>
        </div>
    </div>
</div>

<!-- POPUP ĐÓNG CA -->
<div class="modal fade" id="endShiftModal" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0" style="border-radius: var(--radius-lg); overflow: hidden;">
            <div class="modal-header bg-danger text-white border-0 py-3 px-4">
                <h5 class="modal-title fw-bold">🛑 Đóng Ca & Đối Soát Doanh Thu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <div class="card bg-light border-0 mb-3" style="border-radius: var(--radius-md);">
                    <div class="card-body py-3">
                        <h6 class="fw-bold text-dark mb-2"><i class="fas fa-box-open text-warning me-2"></i>Số lượng món đã bán trong ca</h6>
                        <div id="soldItemsSummary" class="d-flex flex-wrap gap-2" style="max-height: 120px; overflow-y: auto;">
                            <span class="text-muted small">Đang tính toán...</span>
                        </div>
                    </div>
                </div>

                <div class="card bg-light border-0 mb-4" style="border-radius: var(--radius-md);">
                    <div class="card-body py-3">
                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-clipboard-check text-primary me-2"></i>Tóm tắt dòng tiền</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between p-2 border-bottom">
                                    <span class="text-muted">Tiền lẻ đầu ca:</span>
                                    <span class="fw-bold" id="summaryStartCash">0 đ</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between p-2 border-bottom">
                                    <span class="text-muted">Doanh thu VNPAY:</span>
                                    <span class="fw-bold text-primary" id="summaryVnPay">0 đ</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between p-2 border-bottom">
                                    <span class="text-muted">Doanh thu Tiền mặt:</span>
                                    <span class="fw-bold text-success" id="summaryCash">0 đ</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between p-2 bg-white rounded shadow-sm border border-danger border-opacity-25">
                                    <span class="fw-bold text-danger">Tiền trong két (Lý thuyết):</span>
                                    <span class="fw-black text-danger fs-5" id="summaryExpectedCash" data-expected="0">0 đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-2">
                    <input type="number" id="inputActualCash" class="form-control fw-bold text-danger fs-3" style="height: 80px; border-radius: var(--radius-md);" placeholder="0" min="0" step="1000" oninput="calculateDifference()" />
                    <label>Tổng tiền mặt ĐẾM ĐƯỢC (VNĐ)</label>
                </div>
                <div id="cashDifferenceAlert" class="text-center fw-bold fs-6" style="min-height: 24px;"></div>
            </div>
            <div class="modal-footer border-0 bg-light px-4 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger fw-bold px-5 py-2" onclick="closeShift()">Chốt Ca</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT HÓA ĐƠN -->
<div class="modal fade" id="invoiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: none;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold">Chi tiết hóa đơn <span id="modalInvoiceCode" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <div class="d-flex justify-content-between mb-3 small text-muted">
                    <span id="modalInvoiceDate"></span>
                    <span id="modalInvoiceCashier"></span>
                </div>
                <hr class="border-secondary border-opacity-25 border-dashed mb-3">
                <div id="modalInvoiceItems" class="mb-3" style="max-height: 250px; overflow-y: auto;"></div>
                <hr class="border-secondary border-opacity-25 border-dashed my-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tổng tiền hàng:</span>
                    <span id="modalSubTotal" class="fw-semibold"></span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Phí vận chuyển:</span>
                    <span id="modalShippingFee" class="fw-semibold"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mt-2">
                    <span class="fw-bold">TỔNG CỘNG:</span>
                    <span id="modalTotalAmount" class="fw-black text-danger fs-4"></span>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill fw-bold px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        let currentInvoices = [];
        let availableCustomerPoints = 0;

        function updateClock() {
            const now = new Date();
            document.getElementById('realTimeClock').innerText = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();

        document.addEventListener('DOMContentLoaded', function () {
            if ('@ViewBag.ShowStartCashModal' === 'True') {
                new bootstrap.Modal(document.getElementById('startCashModal')).show();
            }
            loadOrderHistory();

            // SỬ DỤNG TRỰC TIẾP MẢNG currentInvoices ĐANG HIỂN THỊ ĐỂ TÍNH TOÁN ĐÓNG CA
            var endShiftModalEl = document.getElementById('endShiftModal');
            if (endShiftModalEl) {
                endShiftModalEl.addEventListener('show.bs.modal', function (event) {
                    document.getElementById('soldItemsSummary').innerHTML = '<span class="text-muted small"><i class="fas fa-spinner fa-spin me-1"></i> Đang tổng hợp dữ liệu...</span>';

                    let startCashInput = document.getElementById('inputStartingCash').value;
                    let startingCash = parseFloat(startCashInput) || 500000;

                    let shiftOrders = currentInvoices || [];
                    let totalVnPay = 0;
                    let totalCash = 0;
                    let soldItemsDict = {};

                    if (shiftOrders.length > 0) {
                        shiftOrders.forEach(order => {
                            let status = (order.status || "").toLowerCase();
                            if (!status.includes("hủy")) {
                                let payment = (order.payment || "").toLowerCase();
                                if (payment.includes("vnpay") || payment.includes("qr")) {
                                    totalVnPay += order.total;
                                } else {
                                    totalCash += order.total;
                                }

                                // Tổng hợp đúng các món có trong hóa đơn của ca
                                if (order.items && order.items.length > 0) {
                                    order.items.forEach(item => {
                                        if (soldItemsDict[item.name]) {
                                            soldItemsDict[item.name] += item.qty;
                                        } else {
                                            soldItemsDict[item.name] = item.qty;
                                        }
                                    });
                                }
                            }
                        });
                    }

                    // Render danh sách món đã bán trong ca
                    let itemsHtml = '';
                    for (const [itemName, totalQty] of Object.entries(soldItemsDict)) {
                        itemsHtml += `<span class="badge bg-white text-dark border px-3 py-2 shadow-sm fs-6 d-flex align-items-center gap-2">
                            ${itemName} <span class="badge bg-danger rounded-pill">${totalQty}</span>
                        </span>`;
                    }
                    if (itemsHtml === '') itemsHtml = '<span class="text-muted small fst-italic">Chưa có món nào được bán ra trong ca này.</span>';
                    document.getElementById('soldItemsSummary').innerHTML = itemsHtml;

                    // Render tổng hợp dòng tiền
                    let expectedCash = startingCash + totalCash;
                    document.getElementById('summaryStartCash').innerText = formatMoney(startingCash) + ' đ';
                    document.getElementById('summaryVnPay').innerText = formatMoney(totalVnPay) + ' đ';
                    document.getElementById('summaryCash').innerText = formatMoney(totalCash) + ' đ';

                    let expectedLabel = document.getElementById('summaryExpectedCash');
                    expectedLabel.innerText = formatMoney(expectedCash) + ' đ';
                    expectedLabel.setAttribute('data-expected', expectedCash);

                    document.getElementById('inputActualCash').value = "";
                    document.getElementById('cashDifferenceAlert').innerHTML = "";
                });
            }
        });

        const formatMoney = (amount) => amount.toLocaleString('vi-VN');

        function calculateDifference() {
            let inputVal = document.getElementById('inputActualCash').value;
            let alertBox = document.getElementById('cashDifferenceAlert');
            let expectedCash = parseFloat(document.getElementById('summaryExpectedCash').getAttribute('data-expected')) || 0;

            if (!inputVal) {
                alertBox.innerHTML = "";
                return;
            }

            let actualCash = parseFloat(inputVal);
            let diff = actualCash - expectedCash;

            if (diff === 0) {
                alertBox.innerHTML = `<span class="text-success"><i class="fas fa-check-circle me-1"></i>Khớp chuẩn xác! Không thừa, không thiếu.</span>`;
            } else if (diff > 0) {
                alertBox.innerHTML = `<span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Đang THỪA ${formatMoney(diff)} đ so với lý thuyết.</span>`;
            } else {
                alertBox.innerHTML = `<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Đang THIẾU ${formatMoney(Math.abs(diff))} đ so với lý thuyết.</span>`;
            }
        }

        function filterProducts(type, value, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active-filter'));
            btn.classList.add('active-filter');

            document.querySelectorAll('.product-item').forEach(item => {
                const catId = item.getAttribute('data-category');
                const isCombo = item.getAttribute('data-combo');
                if (type === 'all') item.style.display = 'block';
                else if (type === 'combo') item.style.display = (isCombo === 'true') ? 'block' : 'none';
                else if (type === 'category') item.style.display = (catId === value) ? 'block' : 'none';
            });
        }

        function addToCart(id, name, price) {
            let item = cart.find(i => i.id === id);
            if (item) item.quantity += 1;
            else cart.push({ id: id, name: name, price: price, quantity: 1 });
            updateCartUI();
        }

        function changeQuantity(id, change) {
            let idx = cart.findIndex(i => i.id === id);
            if (idx > -1) {
                cart[idx].quantity += change;
                if (cart[idx].quantity <= 0) cart.splice(idx, 1);
                updateCartUI();
            }
        }

        function removeItem(id) {
            cart = cart.filter(i => i.id !== id);
            updateCartUI();
        }

        function updateCartUI() {
            const cartItems = document.getElementById("cartItems");
            const subTotalSpan = document.getElementById("subTotalAmount");
            const totalAmountSpan = document.getElementById("totalAmount");
            const badgeCount = document.getElementById("cartBadgeCount");
            const pointDiscountRow = document.getElementById("pointDiscountRow");
            const pointDiscountAmount = document.getElementById("pointDiscountAmount");
            
            cartItems.innerHTML = "";
            let subTotal = 0;
            let totalQuantity = 0;

            if (cart.length === 0) {
                cartItems.innerHTML = `<tr><td colspan="4" class="text-center py-5"><img src="https://cdn-icons-png.flaticon.com/512/102/102665.png" width="50" style="opacity: 0.2" class="mb-3" /><p class="text-muted fw-medium mb-0">Chưa có món nào được chọn</p></td></tr>`;
                subTotalSpan.innerText = "0 đ";
                totalAmountSpan.innerText = "0 đ";
                badgeCount.innerText = "0 món";
                pointDiscountRow.classList.add("d-none");
                return;
            }

            cart.forEach(item => {
                let itemTotal = item.price * item.quantity;
                subTotal += itemTotal;
                totalQuantity += item.quantity;

                let tr = document.createElement("tr");
                tr.className = "cart-item-row";
                tr.innerHTML = `
                    <td class="fw-bold py-3" style="width: 45%;">${item.name}</td>
                    <td style="width: 25%;" class="py-3">
                        <div class="input-group input-group-sm rounded-pill overflow-hidden shadow-sm bg-white">
                            <button class="btn btn-light border-0 px-2 fw-bold" onclick="changeQuantity(${item.id}, -1)">-</button>
                            <input type="text" class="form-control text-center border-0 fw-bold bg-white px-0" value="${item.quantity}" readonly>
                            <button class="btn btn-light border-0 px-2 fw-bold" onclick="changeQuantity(${item.id}, 1)">+</button>
                        </div>
                    </td>
                    <td class="text-end fw-bold py-3" style="width: 20%; color: #FF6B6B;">${formatMoney(itemTotal)}</td>
                    <td class="text-end py-3" style="width: 10%;">
                        <button class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" style="width:28px; height:28px; padding:0;" onclick="removeItem(${item.id})"><i class="fas fa-times"></i></button>
                    </td>
                `;
                cartItems.appendChild(tr);
            });

            subTotalSpan.innerText = formatMoney(subTotal) + " đ";

            let discount = 0;
            const usePointsCheckbox = document.getElementById("chkUsePoints");
            if (usePointsCheckbox && usePointsCheckbox.checked && availableCustomerPoints > 0) {
                discount = availableCustomerPoints * 1000;
                if (discount > subTotal) discount = subTotal;
                pointDiscountRow.classList.remove("d-none");
                pointDiscountAmount.innerText = "-" + formatMoney(discount) + " đ";
            } else {
                pointDiscountRow.classList.add("d-none");
            }

            let finalTotal = subTotal - discount;
            totalAmountSpan.innerText = formatMoney(finalTotal) + " đ";
            badgeCount.innerText = `${totalQuantity} món`;
        }

        function searchCustomer() {
            const phone = document.getElementById("txtPhone").value.trim();
            if (!phone) return alert("Vui lòng nhập số điện thoại!");

            fetch(`/Pos/FindCustomer?phone=${phone}`)
            .then(res => res.json())
            .then(data => {
                const pointWrapper = document.getElementById("pointCheckboxWrapper");
                const usePointsChk = document.getElementById("chkUsePoints");

                if (data.found) {
                    document.getElementById("customerInfo").classList.remove("d-none");
                    document.getElementById("customerNotFound").classList.add("d-none");
                    
                    document.getElementById("cusName").innerText = "Khách: " + data.name;
                    document.getElementById("cusPoints").innerText = data.points;
                    document.getElementById("cusTier").innerText = data.tier;
                    document.getElementById("currentCustomerId").value = data.id;

                    availableCustomerPoints = data.points;
                    
                    if (availableCustomerPoints > 0) {
                        pointWrapper.classList.remove("d-none");
                        usePointsChk.checked = false;
                    } else {
                        pointWrapper.classList.add("d-none");
                        usePointsChk.checked = false;
                    }
                } else {
                    document.getElementById("customerInfo").classList.add("d-none");
                    document.getElementById("customerNotFound").classList.remove("d-none");
                    document.getElementById("currentCustomerId").value = "";
                    availableCustomerPoints = 0;
                    pointWrapper.classList.add("d-none");
                }
                updateCartUI();
            });
        }

        function processCheckout() {
            if (cart.length === 0) return alert("Giỏ hàng đang trống!");

            const phone = document.getElementById("txtPhone").value.trim();
            const custIdStr = document.getElementById("currentCustomerId").value;
            const customerId = custIdStr ? parseInt(custIdStr) : null;
            const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
            const usePoints = document.getElementById("chkUsePoints")?.checked || false;

            const payload = {
                Items: cart.map(i => ({ Id: i.id, Quantity: i.quantity })),
                CustomerId: customerId,
                CustomerPhone: (!customerId && phone) ? phone : null,
                PaymentMethod: paymentMethod,
                UsePoints: usePoints
            };

            const btn = document.querySelector(".btn-checkout");
            btn.innerHTML = "<i class='fas fa-spinner fa-spin'></i> ĐANG XỬ LÝ...";
            btn.disabled = true;

            fetch('/Pos/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.isRedirect) {
                        window.location.href = data.redirectUrl;
                    } else {
                        let msg = `Thanh toán thành công!\nMã HĐ: ${data.orderCode}`;
                        if (data.points > 0) msg += `\n🌟 Khách hàng được cộng: ${data.points} điểm mới!`;
                        alert(msg);
                        
                        cart = [];
                        availableCustomerPoints = 0;
                        updateCartUI();
                        document.getElementById("txtPhone").value = "";
                        document.getElementById("customerInfo").classList.add("d-none");
                        document.getElementById("customerNotFound").classList.add("d-none");
                        document.getElementById("currentCustomerId").value = "";
                        loadOrderHistory();
                    }
                } else alert("Lỗi: " + data.message);
            })
            .finally(() => {
                btn.innerHTML = "THANH TOÁN NGAY";
                btn.disabled = false;
            });
        }

        async function loadOrderHistory() {
            const searchCode = document.getElementById("searchOrderCode").value.trim();
            const paymentMethod = document.getElementById("filterPayment").value;
            const tbody = document.getElementById("orderHistoryBody");
            
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu hóa đơn...</td></tr>';

            try {
                const response = await fetch(`/Pos/GetOrderHistory?searchCode=${searchCode}&paymentMethod=${paymentMethod}`);
                const textResponse = await response.text();
                
                let data;
                try {
                    data = JSON.parse(textResponse);
                } catch (e) {
                    throw new Error("Máy chủ trả về định dạng không hợp lệ.");
                }

                if (data.success) {
                    currentInvoices = data.orders;
                    renderOrderTable(currentInvoices);
                } else {
                    tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Lỗi từ Server: ${data.message}</td></tr>`;
                }
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-4 text-danger">Lỗi kết nối: ${error.message}</td></tr>`;
            }
        }

        function renderOrderTable(orders) {
            const tbody = document.getElementById("orderHistoryBody");
            tbody.innerHTML = "";

            if (!orders || orders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Không tìm thấy hóa đơn nào trong ca.</td></tr>';
                return;
            }

            orders.forEach(order => {
                let badgeColor = (order.status && order.status.toLowerCase().includes("hoàn thành")) ? "bg-success" : "bg-secondary";
                let payIcon = (order.payment && order.payment.toLowerCase().includes("vnpay")) ? '<i class="fas fa-qrcode text-primary me-1"></i>' : '<i class="fas fa-money-bill-wave text-success me-1"></i>';

                let tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="ps-4 fw-bold" style="font-size: 0.9rem;">${order.orderCode}</td>
                    <td class="small text-muted">${formatDateTime(order.date)}</td>
                    <td style="max-width: 200px;" class="text-truncate" title="${order.address}">${order.address}</td>
                    <td class="small">${payIcon} ${order.payment}</td>
                    <td class="text-end fw-semibold text-danger">${formatMoney(order.total)} đ</td>
                    <td class="text-center"><span class="badge ${badgeColor} rounded-pill px-2 py-1">${order.status}</span></td>
                    <td class="text-center pe-4">
                        <button class="btn btn-sm btn-light border shadow-sm rounded-circle" style="width:32px; height:32px; padding:0" onclick="viewInvoiceDetail('${order.orderCode}')" title="Xem chi tiết">
                            <i class="fas fa-eye text-primary"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function formatDateTime(dateString) {
            if (!dateString) return "";
            const d = new Date(dateString);
            return `${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')} - ${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;
        }

        function viewInvoiceDetail(orderCode) {
            const order = currentInvoices.find(o => o.orderCode === orderCode);
            if (!order) return;

            document.getElementById("modalInvoiceCode").innerText = "#" + order.orderCode;
            document.getElementById("modalInvoiceDate").innerText = "Ngày: " + formatDateTime(order.date);
            document.getElementById("modalInvoiceCashier").innerText = "Thu ngân: " + order.cashier;
            
            document.getElementById("modalSubTotal").innerText = formatMoney(order.subTotal) + " đ";
            document.getElementById("modalShippingFee").innerText = formatMoney(order.shippingFee) + " đ";
            document.getElementById("modalTotalAmount").innerText = formatMoney(order.total) + " đ";

            const itemsContainer = document.getElementById("modalInvoiceItems");
            itemsContainer.innerHTML = "";
            if (order.items && order.items.length > 0) {
                order.items.forEach(item => {
                    itemsContainer.innerHTML += `
                        <div class="d-flex justify-content-between mb-2">
                            <div style="width: 70%;" class="text-truncate">
                                <span class="fw-bold me-1">${item.qty}x</span> ${item.name}
                            </div>
                            <div class="text-end text-muted small fw-semibold">${formatMoney(item.price * item.qty)} đ</div>
                        </div>
                    `;
                });
            } else {
                itemsContainer.innerHTML = '<p class="text-muted small">Không có chi tiết món.</p>';
            }

            new bootstrap.Modal(document.getElementById('invoiceModal')).show();
        }

        function saveStartCash() {
            let cash = document.getElementById('inputStartingCash').value;
            if (cash === "" || cash < 0) return alert("Vui lòng nhập tiền hợp lệ!");
            fetch('/Pos/SaveStartingCash', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'startingCash=' + cash })
            .then(res => res.json()).then(data => { if (data.success) bootstrap.Modal.getInstance(document.getElementById('startCashModal')).hide(); else alert(data.message); });
        }

        function closeShift() {
            let actual = document.getElementById('inputActualCash').value;
            if (actual === "" || actual < 0) return alert("Vui lòng nhập số tiền thực tế!");
            fetch('/Pos/CloseShift', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'actualCash=' + actual })
            .then(res => res.json()).then(data => { if (data.success) window.location.href = '/Pos/EndShiftReport'; else alert(data.message); });
        }
    </script>
}