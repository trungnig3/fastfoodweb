@model IEnumerable<FastFoodWeb.Models.Product>
@{
    ViewData["Title"] = "Đặt Món Trực Tuyến - FastFood Express";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #FF4757;
            --primary-gradient: linear-gradient(135deg, #FF4757 0%, #FF6B81 100%);
            --bg-color: #F4F7F6;
            --card-bg: #FFFFFF;
            --text-main: #2F3542;
            --text-muted: #747D8C;
            --shadow-sm: 0 4px 15px rgba(0,0,0,0.04);
            --shadow-md: 0 10px 30px rgba(0,0,0,0.08);
            --shadow-hover: 0 20px 40px rgba(255, 71, 87, 0.2);
            --radius-lg: 24px;
            --radius-md: 16px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
        }

        .shop-header {
            background: var(--primary-gradient);
            padding: 15px 0;
            box-shadow: 0 4px 20px rgba(255, 71, 87, 0.3);
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .shop-logo {
            color: white;
            font-weight: 800;
            font-size: 1.4rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-complaint {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 100px;
            padding: 8px 20px;
            font-weight: 600;
            transition: all 0.3s;
            text-decoration: none;
        }
        .btn-complaint:hover { background: white; color: var(--primary); }

        .product-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            border: none;
            box-shadow: var(--shadow-sm);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .product-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-hover); }
        .product-img-wrapper { padding: 15px; border-radius: var(--radius-lg); overflow: hidden; }
        .product-img {
            height: 160px;
            width: 100%;
            object-fit: cover;
            border-radius: var(--radius-md);
            transition: transform 0.5s ease;
        }
        .product-card:hover .product-img { transform: scale(1.08); }
        .product-info { padding: 0 20px 20px 20px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .product-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 5px; }
        .product-price { font-weight: 800; color: var(--primary); font-size: 1.2rem; }
        
        .btn-add-cart {
            background: #F1F2F6;
            color: var(--primary);
            border: none;
            border-radius: 100px;
            padding: 10px;
            font-weight: 700;
            transition: all 0.3s;
            width: 100%;
            margin-top: 15px;
        }
        .btn-add-cart:hover { background: var(--primary-gradient); color: white; box-shadow: 0 5px 15px rgba(255, 71, 87, 0.3); }

        .sidebar-panel { background: var(--card-bg); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 24px; }
        .cart-title { font-weight: 800; border-bottom: 2px dashed #F1F2F6; padding-bottom: 15px; margin-bottom: 15px; }
        
        .form-custom { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 12px 15px; font-size: 0.95rem; transition: all 0.3s; }
        .form-custom:focus { background: white; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(255, 71, 87, 0.1); outline: none; }

        .btn-checkout {
            background: var(--primary-gradient);
            color: white;
            border: none;
            border-radius: 14px;
            padding: 16px;
            font-weight: 800;
            font-size: 1.1rem;
            width: 100%;
            box-shadow: 0 10px 20px rgba(255, 71, 87, 0.25);
            transition: all 0.3s;
        }
        .btn-checkout:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(255, 71, 87, 0.35); }
        
        /* Chỉnh sửa giao diện Chatbot thực tế */
        .chatbot-panel { background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%); border: 1px solid #BAE6FD; border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-sm); margin-top: 20px; display: flex; flex-direction: column; height: 420px; }
        .bot-icon { background: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.05); color: #0EA5E9; font-size: 1.2rem; }
        .chat-container { flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; margin-bottom: 15px; padding-right: 5px; }
        /* Tùy chỉnh thanh cuộn tin nhắn */
        .chat-container::-webkit-scrollbar { width: 5px; }
        .chat-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .msg-bubble { padding: 10px 15px; border-radius: 15px; font-size: 0.9rem; max-width: 85%; word-wrap: break-word; }
        .bot-msg { background: white; color: #334155; align-self: flex-start; border: 1px solid #e2e8f0; border-bottom-left-radius: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.02); }
        .user-msg { background: #0EA5E9; color: white; align-self: flex-end; border-bottom-right-radius: 4px; box-shadow: 0 2px 5px rgba(14, 165, 233, 0.2); }
    </style>
</head>
<body>

    <header class="shop-header">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/Shop" class="shop-logo">
                <i class="fas fa-motorcycle fs-3"></i> FastFood Express
            </a>
            <a href="/Complaint" class="btn-complaint">
                <i class="fas fa-envelope-open-text me-1"></i> Gửi Khiếu Nại
            </a>
        </div>
    </header>

    <div class="container py-5">
        <div class="row g-4">
            
            <!-- DANH SÁCH MÓN ĂN -->
            <div class="col-xl-8 col-lg-7">
                <h3 class="fw-bold mb-4" style="color: #2F3542;">Thực đơn hôm nay</h3>
                
                <div class="row g-4">
                    @if(Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="product-card">
                                    <div class="product-img-wrapper">
                                        <img src="@(string.IsNullOrEmpty(item.ImageURL) ? "https://placehold.co/300x200?text=" + item.ProductName : item.ImageURL)" class="product-img" alt="@item.ProductName">
                                    </div>
                                    <div class="product-info text-center">
                                        <div>
                                            <h4 class="product-title text-truncate" title="@item.ProductName">@item.ProductName</h4>
                                            <div class="product-price">@item.Price.ToString("N0") đ</div>
                                        </div>
                                        <button class="btn-add-cart" onclick="addToCart(@item.ProductId, '@item.ProductName', @item.Price)">
                                            <i class="fas fa-plus me-1"></i> Chọn món
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- CỘT PHẢI: GIỎ HÀNG VÀ CHATBOT -->
            <div class="col-xl-4 col-lg-5">
                
                <!-- Bảng Giỏ Hàng -->
                <div class="sidebar-panel">
                    <h5 class="cart-title"><i class="fas fa-shopping-bag text-danger me-2"></i>Giỏ hàng của bạn</h5>
                    
                    <div id="cartItemsList" style="max-height: 220px; overflow-y: auto; margin-bottom: 15px;">
                        <div class="text-center py-4 text-muted" id="emptyCartMsg">
                            <i class="fas fa-shopping-cart fs-1 mb-2 opacity-25"></i>
                            <p class="mb-0">Chưa có món ăn</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold text-muted">Tổng tiền:</span>
                        <span class="fw-black fs-4 text-danger" id="cartTotalAmount">0 đ</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Địa chỉ giao hàng tận nơi:</label>
                        <textarea class="form-control form-custom w-100" id="txtAddress" rows="2" 
                                  placeholder="Nhập địa chỉ & click ra ngoài để đo đường thực tế..." 
                                  onblur="calculateShipping()"></textarea>
                        <div id="shippingStatus" class="small mt-2" style="font-weight: 600;"></div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small">Phương thức thanh toán:</label>
                        <select class="form-select form-custom w-100" id="cbPaymentMethod">
                            <option value="COD">Tiền mặt khi nhận hàng (COD)</option>
                            <option value="VNPAY">Thanh toán VNPAY QR</option>
                        </select>
                    </div>

                    <button class="btn-checkout" onclick="submitOrder()">
                        ĐẶT HÀNG NGAY
                    </button>
                </div>

                <!-- 🌟 CẬP NHẬT: GIAO DIỆN CHATBOT ĐỘNG -->
                <div class="chatbot-panel">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="bot-icon"><i class="fas fa-robot"></i></div>
                        <h6 class="fw-bold mb-0" style="color: #0369A1;">Trợ lý AI Tư Vấn</h6>
                    </div>
                    
                    <div class="chat-container" id="chatContainer">
                        <div class="msg-bubble bot-msg">
                            👋 Chào bạn! Tôi có thể giúp gì cho bạn hôm nay? Gợi ý món ngon hay đặt hàng hộ bạn?
                        </div>
                    </div>

                    <div class="input-group mt-auto">
                        <input type="text" id="aiInputMessage" class="form-control border-0 shadow-sm" placeholder="Nhắn tin cho AI..." 
                               style="border-radius: 20px 0 0 20px; font-size: 0.9rem; padding-left: 15px; height: 45px;"
                               onkeypress="handleKeyPress(event)">
                        <button class="btn btn-primary shadow-sm px-3" onclick="sendChat()" 
                                style="border-radius: 0 20px 20px 0; background: #0EA5E9; border: none;">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- THUẬT TOÁN ĐO LỘ TRÌNH ĐƯỜNG BỘ MIỄN PHÍ OSRM & ĐẶT HÀNG -->
    <script>
        let customerCart = [];
        let shippingFee = 0; 
        let currentDistance = 0;

        const SHOP_LAT = 21.037814;
        const SHOP_LON = 105.795139;

        function formatMoney(amount) {
            return amount.toLocaleString('vi-VN') + ' đ';
        }

        async function calculateShipping() {
            const address = document.getElementById("txtAddress").value.trim();
            const statusEl = document.getElementById("shippingStatus");
            const checkoutBtn = document.querySelector(".btn-checkout");
            
            if (!address) {
                shippingFee = 0;
                statusEl.innerHTML = "";
                renderCart();
                return;
            }

            statusEl.innerHTML = '<span class="text-primary"><i class="fas fa-spinner fa-spin me-1"></i>Đang đo lộ trình đường xe chạy thực tế...</span>';

            try {
                const query = encodeURIComponent(address + ", Việt Nam");
                const geoResponse = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}&limit=1`);
                const geoData = await geoResponse.json();

                if (geoData && geoData.length > 0) {
                    const customerLat = parseFloat(geoData[0].lat);
                    const customerLon = parseFloat(geoData[0].lon);
                    
                    const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${SHOP_LON},${SHOP_LAT};${customerLon},${customerLat}?overview=false`;
                    const routeResponse = await fetch(osrmUrl);
                    const routeData = await routeResponse.json();

                    if (routeData.code === "Ok" && routeData.routes.length > 0) {
                        const distanceMeters = routeData.routes[0].distance;
                        currentDistance = distanceMeters / 1000;
                        
                        if (currentDistance <= 2) {
                            shippingFee = 0;
                            statusEl.innerHTML = `<span class="text-success"><i class="fas fa-motorcycle me-1"></i>${currentDistance.toFixed(1)} km - <b>Miễn Phí Ship!</b></span>`;
                            checkoutBtn.disabled = false;
                        } else if (currentDistance > 100) {
                            shippingFee = 0;
                            statusEl.innerHTML = `<span class="text-danger"><i class="fas fa-ban me-1"></i>${currentDistance.toFixed(1)} km - Quá xa, shop không giao được.</span>`;
                            checkoutBtn.disabled = true;
                        } else {
                            const extraKm = Math.ceil(currentDistance - 2);
                            shippingFee = extraKm * 5000;
                            statusEl.innerHTML = `<span class="text-warning"><i class="fas fa-route me-1"></i>${currentDistance.toFixed(1)} km - Phí giao hàng: ${formatMoney(shippingFee)}</span>`;
                            checkoutBtn.disabled = false;
                        }
                    } else {
                        throw new Error("OSRM error");
                    }
                } else {
                    statusEl.innerHTML = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Không định vị được địa chỉ này. Tạm tính: 15.000đ.</span>';
                    shippingFee = 15000;
                    checkoutBtn.disabled = false;
                }
            } catch (error) {
                statusEl.innerHTML = '<span class="text-danger"><i class="fas fa-wifi me-1"></i>Lỗi mạng. Tạm tính: 15.000đ.</span>';
                shippingFee = 15000;
                checkoutBtn.disabled = false;
            }
            renderCart(); 
        }

        function addToCart(id, name, price) {
            let item = customerCart.find(i => i.id === id);
            if (item) item.quantity += 1;
            else customerCart.push({ id: id, name: name, price: price, quantity: 1 });
            renderCart();
        }

        function updateQuantity(id, change) {
            let itemIndex = customerCart.findIndex(i => i.id === id);
            if (itemIndex > -1) {
                customerCart[itemIndex].quantity += change;
                if (customerCart[itemIndex].quantity <= 0) customerCart.splice(itemIndex, 1);
                renderCart();
            }
        }

        function renderCart() {
            const list = document.getElementById("cartItemsList");
            const emptyMsg = document.getElementById("emptyCartMsg");
            const totalSpan = document.getElementById("cartTotalAmount");
            
            list.innerHTML = "";
            let subTotal = 0;

            if (customerCart.length === 0) {
                list.appendChild(emptyMsg);
                emptyMsg.style.display = "block";
                totalSpan.innerText = "0 đ";
                const existingFeeUi = document.getElementById("shippingFeeDisplay");
                if(existingFeeUi) existingFeeUi.remove();
                return;
            }

            customerCart.forEach(item => {
                let itemTotal = item.price * item.quantity;
                subTotal += itemTotal;

                let row = document.createElement("div");
                row.className = "d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom";
                row.innerHTML = `
                    <div style="width: 50%;">
                        <div class="fw-bold text-truncate" style="font-size: 0.9rem;">${item.name}</div>
                        <div class="text-danger fw-semibold small">${formatMoney(item.price)}</div>
                    </div>
                    <div class="d-flex align-items-center bg-light rounded-pill px-2 py-1 border">
                        <button class="btn btn-sm text-muted border-0 p-0 px-2" onclick="updateQuantity(${item.id}, -1)"><i class="fas fa-minus small"></i></button>
                        <span class="fw-bold px-2" style="font-size: 0.9rem;">${item.quantity}</span>
                        <button class="btn btn-sm text-muted border-0 p-0 px-2" onclick="updateQuantity(${item.id}, 1)"><i class="fas fa-plus small"></i></button>
                    </div>
                `;
                list.appendChild(row);
            });

            let shippingFeeHtml = document.getElementById("shippingFeeDisplay");
            if (!shippingFeeHtml) {
                shippingFeeHtml = document.createElement("div");
                shippingFeeHtml.id = "shippingFeeDisplay";
                shippingFeeHtml.className = "d-flex justify-content-between align-items-center mb-2 text-muted small";
                const totalContainer = totalSpan.parentElement;
                totalContainer.parentNode.insertBefore(shippingFeeHtml, totalContainer);
            }
            
            if (shippingFee > 0) {
                shippingFeeHtml.innerHTML = `<span>Phí giao hàng:</span><span class="fw-semibold">${formatMoney(shippingFee)}</span>`;
                shippingFeeHtml.style.display = "flex";
            } else {
                shippingFeeHtml.style.display = "none";
            }

            const finalTotal = subTotal + shippingFee;
            totalSpan.innerText = formatMoney(finalTotal);
        }

        function submitOrder() {
            if (customerCart.length === 0) return alert("Vui lòng chọn ít nhất 1 món ăn!");
            const address = document.getElementById("txtAddress").value.trim();
            if (!address) return alert("Vui lòng nhập địa chỉ giao hàng!");

            const method = document.getElementById("cbPaymentMethod").value;
            const btn = document.querySelector(".btn-checkout");
            btn.innerHTML = "<i class='fas fa-spinner fa-spin'></i> ĐANG XỬ LÝ...";
            btn.disabled = true;

            const payload = { 
                Items: customerCart, 
                Address: address, 
                PaymentMethod: method,
                ShippingFee: shippingFee 
            };

            fetch('/Shop/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.isRedirect && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        const driverInfo = data.driverName ? `\nTài xế ${data.driverName} sẽ liên hệ với bạn qua SĐT ${data.driverPhone}.` : '';
                        alert("🎉 Đặt hàng thành công! Vui lòng chú ý điện thoại." + driverInfo);
                        customerCart = [];
                        renderCart();
                        document.getElementById("txtAddress").value = "";
                        document.getElementById("shippingStatus").innerHTML = "";
                    }
                } else alert("Lỗi: " + (data.message || "Không thể đặt hàng."));
            })
            .catch(err => {
                alert("Lỗi gọi API. Đã tiếp nhận đơn hàng thành công!");
                customerCart = []; renderCart();
                document.getElementById("txtAddress").value = "";
            })
            .finally(() => {
                btn.innerHTML = "ĐẶT HÀNG NGAY"; btn.disabled = false;
            });
        }

        // 🌟 CẬP NHẬT: LOGIC KÍCH HOẠT CHATBOT
        function handleKeyPress(e) {
            if (e.key === 'Enter') {
                sendChat();
            }
        }

        async function sendChat() {
            const inputEl = document.getElementById("aiInputMessage");
            const msg = inputEl.value.trim();
            if (!msg) return;

            const chatBox = document.getElementById("chatContainer");

            // Hiển thị tin nhắn người dùng
            chatBox.innerHTML += `
                <div class="msg-bubble user-msg">
                    ${msg}
                </div>
            `;
            inputEl.value = "";
            chatBox.scrollTop = chatBox.scrollHeight;

            // Hiển thị hiệu ứng AI đang gõ
            const typingId = "typing-" + Date.now();
            chatBox.innerHTML += `
                <div id="${typingId}" class="msg-bubble bot-msg text-muted">
                    <i class="fas fa-ellipsis-h fa-fade"></i> AI đang suy nghĩ...
                </div>
            `;
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                // Gọi API backend (Hàm ChatBot trong ShopController)
                const response = await fetch('/Shop/ChatBot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Message: msg })
                });
                
                const data = await response.json();
                document.getElementById(typingId).remove(); // Ẩn trạng thái đang gõ

                // Format lại \n thành <br> để xuống dòng đẹp
                const formattedReply = data.reply.replace(/\n/g, '<br>');
                
                chatBox.innerHTML += `
                    <div class="msg-bubble bot-msg">
                        🤖 ${formattedReply}
                    </div>
                `;
                chatBox.scrollTop = chatBox.scrollHeight;

            } catch (error) {
                document.getElementById(typingId).remove();
                chatBox.innerHTML += `
                    <div class="msg-bubble bot-msg bg-danger text-white">
                        ⚠️ Lỗi kết nối đến Trợ lý AI. Vui lòng thử lại sau.
                    </div>
                `;
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        }
    </script>
</body>
</html>