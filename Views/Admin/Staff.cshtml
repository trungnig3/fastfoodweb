@model IEnumerable<FastFoodWeb.Models.User>
@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-primary">Quản lý Nhân viên & Ca làm việc</h3>
    <a href="/Admin/CreateStaff" class="btn btn-primary">+ Thêm nhân viên</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-3">ID</th>
                    <th>Họ và tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò (Role)</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th> <!-- Thêm cột thao tác -->
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">@item.UserId</td>
                        <td class="fw-bold">@item.FullName</td>
                        <td>@item.Username</td>
                        <td>
                            @if (item.Role?.RoleName == "Admin") { <span class="badge bg-danger">Quản trị viên</span> }
                            else { <span class="badge bg-success">Thu ngân</span> }
                        </td>
                        <td>
                            @if (item.IsActive) { <span class="badge bg-primary">Hoạt động</span> }
                            else { <span class="badge bg-secondary">Đã khóa</span> }
                        </td>
                        <!-- Nút Sửa -->
                        <td class="text-end pe-3">
                            <a href="/Admin/EditStaff/@item.UserId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>