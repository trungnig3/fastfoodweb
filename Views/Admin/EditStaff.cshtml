@model FastFoodWeb.Models.User
@{
    ViewData["Title"] = "Sửa thông tin nhân viên";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white border-bottom">
                <h4 class="mb-0 text-primary">Cập nhật thông tin nhân viên</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditStaff" method="post">
                    <!-- Khóa chính ẩn -->
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên</label>
                        <input type="text" asp-for="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập</label>
                        <input type="text" asp-for="Username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới (Bỏ trống nếu không đổi)</label>
                        <input type="password" asp-for="PasswordHash" class="form-control" placeholder="Nhập mật khẩu mới..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chức vụ (Quyền)</label>
                        <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select"></select>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input" id="isActive" />
                        <label class="form-check-label" for="isActive">Tài khoản đang hoạt động</label>
                    </div>
                    <div class="text-end">
                        <a href="/Admin/Staff" class="btn btn-secondary me-2">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>