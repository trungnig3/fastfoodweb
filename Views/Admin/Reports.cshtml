@{
    ViewData["Title"] = "Báo cáo Tổng hợp Kinh doanh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* 🌟 SỬA LỖI CSS: Đảm bảo nền trắng, chữ đậm rõ ràng, khắc phục triệt để tình trạng trùng màu */
    .admin-stat-card {
        background: #ffffff !important;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 130px;
    }
    .admin-stat-card .stat-title {
        color: #64748b !important;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 8px;
    }
    .admin-stat-card .stat-value {
        color: #0f172a !important; /* Ép màu chữ hiển thị đậm sắc nét */
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .table-custom th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        border-bottom: 2px solid #e2e8f0;
    }
    .table-custom td {
        vertical-align: middle;
        color: #334155;
    }
    .badge-deduction {
        background-color: #fef2f2;
        color: #ef4444;
        border: 1px solid #fecaca;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: bold;
        display: inline-block;
    }
</style>

<div class="container-fluid py-4">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold" style="color: #0284c7;">Báo cáo Tổng hợp Kinh doanh</h4>
    </div>

    <!-- CARDS THỐNG KÊ (ĐÃ FIX TRIỆT ĐỂ LỖI MÀU CHỮ) -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="admin-stat-card">
                <span class="stat-title">Tổng Doanh Thu Hôm Nay</span>
                <span class="stat-value">@string.Format("{0:N0}", ViewBag.TotalRevenue ?? 0) đ</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-stat-card">
                <span class="stat-title">Tổng Số Đơn Hàng</span>
                <span class="stat-value">@(ViewBag.TotalOrders ?? 0)</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-stat-card">
                <span class="stat-title">Giá Trị Trung Bình / Đơn</span>
                <span class="stat-value">@string.Format("{0:N0}", ViewBag.AvgOrderValue ?? 0) đ</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- TOP MÓN BÁN CHẠY -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-chart-line text-warning me-2"></i>Top Món Bán Chạy Nhất</h6>
                </div>
                <div class="card-body px-0 pb-2">
                    <table class="table table-custom table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Tên món ăn</th>
                                <th class="text-center pe-3">Số lượng đã bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.TopProducts != null)
                            {
                                int i = 1;
                                foreach (var item in ViewBag.TopProducts)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-muted">@(i++)</td>
                                        <td class="fw-medium">@item.ProductName</td>
                                        <td class="text-center pe-3">
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 fw-bold">@item.QuantitySold sản phẩm</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu bán hàng</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- BẢNG ĐỐI SOÁT VÀ TRỪ LƯƠNG NHÂN VIÊN -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-danger mb-0"><i class="fas fa-cash-register me-2"></i>Kiểm soát Đóng ca & Trừ lương</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Ngày / Giờ</th>
                                    <th>Thu ngân</th>
                                    <th class="text-end">Tiền Két (Lý thuyết)</th>
                                    <th class="text-end">Thực đếm</th>
                                    <th class="text-end">Lệch</th>
                                    <th class="text-center pe-4">Xử lý lương</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.ShiftReports != null)
                                {
                                    foreach (var shift in ViewBag.ShiftReports)
                                    {
                                        <tr>
                                            <td class="ps-4">@shift.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="fw-bold text-dark">@shift.CashierName</td>
                                            <td class="text-end">@string.Format("{0:N0}", shift.ExpectedCash) đ</td>
                                            <td class="text-end fw-bold text-primary">@string.Format("{0:N0}", shift.ActualCash) đ</td>
                                            <td class="text-end">
                                                @if (shift.Difference == 0)
                                                {
                                                    <span class="text-success fw-bold"><i class="fas fa-check"></i> Khớp</span>
                                                }
                                                else if (shift.Difference > 0)
                                                {
                                                    <span class="text-warning fw-bold">+@string.Format("{0:N0}", shift.Difference) đ</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger fw-bold">@string.Format("{0:N0}", shift.Difference) đ</span>
                                                }
                                            </td>
                                            <td class="text-center pe-4">
                                                @if (shift.Difference < 0)
                                                {
                                                    <span class="badge-deduction">Trừ @string.Format("{0:N0}", Math.Abs(shift.Difference)) đ</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border px-3 py-2">Không trừ</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>