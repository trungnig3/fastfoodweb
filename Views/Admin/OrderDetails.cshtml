@model FastFoodWeb.Models.Order
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "_Layout"; // Hoặc "_LayoutAdmin" tùy thuộc vào tên file layout của bạn
}

<div class="container-fluid py-4">
    <div class="card shadow border-0 mx-auto" style="max-width: 800px;">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-bold">HÓA ĐƠN: @Model.OrderCode</h4>
            <span class="badge bg-light text-dark fs-6 shadow-sm">@Model.OrderStatus</span>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h6 class="mb-1 text-muted">Thời gian bán:</h6>
                    <p class="fw-bold fs-5">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h6 class="mb-1 text-muted">Nhân viên thu ngân / Nguồn gốc:</h6>
                    <p class="fw-bold fs-5 text-primary">@(Model.Cashier != null ? Model.Cashier.FullName : "Hệ thống tự động")</p>
                </div>
            </div>

            <!-- HIỂN THỊ ĐỊA CHỈ & SHIPPER DÀNH CHO ĐƠN AI/ONLINE -->
            @if (!string.IsNullOrEmpty(Model.ShippingAddress))
            {
                <div class="alert alert-warning border-warning p-3 mb-4 shadow-sm">
                    <h6 class="fw-bold text-danger mb-2">🚚 THÔNG TIN GIAO HÀNG (BOT/ONLINE)</h6>
                    <p class="mb-1"><strong>📍 Địa chỉ nhận:</strong> @Model.ShippingAddress</p>
                    @if (!string.IsNullOrEmpty(Model.ShipperName))
                    {
                        <p class="mb-1"><strong>🛵 Người giao hàng:</strong> @Model.ShipperName</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.ShipperPhone))
                    {
                        <p class="mb-0"><strong>📞 SĐT Shipper:</strong> @Model.ShipperPhone</p>
                    }
                </div>
            }

            <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên món ăn</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td class="text-start fw-semibold">@(detail.Product != null ? detail.Product.ProductName : "Sản phẩm không xác định")</td>
                                <td>@detail.UnitPrice.ToString("N0") đ</td>
                                <td>@detail.Quantity</td>
                                <td class="text-danger fw-bold">@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-end mt-4">
                <div class="text-end" style="width: 250px;">
                    <p class="mb-1 d-flex justify-content-between text-muted"><span>Tổng phụ:</span> <span>@Model.TotalAmount.ToString("N0") đ</span></p>
                    <p class="mb-2 d-flex justify-content-between text-muted"><span>Giảm giá:</span> <span>0 đ</span></p>
                    <h5 class="fw-bold text-danger d-flex justify-content-between border-top pt-2 mt-2">
                        <span>TỔNG CỘNG:</span> <span>@Model.TotalAmount.ToString("N0") đ</span>
                    </h5>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-end py-3">
            <a href="/Admin/Orders" class="btn btn-secondary me-2 fw-bold">⬅ Quay lại danh sách</a>
            <button class="btn btn-primary fw-bold" onclick="window.print()">🖨️ In Hóa Đơn</button>
        </div>
    </div>
</div>