@model IEnumerable<FastFoodWeb.Models.Product>
@{
    ViewData["Title"] = "Quản lý Thực đơn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Danh sách Món ăn & Combo</h3>
    <a href="/Admin/CreateProduct" class="btn btn-primary">+ Thêm món mới</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-3">ID</th>
                    <th>Tên món</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Loại</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">@item.ProductId</td>
                        <td class="fw-bold text-primary">@item.ProductName</td>
                        <td>@item.Category?.CategoryName</td>
                        <td class="text-danger fw-semibold">@item.Price.ToString("N0") đ</td>
                        <td>
                            @if (item.IsCombo) { <span class="badge bg-warning text-dark">Combo</span> }
                            else { <span class="badge bg-secondary">Món lẻ</span> }
                        </td>
                        <td>
                            @if (item.IsActive) { <span class="badge bg-success">Đang bán</span> }
                            else { <span class="badge bg-danger">Ngừng bán</span> }
                        </td>
                        <!-- Tìm và thay thế đoạn thẻ <td> thao tác cũ bằng đoạn này -->
                        <td class="text-end pe-3 d-flex justify-content-end align-items-center">
                            <!-- Nút Sửa -->
                            <a href="/Admin/EditProduct/@item.ProductId" class="btn btn-sm btn-outline-primary me-2">Sửa</a>
                            
                            <!-- Nút Xóa (Dùng form POST để bảo mật, kèm JS cảnh báo) -->
                            <form action="/Admin/DeleteProduct" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa món này không?');">
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>