@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Bảng Lương Nhân Viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; // Ép sử dụng Layout Admin cao cấp
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">
        <i class="fas fa-money-check-alt text-success me-2"></i> Bảng Lương Tháng @ViewBag.SelectedMonth/@ViewBag.SelectedYear
    </h3>
    
    <!-- Thanh Lọc thời gian bo tròn -->
    <form method="get" class="d-flex gap-2 bg-white p-2 rounded-pill shadow-sm align-items-center">
        <span class="text-muted fw-bold ms-2 small">THÁNG:</span>
        <input type="number" name="month" class="form-control border-0 bg-light rounded-pill px-3 text-center fw-bold text-primary" style="width: 80px;" value="@ViewBag.SelectedMonth" min="1" max="12">
        <span class="text-muted fw-bold small">NĂM:</span>
        <input type="number" name="year" class="form-control border-0 bg-light rounded-pill px-3 text-center fw-bold text-primary" style="width: 100px;" value="@ViewBag.SelectedYear" min="2020" max="2100">
        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fas fa-filter"></i> Lọc
        </button>
    </form>
</div>

<!-- Bảng Lương Cao Cấp -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Nhân viên</th>
                    <th class="text-center">Giờ chuẩn</th>
                    <th class="text-center">Giờ OT</th>
                    <th class="text-end">Thưởng OT (x1.5)</th>
                    <th class="text-end pe-4">TỔNG THỰC LÃNH</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    decimal grandTotal = 0;
                    foreach (var item in Model)
                    {
                        grandTotal += (decimal)item.TotalSalary;
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 1.2rem;">
                                        @item.Username.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-primary">@item.Username</h6>
                                        <small class="text-muted fw-semibold">Lương CB: @item.HourlyRate.ToString("N0") đ/h</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill fs-6">
                                    <i class="far fa-clock"></i> @item.StandardHours.ToString("0.0") h
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill fs-6">
                                    <i class="fas fa-stopwatch"></i> @item.OvertimeHours.ToString("0.0") h
                                </span>
                            </td>
                            <td class="text-end fw-bold text-success">
                                + @item.OvertimeBonus.ToString("N0") đ
                            </td>
                            <td class="text-end pe-4 fw-black text-danger fs-5">
                                @item.TotalSalary.ToString("N0") đ
                            </td>
                        </tr>
                    }
                    
                    <!-- Dòng Tổng Cộng -->
                    <tr class="bg-light bg-opacity-50">
                        <td colspan="4" class="text-end fw-bold text-muted fs-5 py-4">Tổng chi phí quỹ lương:</td>
                        <td class="text-end pe-4 fw-black text-danger fs-3 py-4">@grandTotal.ToString("N0") đ</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486747.png" width="80" style="opacity: 0.3" class="mb-3" />
                            <h5 class="text-muted fw-bold">Không có dữ liệu ca làm trong tháng này!</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>