@model FastFoodWeb.Models.User
@{
    ViewData["Title"] = "Thêm nhân viên";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white border-bottom">
                <h4 class="mb-0 text-primary">Thêm tài khoản nhân viên mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateStaff" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên nhân viên</label>
                        <input type="text" asp-for="FullName" class="form-control" required placeholder="VD: Nguyễn Văn A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập</label>
                        <input type="text" asp-for="Username" class="form-control" required placeholder="VD: thungan2" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input type="password" asp-for="PasswordHash" class="form-control" required placeholder="Nhập mật khẩu..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chức vụ (Quyền)</label>
                        <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select"></select>
                    </div>
                    <div class="text-end">
                        <a href="/Admin/Staff" class="btn btn-secondary me-2">Hủy</a>
                        <button type="submit" class="btn btn-success px-4">Lưu tài khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>