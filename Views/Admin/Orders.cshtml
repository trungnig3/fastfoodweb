@model IEnumerable<FastFoodWeb.Models.Order>
@{
    ViewData["Title"] = "Quản lý Lịch sử Hóa đơn";
}

<!-- THÊM FONT CHỮ CAO CẤP VÀ CSS -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: #F8F9FA;
        color: #2D3436;
    }
    .stats-card {
        background: #FFFFFF;
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        transition: transform 0.3s ease;
    }
    .stats-card:hover {
        transform: translateY(-4px);
    }
</style>

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0" style="color: #2D3436;">
            <i class="fas fa-receipt me-2 text-primary"></i>Quản Lý Hóa Đơn & Trạng Thái
        </h2>
    </div>
    
    <!-- THẺ THỐNG KÊ (Đã sửa lỗi chữ trắng, hiển thị nổi bật trên nền trắng sạch sẽ) -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="stats-card p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase tracking-wider d-block mb-1">Tổng doanh thu</span>
                    <h3 class="fw-black fw-bold text-success mb-0" style="font-size: 2rem;">@(((decimal)(ViewBag.TotalRevenue ?? 0)).ToString("N0")) <span class="fs-5">đ</span></h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success fs-3">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="stats-card p-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase tracking-wider d-block mb-1">Tổng số đơn hàng</span>
                    <h3 class="fw-black fw-bold text-primary mb-0" style="font-size: 2rem;">@ViewBag.TotalOrders <span class="fs-5">đơn</span></h3>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary fs-3">
                    <i class="fas fa-shopping-bag"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH HÓA ĐƠN -->
    <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-dark py-3">
                        <tr>
                            <th class="py-3 ps-4 text-start">Mã Đơn</th>
                            <th class="py-3">Ngày Lập</th>
                            <th class="py-3">Thu Ngân</th>
                            <th class="py-3">Thanh Toán</th>
                            <th class="py-3 text-end">Tổng Tiền</th>
                            <th class="py-3">Trạng Thái</th>
                            <th class="py-3 pe-4">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">Chưa có hóa đơn nào trong hệ thống.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-start fw-bold text-primary">@item.OrderCode</td>
                                <td class="text-muted small">@item.OrderDate.ToString("HH:mm - dd/MM/yyyy")</td>
                                <td class="fw-semibold">@(item.Cashier != null ? item.Cashier.FullName : "Hệ thống AI")</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2">
                                        @(item.PaymentMethod?.Contains("VNPAY") == true ? "🟢 VNPAY QR" : "💵 Tiền mặt")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-danger fs-6">@item.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <!-- Dropdown thay đổi trạng thái đơn hàng -->
                                    <select class="form-select form-select-sm fw-bold text-center mx-auto shadow-sm" style="width: 140px; border-radius: 10px;" onchange="changeStatus(@item.OrderId, this.value)">
                                        <option value="Pending" selected="@(item.OrderStatus == "Pending")">⏳ Pending</option>
                                        <option value="Hoàn tất" selected="@(item.OrderStatus == "Hoàn tất" || item.OrderStatus == "Completed")">✅ Hoàn tất</option>
                                        <option value="Đã hủy" selected="@(item.OrderStatus == "Đã hủy")">❌ Đã hủy</option>
                                    </select>
                                </td>
                                <td class="pe-4">
                                    <a href="/Admin/OrderDetails/@item.OrderId" class="btn btn-sm btn-light border shadow-sm rounded-pill px-3 fw-bold text-primary">
                                        <i class="fas fa-eye me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function changeStatus(orderId, newStatus) {
        fetch('/Admin/UpdateOrderStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + orderId + '&status=' + encodeURIComponent(newStatus)
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                alert("✅ Cập nhật trạng thái thành công!");
                location.reload(); 
            } else {
                alert("❌ Lỗi: " + (data.message || "Không thể cập nhật."));
            }
        })
        .catch(err => alert("❌ Lỗi kết nối đến máy chủ!"));
    }
</script>