@model FastFoodWeb.Models.Product
@{
    ViewData["Title"] = "Thêm món mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white border-bottom">
                <h4 class="mb-0 text-primary">Thêm món ăn mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateProduct" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên món ăn <span class="text-danger">*</span></label>
                        <input type="text" asp-for="ProductName" class="form-control" required placeholder="Nhập tên món..." />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" asp-for="Price" class="form-control" required value="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Đường dẫn Hình ảnh (URL)</label>
                        <input type="text" asp-for="ImageURL" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="d-flex mb-4">
                        <div class="form-check me-4">
                            <input type="checkbox" asp-for="IsCombo" class="form-check-input" id="isCombo">
                            <label class="form-check-label" for="isCombo">Là Combo?</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" asp-for="IsActive" class="form-check-input" id="isActive" checked>
                            <label class="form-check-label" for="isActive">Đang hoạt động (Hiển thị ra màn POS)</label>
                        </div>
                    </div>

                    <div class="text-end">
                        <a href="/Admin/Products" class="btn btn-secondary me-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success px-4">Lưu Sản Phẩm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>