<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FastFood Admin</title>
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- FONT CHỮ & ICON CAO CẤP -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
            --sidebar-bg: #FFFFFF;
            --bg-color: #F4F7F6;
            --text-main: #2D3436;
            --text-muted: #8392A5;
            --shadow-sm: 0 4px 15px rgba(0,0,0,0.03);
            --shadow-md: 0 10px 30px rgba(0,0,0,0.06);
            --radius-lg: 20px;
            --radius-md: 12px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* --- MAGIC CSS: ÉP TẤT CẢ CÁC TRANG CON BÊN TRONG THÀNH GIAO DIỆN CAO CẤP --- */
        
        /* Tự động bo cong và đổ bóng tất cả các bảng biểu, thẻ div */
        .card {
            border: none !important;
            border-radius: var(--radius-lg) !important;
            box-shadow: var(--shadow-sm) !important;
            background: #ffffff !important;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-header {
            background: transparent !important;
            border-bottom: 1px dashed #E2E8F0 !important;
            padding: 20px 24px !important;
            font-weight: 700;
        }

        /* Làm đẹp tự động cho tất cả các Table */
        .table {
            vertical-align: middle;
            border-collapse: separate;
            border-spacing: 0 8px;
        }
        .table thead th {
            background-color: #F8FAFC !important;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            padding: 16px;
        }
        .table thead th:first-child { border-radius: 12px 0 0 12px; }
        .table thead th:last-child { border-radius: 0 12px 12px 0; }
        .table tbody tr {
            background-color: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            transition: all 0.2s;
        }
        .table tbody tr:hover {
            transform: scale(1.01);
            box-shadow: var(--shadow-md);
            z-index: 10;
            position: relative;
        }
        .table tbody td {
            border: none;
            padding: 16px;
        }
        .table tbody td:first-child { border-radius: 12px 0 0 12px; border-left: 3px solid transparent; }
        .table tbody tr:hover td:first-child { border-left-color: #FF6B6B; } 
        .table tbody td:last-child { border-radius: 0 12px 12px 0; }

        /* Làm đẹp tất cả Nút bấm */
        .btn {
            border-radius: var(--radius-md);
            font-weight: 600;
            padding: 10px 20px;
            border: none;
            transition: all 0.3s;
        }
        .btn-primary, .btn-success {
            background: var(--primary-gradient) !important;
            color: white !important;
            box-shadow: 0 8px 15px rgba(255, 107, 107, 0.2);
        }
        .btn-primary:hover, .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 20px rgba(255, 107, 107, 0.3);
        }

        /* --- THIẾT KẾ SIDEBAR BÊN TRÁI MỚI --- */
        .admin-layout { display: flex; min-height: 100vh; }
        
        .sidebar {
            width: 280px;
            background: var(--sidebar-bg);
            box-shadow: 4px 0 24px rgba(0,0,0,0.04);
            z-index: 100;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
        }
        .sidebar-logo {
            padding: 30px 24px;
            font-size: 1.5rem;
            font-weight: 900;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.5px;
        }
        .nav-menu { flex-grow: 1; padding: 0 16px; overflow-y: auto; }
        .nav-item {
            display: flex;
            align-items: center;
            padding: 14px 20px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            border-radius: 14px;
            margin-bottom: 8px;
            transition: all 0.3s;
        }
        .nav-item i { width: 24px; font-size: 1.1rem; transition: all 0.3s; margin-right: 10px; }
        .nav-item:hover {
            background: #F8FAFC;
            color: #FF6B6B;
            transform: translateX(5px);
        }
        .nav-item.active {
            background: var(--primary-gradient);
            color: white;
            box-shadow: 0 8px 15px rgba(255, 107, 107, 0.2);
        }
        
        /* Khu vực Nút POS bên dưới cùng của Sidebar */
        .pos-btn-wrapper { padding: 24px 16px; border-top: 1px dashed #E2E8F0; }
        .btn-open-pos {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #2D3436;
            color: white;
            text-decoration: none;
            padding: 16px;
            border-radius: 16px;
            font-weight: 700;
            transition: all 0.3s;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }
        .btn-open-pos:hover {
            background: #1e2527;
            color: #FF8E53;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.2);
        }

        /* --- VÙNG NỘI DUNG CHÍNH (BÊN PHẢI) --- */
        .main-content {
            flex-grow: 1;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
        }
        
        .top-navbar {
            background: rgba(244, 247, 246, 0.8);
            backdrop-filter: blur(10px);
            padding: 20px 40px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 90;
        }
        .admin-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            background: white;
            padding: 8px 24px;
            border-radius: 100px;
            box-shadow: var(--shadow-sm);
            font-weight: 700;
        }
        .btn-logout {
            color: #FF6B6B;
            text-decoration: none;
            font-weight: 700;
            background: #FFF0F0;
            padding: 8px 16px;
            border-radius: 100px;
            margin-left: 16px;
            transition: all 0.2s;
        }
        .btn-logout:hover { background: #FF6B6B; color: white; }

        .content-body { padding: 10px 40px 40px 40px; }
    </style>
</head>
<body>

    <div class="admin-layout">
        
        <!-- SIDEBAR BÊN TRÁI -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                <i class="fas fa-hamburger me-2" style="color: #FF8E53"></i> FASTFOOD
            </div>
            
            <div class="nav-menu">
                <!-- GIỮ NGUYÊN CÁC ĐƯỜNG LINK TỪ FILE CŨ CỦA BẠN -->
                <a href="/Admin/Index" class="nav-item">
                    <i class="fas fa-chart-pie"></i> Trang chủ
                </a>
                <a href="/Admin/Products" class="nav-item">
                    <i class="fas fa-box-open"></i> Quản lý Món & Combo
                </a>
                <a href="/Admin/Orders" class="nav-item">
                    <i class="fas fa-receipt"></i> Lịch sử Hóa đơn
                </a>
                <a href="/Admin/Inventory" class="nav-item">
                    <i class="fas fa-warehouse"></i> Kho hàng
                </a>
                <hr class="border-secondary opacity-10 my-2" />
                <a href="/Admin/Staff" class="nav-item">
                    <i class="fas fa-users"></i> Quản lý nhân viên
                </a>
                <a href="/Admin/SalaryReport" class="nav-item">
                    <i class="fas fa-money-check-alt"></i> Bảng Lương & Ca làm
                </a>
                <a href="/Admin/Reports" class="nav-item">
                    <i class="fas fa-chart-line"></i> Báo cáo tổng hợp
                </a>
            </div>

            <!-- Nút vào POS -->
            <div class="pos-btn-wrapper">
                <a href="/Pos" target="_blank" class="btn-open-pos">
                    <i class="fas fa-desktop"></i> MỞ MÀN HÌNH POS
                </a>
            </div>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="main-content">
            
            <!-- THANH TOPBAR GÓC TRÊN PHẢI -->
            <header class="top-navbar">
                <div class="admin-profile">
                    <i class="fas fa-user-shield text-primary fs-5"></i> 
                    <span>Chào, @(User.Identity?.Name ?? "Quản trị viên")</span>
                </div>
                <!-- Nút Đăng xuất -->
                <a href="/Account/Logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
            </header>

            <!-- VÙNG RENDER TẤT CẢ CÁC TRANG QUẢN TRỊ CON -->
            <div class="content-body">
                @RenderBody()
            </div>
            
        </main>
    </div>

    <!-- KẾT NỐI SCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.css"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Script tự động bôi sáng menu bên trái khi đang ở đúng trang -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var currentUrl = window.location.pathname.toLowerCase();
            var navItems = document.querySelectorAll('.nav-item');
            
            navItems.forEach(function(item) {
                var itemUrl = item.getAttribute('href').toLowerCase();
                // Nếu URL hiện tại bắt đầu bằng URL của menu (để khớp cả trang chi tiết)
                if(currentUrl.startsWith(itemUrl) && itemUrl !== "/admin") {
                    item.classList.add('active');
                } else if (currentUrl === "/admin/index" && itemUrl === "/admin/index") {
                    item.classList.add('active');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>