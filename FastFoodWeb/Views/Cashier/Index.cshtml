@{
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
    ViewBag.Title = "Bàn Làm Việc Thu Ngân";
    var activeShift = ViewBag.ActiveShift as FastFoodWeb.Models.Shift;
    var shiftOrders = ViewBag.ShiftOrders as IEnumerable<FastFoodWeb.Models.Order> ?? new List<FastFoodWeb.Models.Order>();
    decimal shiftRevenue = ViewBag.ShiftRevenue != null ? (decimal)ViewBag.ShiftRevenue : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Bàn Làm Việc Ca Thu Ngân</h4>
        <p class="text-muted small mb-0">Theo dõi doanh thu, số lượng đơn và trạng thái phục vụ trong ca trực</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Pos")" class="btn btn-danger fw-bold"><i class="fas fa-calculator me-1"></i> Mở Màn Hình POS Bán Hàng</a>
    </div>
</div>

<!-- KPI Ca Trực -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 border shadow-sm">
            <span class="text-muted small fw-bold">TIỀN ĐẦU CA</span>
            <h4 class="fw-bold text-dark mt-1">@((activeShift != null ? activeShift.StartingCash : 0).ToString("N0")) đ</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 border shadow-sm">
            <span class="text-muted small fw-bold">DOANH THU CA TRỰC</span>
            <h4 class="fw-bold text-success mt-1">@shiftRevenue.ToString("N0") đ</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 border shadow-sm">
            <span class="text-muted small fw-bold">TỔNG SỐ ĐƠN HÀNG</span>
            <h4 class="fw-bold text-primary mt-1">@shiftOrders.Count() đơn</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 border shadow-sm">
            <span class="text-muted small fw-bold">GIỜ BẮT ĐẦU</span>
            <h5 class="fw-bold text-dark mt-1">@((activeShift != null ? activeShift.StartTime : DateTime.Now).ToString("HH:mm dd/MM"))</h5>
        </div>
    </div>
</div>

<!-- Bảng Đơn Hàng Trong Ca -->
<div class="card border shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-list-check text-danger me-2"></i>Danh Sách Đơn Hàng Gần Đây Trong Ca</h6>
        <a href="@Url.Action("Orders", "Cashier")" class="btn btn-sm btn-outline-dark">Xem tất cả</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Thời Gian</th>
                    <th>Phương Thức</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Chi Tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (shiftOrders.Any())
                {
                    foreach (var o in shiftOrders.Take(8))
                    {
                        <tr>
                            <td><b class="text-danger font-monospace">@o.OrderCode</b></td>
                            <td class="small text-muted">@o.OrderDate.ToString("HH:mm:ss")</td>
                            <td><span class="badge bg-light text-dark border">@o.PaymentMethod</span></td>
                            <td><b class="text-dark">@o.TotalAmount.ToString("N0") đ</b></td>
                            <td>
                                <span class="badge @(o.OrderStatus == "Hoàn tất" ? "bg-success" : (o.OrderStatus == "Đã hủy" ? "bg-danger" : "bg-warning text-dark"))">
                                    @(o.ShippingStatus ?? o.OrderStatus)
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("OrderDetails", "Cashier", new { id = o.OrderId })" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye me-1"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa có đơn hàng nào trong ca trực này.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
