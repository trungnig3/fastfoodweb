@model IEnumerable<FastFoodWeb.Models.Order>
@{
    Layout = "~/Views/Shared/_CashierLayout.cshtml";
    ViewBag.Title = "Đơn Hàng Trong Ca Thu Ngân";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Quản Lý Đơn Hàng Trong Ca</h4>
        <p class="text-muted small mb-0">Cập nhật trạng thái chế biến và phục vụ khách hàng trực tiếp</p>
    </div>
    <a href="@Url.Action("Index", "Cashier")" class="btn btn-outline-dark btn-sm"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
</div>

<div class="card border shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Thời Gian</th>
                    <th>Địa Chỉ / Bàn</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái Hiện Tại</th>
                    <th style="width: 220px;">Cập Nhật Nhanh</th>
                    <th class="text-end">Chi Tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var o in Model)
                    {
                        <tr>
                            <td><b class="text-danger font-monospace">@o.OrderCode</b></td>
                            <td class="small text-muted">@o.OrderDate.ToString("HH:mm:ss dd/MM")</td>
                            <td class="small text-truncate" style="max-width: 180px;">@(o.ShippingAddress ?? "Mua tại quầy")</td>
                            <td><b class="text-dark">@o.TotalAmount.ToString("N0") đ</b></td>
                            <td>
                                <span class="badge @(o.OrderStatus == "Hoàn tất" ? "bg-success" : (o.OrderStatus == "Đã hủy" ? "bg-danger" : "bg-warning text-dark"))">
                                    @(o.ShippingStatus ?? o.OrderStatus)
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" onchange="changeCashierStatus(@o.OrderId, this.value)">
                                    <option value="Đang chuẩn bị món" @(o.ShippingStatus == "Đang chuẩn bị món" ? "selected" : "")>👨‍🍳 Đang chuẩn bị</option>
                                    <option value="Đang giao hàng" @(o.ShippingStatus == "Đang giao hàng" ? "selected" : "")>🛵 Đang giao</option>
                                    <option value="Đã giao thành công" @(o.ShippingStatus == "Đã giao thành công" ? "selected" : "")>✅ Đã giao</option>
                                    <option value="Hoàn tất" @(o.OrderStatus == "Hoàn tất" ? "selected" : "")>⭐ Hoàn tất</option>
                                    <option value="Đã hủy" @(o.OrderStatus == "Đã hủy" ? "selected" : "")>❌ Đã hủy</option>
                                </select>
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("OrderDetails", "Cashier", new { id = o.OrderId })" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có đơn hàng nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function changeCashierStatus(id, st) {
        fetch('@Url.Action("UpdateOrderStatus", "Cashier")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
            body: 'id=' + id + '&status=' + encodeURIComponent(st)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('Đã cập nhật trạng thái đơn #' + id);
                location.reload();
            } else {
                alert(data.message || 'Lỗi cập nhật');
            }
        })
        .catch(() => alert('Đã lưu trạng thái đơn #' + id));
    }
</script>
