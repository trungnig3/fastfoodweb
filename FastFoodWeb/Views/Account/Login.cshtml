@{
    ViewBag.Title = "Đăng Nhập";
    string error = ViewBag.Error as string;
    string success = ViewBag.Success as string;
    string username = ViewBag.Username as string ?? "";
}

<div class="container py-5" style="max-width: 440px;">
    <div class="card p-4 shadow border-0 rounded-4">
        <div class="text-center mb-4">
            <div class="p-3 d-inline-flex rounded-circle bg-danger text-white mb-2">
                <i class="fas fa-hamburger fs-3"></i>
            </div>
            <h4 class="fw-bold text-dark">Đăng Nhập FastFood</h4>
            <p class="text-muted small">Cửa Hàng, Bàn Thu Ngân & Quản Trị Hệ Thống</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-circle-exclamation"></i>
                <div>@error</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <div>@success</div>
            </div>
        }

        <form method="post" action="@Url.Action("Login", "Account")">
            <div class="mb-3">
                <label class="form-label small fw-bold text-dark text-uppercase mb-1">Tên đăng nhập:</label>
                <input type="text" name="username" class="form-control" placeholder="admin, thungan hoặc khachhang" value="@username" required autocomplete="username" />
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-0">Mật khẩu:</label>
                    <a href="@Url.Action("ForgotPassword", "Account")" class="small text-muted text-decoration-none" style="font-size: 0.8rem;">
                        Quên mật khẩu?
                    </a>
                </div>
                <input type="password" name="password" class="form-control" placeholder="Mật khẩu (mặc định: 123)" required autocomplete="current-password" />
            </div>

            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold mb-3 shadow-sm">
                <i class="fas fa-sign-in-alt me-1"></i> Đăng Nhập
            </button>
        </form>

        <!-- Nút điền nhanh cho giảng viên/người chấm thi kiểm thử -->
        <div class="p-2 rounded bg-light border text-center small mb-3">
            <div class="fw-bold mb-1 text-muted" style="font-size: 0.72rem;">ĐĂNG NHẬP NHANH (MẬT KHẨU: 123):</div>
            <div class="d-flex gap-1 justify-content-center">
                <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2 small" onclick="quickFill('admin', '123')">Admin</button>
                <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2 small" onclick="quickFill('thungan', '123')">Thu Ngân</button>
                <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2 small" onclick="quickFill('khachhang', '123')">Khách Hàng</button>
            </div>
        </div>

        <div class="text-center small text-muted pt-2 border-top">
            Chưa có tài khoản? <a href="@Url.Action("Register", "Account")" class="text-danger fw-bold text-decoration-none">Đăng ký ngay</a>
        </div>
    </div>
</div>

<script>
    function quickFill(u, p) {
        document.querySelector('input[name="username"]').value = u;
        document.querySelector('input[name="password"]').value = p;
    }
</script>
