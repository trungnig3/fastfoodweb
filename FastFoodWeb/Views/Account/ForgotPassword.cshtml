@{
    ViewBag.Title = "Quên Mật Khẩu & Xác Thực OTP";
    string error = ViewBag.Error as string;
    string success = ViewBag.Success as string;
    int step = ViewBag.Step != null ? (int)ViewBag.Step : 1;
    string target = ViewBag.Target as string ?? "";
    string generatedOtp = ViewBag.GeneratedOtp as string;
}

<div class="container py-5" style="max-width: 460px;">
    <div class="card p-4 shadow border-0 rounded-4">
        <div class="text-center mb-4">
            <div class="p-3 d-inline-flex rounded-circle bg-danger text-white mb-2">
                <i class="fas fa-shield-halved fs-3"></i>
            </div>
            <h4 class="fw-bold text-dark">Khôi Phục Mật Khẩu</h4>
            <p class="text-muted small">Xác thực mã OTP gửi về Email hoặc Số điện thoại</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-circle-exclamation"></i>
                <div>@error</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <div>@success</div>
            </div>
        }

        @if (step == 2)
        {
            if (!string.IsNullOrEmpty(generatedOtp))
            {
                <div class="p-3 mb-3 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-50">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-dark"><i class="fas fa-key text-warning me-1"></i> Mã OTP Xác Thực:</span>
                        <span class="badge bg-warning text-dark fw-bold px-2 py-1 fs-6 font-monospace">@generatedOtp</span>
                    </div>
                    <small class="text-muted" style="font-size: 0.75rem;">Mã OTP đã được tạo và gửi đến tài khoản của bạn.</small>
                </div>
            }

            <form method="post" action="@Url.Action("ResetPassword", "Account")">
                <input type="hidden" name="target" value="@target" />

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-1">Mã OTP (6 chữ số) *:</label>
                    <input type="text" name="otp" class="form-control text-center fw-bold fs-5 font-monospace text-danger" placeholder="123456" maxlength="6" required autofocus autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-1">Mật khẩu mới *:</label>
                    <input type="password" name="newPassword" class="form-control" placeholder="Nhập mật khẩu mới" required />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-1">Xác nhận mật khẩu mới *:</label>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2 fw-bold mb-3 shadow-sm">
                    <i class="fas fa-circle-check me-1"></i> Xác Nhận Đổi Mật Khẩu
                </button>
            </form>

            <form method="post" action="@Url.Action("ForgotPassword", "Account")" class="text-center mb-2">
                <input type="hidden" name="accountQuery" value="@target" />
                <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none">
                    <i class="fas fa-rotate-right me-1"></i> Chưa nhận được mã? Gửi lại OTP
                </button>
            </form>
        }
        else
        {
            <form method="post" action="@Url.Action("ForgotPassword", "Account")">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-1">Email / Gmail hoặc Số điện thoại *:</label>
                    <input type="text" name="accountQuery" class="form-control" placeholder="Ví dụ: khachhang@gmail.com hoặc 0987654321" value="@target" required autofocus />
                    <small class="text-muted mt-1 d-block" style="font-size: 0.78rem;">Nhập email hoặc số điện thoại đã sử dụng khi đăng ký tài khoản.</small>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2 fw-bold mb-3 shadow-sm">
                    <i class="fas fa-paper-plane me-1"></i> Gửi Mã Xác Thực OTP
                </button>
            </form>
        }

        <div class="text-center pt-3 border-top small">
            <a href="@Url.Action("Login", "Account")" class="text-muted fw-semibold text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i> Quay lại Đăng nhập
            </a>
            <span class="mx-2 text-muted">|</span>
            <a href="@Url.Action("Register", "Account")" class="text-danger fw-bold text-decoration-none">
                Đăng ký mới
            </a>
        </div>
    </div>
</div>
