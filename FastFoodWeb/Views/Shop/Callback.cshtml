@{
    ViewBag.Title = "Kết Quả Thanh Toán VNPay";
    bool success = ViewBag.Success != null && (bool)ViewBag.Success;
    string message = ViewBag.Message as string ?? "";
}

<div class="container py-5 text-center" style="max-width: 540px;">
    <div class="card p-4 shadow border-0 rounded-4">
        @if (success)
        {
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-success text-white" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="fas fa-check"></i>
            </div>
            <h4 class="fw-bold text-success mb-2">Thanh Toán Thành Công!</h4>
        }
        else
        {
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger text-white" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="fas fa-times"></i>
            </div>
            <h4 class="fw-bold text-danger mb-2">Thanh Toán Thất Bại / Đã Hủy</h4>
        }

        <p class="text-muted small mb-4">@message</p>

        <a href="@Url.Action("Index", "Shop")" class="btn btn-danger py-2 fw-bold">
            <i class="fas fa-arrow-left me-1"></i> Quay lại trang chủ thực đơn
        </a>
    </div>
</div>
