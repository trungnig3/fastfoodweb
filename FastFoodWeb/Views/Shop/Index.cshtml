@model IEnumerable<FastFoodWeb.Models.Product>
@{
    ViewBag.Title = "Thực Đơn Đặt Món Trực Tuyến";
    var categories = ViewBag.Categories as IEnumerable<FastFoodWeb.Models.Category> ?? new List<FastFoodWeb.Models.Category>();
    var outOfStock = ViewBag.OutOfStockItems as IEnumerable<FastFoodWeb.Models.Product> ?? new List<FastFoodWeb.Models.Product>();
    var bestSellers = ViewBag.BestSellers as IEnumerable<FastFoodWeb.Models.Product> ?? new List<FastFoodWeb.Models.Product>();
    var currentUser = Session["User"] as FastFoodWeb.Models.User;
}

<!-- TOPBAR -->
<header class="shop-nav bg-white border-bottom shadow-sm py-2">
    <div class="container d-flex justify-content-between align-items-center">
        <a href="@Url.Action("Index", "Shop")" class="shop-brand text-decoration-none d-flex align-items-center gap-2 text-dark fw-bold fs-5">
            <span class="badge bg-danger p-2"><i class="fas fa-hamburger fs-5"></i></span>
            <span>FastFood Express</span>
        </a>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-danger btn-sm fw-bold border-danger-subtle" data-bs-toggle="modal" data-bs-target="#trackOrderModal" onclick="openTrackOrderModal()">
                <i class="fas fa-truck-fast text-danger me-1"></i>
                <span>Theo Dõi Đơn</span>
            </button>
            <button type="button" class="btn btn-outline-warning text-dark btn-sm fw-bold border-warning-subtle" data-bs-toggle="modal" data-bs-target="#pointsModal" onclick="openPointsModal()">
                <i class="fas fa-coins text-warning me-1"></i>
                <span>Tra Cứu Điểm</span>
                @if (ViewBag.CustomerPoints > 0)
                {
                    <span class="badge bg-danger ms-1" title="Hạng: @ViewBag.CustomerTier">@ViewBag.CustomerPoints đ</span>
                }
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                <i class="fas fa-comment-dots me-1"></i>
                <span>Khiếu Nại / Góp Ý</span>
            </button>
            @if (currentUser != null)
            {
                <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-dark btn-sm fw-semibold" title="Xem & sửa thông tin cá nhân">
                    <i class="fas fa-user-circle text-danger me-1"></i> @currentUser.FullName
                    <i class="fas fa-pen-to-square text-muted ms-1" style="font-size: 0.72rem;"></i>
                </a>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-sm btn-outline-danger ms-1" title="Đăng xuất">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-dark">
                    <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                </a>
                <a href="@Url.Action("Register", "Account")" class="btn btn-sm btn-danger fw-semibold">
                    <i class="fas fa-user-plus me-1"></i> Đăng ký
                </a>
            }
        </div>
    </div>
</header>

<!-- HERO BANNER -->
<section class="shop-hero py-4 text-white" style="background: linear-gradient(135deg, #1E293B, #0F172A);">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <span class="badge bg-danger rounded-pill px-3 py-1 mb-2">FAST & DELICIOUS</span>
                <h1 class="hero-title fw-bold">Thực Đơn Đồ Ăn Nhanh Hảo Hạng</h1>
                <p class="text-white-50">Thưởng thức gà rán giòn rụm, burger bò phô mai đậm vị và các set combo tiết kiệm. Đặt món trực tuyến giao nhanh nóng hổi tận nơi trong 30 phút.</p>
            </div>
            <div class="col-lg-4 text-lg-end d-none d-lg-block">
                <div class="p-3 rounded-3 d-inline-block text-start border border-secondary" style="background: rgba(255,255,255,0.06);">
                    <div class="small text-warning fw-bold mb-1"><i class="fas fa-truck-fast me-1"></i> Giao Hàng Siêu Tốc</div>
                    <div class="small text-white-50">Freeship cho đơn hàng từ 100.000 đ</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT: MENU & SIDEBAR -->
<div class="container py-4">
    <div class="row g-4">
        <!-- CỘT 1 & 2: DANH MỤC & MÓN ĂN -->
        <div class="col-xxl-8 col-xl-8 col-lg-8 col-md-12">
            <!-- Filter Bar -->
            <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
                <button type="button" class="btn btn-sm btn-dark filter-btn active" onclick="filterMenu('all', this)">Tất Cả Món</button>
                <button type="button" class="btn btn-sm btn-outline-secondary filter-btn" onclick="filterMenu('combo', this)">Combo Tiết Kiệm</button>
                @foreach (var cat in categories)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary filter-btn" onclick="filterMenu('@cat.CategoryId', this)">@cat.CategoryName</button>
                }
            </div>

            <!-- Foods Grid -->
            <div class="row g-3" id="foodItemsContainer">
                @foreach (var item in Model)
                {
                    bool isOut = item.StockQuantity <= 0 || !item.IsActive;
                    <div class="col-md-6 col-sm-6 food-item" data-category="@item.CategoryId" data-combo="@item.IsCombo.ToString().ToLower()">
                        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                            <div class="position-relative" style="height: 180px; overflow: hidden; background: #f8fafc;">
                                <img src="@item.ImageURL" class="w-100 h-100 object-fit-cover" alt="@item.ProductName" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500'" />
                                @if (item.IsCombo)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">COMBO</span>
                                }
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="fw-bold text-dark text-truncate" title="@item.ProductName">@item.ProductName</h6>
                                    <p class="small text-muted mb-2 text-truncate-2" style="font-size: 0.8rem; min-height: 2.4em;">@item.Description</p>
                                </div>
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-danger fs-5">@item.Price.ToString("N0") đ</span>
                                        @if (isOut)
                                        {
                                            <span class="badge bg-secondary">Tạm hết</span>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Còn @item.StockQuantity</span>
                                        }
                                    </div>
                                    @if (isOut)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm w-100" disabled>Tạm Hết Hàng</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-danger btn-sm w-100 fw-bold" data-id="@item.ProductId" data-name="@item.ProductName" data-price="@item.Price" onclick="addToCartBtn(this)">
                                            <i class="fas fa-plus me-1"></i> Chọn Món
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- CỘT 3: GIỎ HÀNG & CHATBOT (PHẢI) -->
        <div class="col-xxl-4 col-xl-4 col-lg-4 col-md-12" id="shopSidebarRight">
            <!-- TAB SWITCHER -->
            <div class="d-flex p-1 bg-white rounded-3 mb-3 border shadow-sm" style="position: sticky; top: 75px; z-index: 1020;">
                <button type="button" class="btn btn-sm flex-fill fw-bold rounded-2 btn-dark text-white active" id="tabBtnCart" onclick="switchRightPanel('cart')">
                    <i class="fas fa-bag-shopping text-danger me-1"></i> Giỏ Hàng (<span id="cartCountBadgeTab">0</span>)
                </button>
                <button type="button" class="btn btn-sm flex-fill fw-bold rounded-2 text-muted" id="tabBtnAi" onclick="switchRightPanel('ai')">
                    <i class="fas fa-robot text-primary me-1"></i> Trợ Lý AI
                </button>
            </div>

            <!-- KHỐI 1: GIỎ HÀNG -->
            <div class="card p-3 border shadow-sm rounded-3" id="cartPanelWrap">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-bag-shopping text-danger me-2"></i> Giỏ Hàng Của Bạn</h6>
                    <span id="cartCountBadge" class="badge bg-danger">0 món</span>
                </div>

                <div id="cartItemsList" style="max-height: 200px; overflow-y: auto; margin-bottom: 14px;">
                    <div class="text-center py-4 text-muted" id="emptyCartNotice">
                        <i class="fas fa-shopping-basket fa-2x mb-2 d-block opacity-25"></i>
                        <span class="small">Chưa có món ăn nào trong giỏ</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2 pt-2 border-top">
                    <span class="text-muted small fw-semibold">Tạm tính tiền món:</span>
                    <span class="fs-5 fw-bold text-dark" id="subTotalText">0 đ</span>
                </div>

                <!-- SỐ ĐIỆN THOẠI & TRA CỨU ĐIỂM -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-0" style="font-size: 0.75rem;">
                            Số điện thoại nhận hàng <span class="text-danger">*</span>:
                        </label>
                        <button type="button" class="btn btn-sm btn-link p-0 text-warning text-decoration-none fw-bold" style="font-size: 0.75rem;" onclick="checkPointsFromCart()">
                            <i class="fas fa-coins me-1"></i>Kiểm tra điểm
                        </button>
                    </div>
                    <input type="tel" class="form-control form-control-sm" id="custPhone" placeholder="09xxxxxxxx (Nhận hàng & tích điểm)" value="@ViewBag.CustomerPhone" onblur="handlePhoneBlur()" oninput="handlePhoneInput()" required />
                </div>

                <!-- KHỐI DÙNG ĐIỂM TÍCH LŨY -->
                <div id="loyaltyCartBox" class="p-2 mb-2 rounded-2 border border-warning-subtle d-none" style="background: #FFFBEB;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-dark"><i class="fas fa-coins text-warning me-1"></i> Khách hàng: <span id="loyaltyCustomerName" class="text-primary fw-bold"></span></span>
                        <span class="badge bg-danger small" id="loyaltyCustomerTier">Đồng</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                        <span>Điểm khả dụng: <b class="text-danger" id="loyaltyCustomerPoints">0</b> điểm</span>
                        <span>Quy đổi: <b class="text-success" id="loyaltyCustomerValue">0 đ</b></span>
                    </div>
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="chkUseLoyaltyPoints" onchange="toggleUsePointsCart()">
                        <label class="form-check-label small fw-bold text-dark" for="chkUseLoyaltyPoints">Sử dụng điểm giảm giá đơn này</label>
                    </div>
                    <div id="loyaltyPointsInputWrap" class="d-none mt-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white small text-muted">Dùng</span>
                            <input type="number" id="inputPointsToUse" class="form-control form-control-sm text-center fw-bold text-danger" min="1" value="0" oninput="onPointsAmountChange()">
                            <span class="input-group-text bg-white small text-muted">điểm</span>
                            <button type="button" class="btn btn-sm btn-dark" onclick="useMaxPointsCart()">Tối đa</button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="small text-muted" style="font-size: 0.72rem;">* 1 điểm = 1.000 đ giảm giá</span>
                            <span class="small text-danger fw-bold" id="loyaltyDiscountPreviewText">-0 đ</span>
                        </div>
                    </div>
                </div>

                <!-- TÊN KHÁCH HÀNG (TÙY CHỌN CHO KHÁCH VÃNG LAI) -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-muted text-uppercase mb-1" style="font-size: 0.75rem;">Họ tên người nhận (Tùy chọn):</label>
                    <input type="text" class="form-control form-control-sm" id="custName" placeholder="Tên của bạn..." value="@(currentUser != null ? currentUser.FullName : "")" />
                </div>

                <!-- ĐỊA CHỈ NHẬN HÀNG -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-muted text-uppercase mb-1" style="font-size: 0.75rem;">Địa chỉ giao hàng <span class="text-danger">*</span>:</label>
                    <textarea class="form-control form-control-sm" id="deliveryAddress" rows="2" placeholder="Số nhà, tên đường, phường/xã..." oninput="onAddressChanged()"></textarea>
                    <div id="deliveryFeeStatus" class="small mt-1 fw-semibold"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase mb-1" style="font-size: 0.75rem;">Hình thức thanh toán:</label>
                    <select class="form-select form-select-sm" id="payMethod">
                        <option value="COD">Tiền mặt khi nhận hàng (COD)</option>
                        <option value="VNPAY">Thanh toán VNPAY QR Online</option>
                    </select>
                </div>

                <!-- CHI TIẾT THANH TOÁN -->
                <div class="pt-2 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-1 small text-muted" id="rowShipFee">
                        <span>Phí vận chuyển:</span>
                        <span class="fw-semibold text-dark" id="cartShipFeeText">0 đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1 small text-danger" id="rowDiscountPoints" style="display: none;">
                        <span><i class="fas fa-tag me-1"></i> Giảm trừ điểm tích lũy:</span>
                        <span class="fw-bold" id="cartDiscountPointsText">-0 đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 pt-1">
                        <span class="fw-bold text-dark">TỔNG THANH TOÁN:</span>
                        <span class="fs-4 fw-bold text-danger" id="finalTotalText">0 đ</span>
                    </div>
                </div>

                <button class="btn btn-danger w-100 fw-bold py-2 shadow-sm" id="btnSubmitOrder" onclick="checkoutOrder()">
                    XÁC NHẬN ĐẶT HÀNG
                </button>
            </div>

            <!-- KHỐI 2: CHATBOT AI -->
            <div class="card p-3 border shadow-sm rounded-3 mt-3" id="botCardWrap">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="p-2 rounded-circle bg-primary text-white"><i class="fas fa-robot"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-bold small text-dark">Trợ Lý AI Tư Vấn Ẩm Thực</div>
                        <small class="text-muted" style="font-size: 0.72rem;">Hỏi thực đơn, ưu đãi hoặc đặt món</small>
                    </div>
                </div>

                <div class="chat-logs p-2 mb-3 rounded-2 bg-light border" id="chatLogs" style="max-height: 220px; min-height: 120px; overflow-y: auto;">
                    <div class="p-2 rounded-2 bg-white small mb-2 shadow-sm">
                        👋 Chào bạn! Bạn có thể gõ <b>menu</b> để xem các món, hoặc hỏi chính sách <b>điểm thưởng</b>!
                    </div>
                </div>

                <div class="input-group input-group-sm">
                    <input type="text" id="botInput" class="form-control" placeholder="Nhắn tin cho AI..." onkeypress="if(event.key === 'Enter') sendBotMessage()">
                    <button class="btn btn-dark px-3 fw-bold" onclick="sendBotMessage()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL THEO DÕI TRẠNG THÁI ĐƠN HÀNG -->
<div class="modal fade" id="trackOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 620px;">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3" style="background: linear-gradient(135deg, #1E293B, #0F172A); color: #fff;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger text-white" style="width: 40px; height: 40px;">
                        <i class="fas fa-truck-fast fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-white mb-0">Theo Dõi Trạng Thái Đơn Hàng</h6>
                        <small class="text-white-50" style="font-size: 0.75rem;">Chuẩn bị (5 phút) → Đang giao hàng → Đã giao thành công</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-1">Nhập Mã Đơn Hàng Hoặc Số Điện Thoại:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" id="trackQueryInput" class="form-control" placeholder="Ví dụ: ONLINE... hoặc 0987654321" onkeypress="if(event.key === 'Enter') queryTrackOrder()" />
                        <button type="button" class="btn btn-danger fw-bold px-3" onclick="queryTrackOrder()">
                            <i class="fas fa-satellite-dish me-1"></i> Tra Cứu
                        </button>
                    </div>
                </div>

                <div id="trackLoadingState" class="text-center py-4 d-none">
                    <i class="fas fa-spinner fa-spin fa-2x text-danger mb-2"></i>
                    <div class="small text-muted">Đang cập nhật tiến trình đơn hàng...</div>
                </div>
                <div id="trackErrorAlert" class="alert alert-warning py-2 px-3 small rounded-3 d-none mb-3"></div>

                <div id="trackResultCard" class="d-none">
                    <div class="p-3 rounded-3 mb-3 bg-light border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Mã đơn: <b class="text-dark font-monospace" id="trackOrderCode">--</b></span>
                            <span class="text-muted small" id="trackOrderDate">--</span>
                        </div>
                        <div class="fs-5 fw-bold text-danger mb-1" id="trackStatusTitle">Đang chuẩn bị món</div>
                        <div class="small text-muted mb-2" id="trackStatusDesc">Đầu bếp đang chế biến các món ăn nóng hổi.</div>
                        <div id="trackTimerBadgeWrap">
                            <span class="badge bg-warning text-dark py-2 px-3 rounded-pill fw-bold" id="trackTimerBadge">
                                <i class="fas fa-stopwatch me-1"></i> <span id="trackTimerText">04:59</span>
                            </span>
                        </div>
                    </div>

                    <!-- STEPPER 3 BƯỚC -->
                    <div class="position-relative mb-4 px-2">
                        <div class="progress" style="height: 4px; position: absolute; top: 22px; left: 10%; right: 10%; z-index: 1;">
                            <div class="progress-bar bg-danger" id="trackProgressBar" style="width: 33%;"></div>
                        </div>
                        <div class="d-flex justify-content-between text-center position-relative" style="z-index: 2;">
                            <div style="width: 30%;">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" id="stepIcon1" style="width: 44px; height: 44px; background: #E11D48; color: #fff;">
                                    <i class="fas fa-utensils"></i>
                                </div>
                                <div class="fw-bold small mt-2 text-danger" id="stepText1">1. Đang Chuẩn Bị</div>
                                <small class="text-muted" style="font-size: 0.7rem;">0 - 5 phút</small>
                            </div>
                            <div style="width: 30%;">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" id="stepIcon2" style="width: 44px; height: 44px; background: #E2E8F0; color: #64748B;">
                                    <i class="fas fa-motorcycle"></i>
                                </div>
                                <div class="fw-bold small mt-2 text-muted" id="stepText2">2. Đang Giao Hàng</div>
                                <small class="text-muted" style="font-size: 0.7rem;">Sau 5 phút</small>
                            </div>
                            <div style="width: 30%;">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" id="stepIcon3" style="width: 44px; height: 44px; background: #E2E8F0; color: #64748B;">
                                    <i class="fas fa-circle-check"></i>
                                </div>
                                <div class="fw-bold small mt-2 text-muted" id="stepText3">3. Đã Giao Hàng</div>
                                <small class="text-muted" style="font-size: 0.7rem;">Hoàn tất</small>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 bg-white border mb-3">
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted">Tài xế giao hàng:</span>
                                <div class="fw-bold text-dark"><i class="fas fa-user-tie text-danger me-1"></i> <span id="trackShipperName">Nguyễn Văn Giao</span></div>
                                <div class="text-muted small"><i class="fas fa-phone text-muted me-1"></i> <span id="trackShipperPhone">0901234567</span></div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Địa chỉ nhận hàng:</span>
                                <div class="fw-semibold text-dark text-truncate" id="trackAddress">--</div>
                                <div class="text-muted small"><i class="fas fa-credit-card text-muted me-1"></i> <span id="trackPayMethod">Tiền mặt</span></div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between align-items-center small fw-bold text-dark mb-2">
                            <span><i class="fas fa-list-check text-danger me-1"></i> Món Ăn Trong Đơn:</span>
                            <span class="text-danger fs-6" id="trackTotalAmount">0 đ</span>
                        </div>
                        <div id="trackItemsList" class="border rounded-2 p-2 bg-light" style="max-height: 140px; overflow-y: auto;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TRA CỨU ĐIỂM -->
<div class="modal fade" id="pointsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 580px;">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3" style="background: linear-gradient(135deg, #1E293B, #0F172A); color: #fff;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning text-dark" style="width: 38px; height: 38px;">
                        <i class="fas fa-coins fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-white mb-0">Tra Cứu Điểm Thưởng & Hạng Thành Viên</h6>
                        <small class="text-white-50" style="font-size: 0.75rem;">10.000 đ = 1 điểm · 1 điểm = 1.000 đ chiết khấu trực tiếp</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark text-uppercase mb-1">Nhập Số Điện Thoại Thành Viên:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="fas fa-phone"></i></span>
                        <input type="tel" id="lookupPhoneInput" class="form-control" placeholder="Ví dụ: 0987654321..." onkeypress="if(event.key === 'Enter') queryPointsFromModal()" />
                        <button type="button" class="btn btn-dark fw-bold px-3" onclick="queryPointsFromModal()">
                            <i class="fas fa-search me-1"></i> Tra Cứu
                        </button>
                    </div>
                </div>

                <div id="pointsLoadingState" class="text-center py-4 d-none">
                    <i class="fas fa-spinner fa-spin fa-2x text-warning mb-2"></i>
                    <div class="small text-muted">Đang tra cứu dữ liệu thành viên...</div>
                </div>
                <div id="pointsErrorAlert" class="alert alert-warning py-2 px-3 small rounded-3 d-none mb-3"></div>

                <div id="pointsResultCard" class="d-none">
                    <div class="p-3 rounded-3 mb-3 text-white position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, #E11D48, #BE123C);">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="text-white-50 small text-uppercase fw-semibold">Thẻ Thành Viên FastFood</div>
                                <h5 class="fw-bold mb-0 text-white" id="resCustName">--</h5>
                                <small class="text-white-50" id="resCustPhone">--</small>
                            </div>
                            <span class="badge bg-white text-danger fw-bold px-3 py-2 fs-6 rounded-pill shadow-sm" id="resCustTierBadge">
                                <i class="fas fa-crown text-warning me-1"></i> <span id="resCustTier">Đồng</span>
                            </span>
                        </div>
                        <div class="row g-2 mt-2 pt-2 border-top border-white border-opacity-25 align-items-center">
                            <div class="col-6">
                                <div class="text-white-50 small">Điểm tích lũy hiện có:</div>
                                <div class="fs-3 fw-bold text-warning"><span id="resCustPoints">0</span> <span class="fs-6 fw-normal text-white">điểm</span></div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-white-50 small">Quy đổi giảm giá:</div>
                                <div class="fs-4 fw-bold text-white" id="resCustValue">0 đ</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <div class="d-flex justify-content-between align-items-center small mb-1">
                            <span class="fw-bold text-dark"><i class="fas fa-chart-line text-primary me-1"></i> Tiến trình thăng hạng:</span>
                            <span class="text-muted" id="resNextTierDesc">Cần thêm điểm để lên hạng tiếp theo</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated" id="resTierProgressBar" style="width: 35%;"></div>
                        </div>
                    </div>

                    <div>
                        <div class="fw-bold text-dark small mb-2"><i class="fas fa-clock-rotate-left text-danger me-1"></i> Lịch Sử Giao Dịch Điểm:</div>
                        <div id="resPointHistoryList" class="border rounded-2 p-2 bg-white" style="max-height: 160px; overflow-y: auto;"></div>
                    </div>

                    <div class="mt-3 pt-3 border-top d-flex gap-2">
                        <button type="button" class="btn btn-danger flex-fill fw-bold py-2 justify-content-center" onclick="applyCustomerToCart()">
                            <i class="fas fa-bag-shopping me-1"></i> Áp Dụng Dùng Điểm Cho Giỏ Hàng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL GỬI KHIẾU NẠI -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-bold text-dark"><i class="fas fa-comment-dots text-danger me-2"></i>Gửi Khiếu Nại & Phản Ánh Dịch Vụ</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Họ và tên:</label>
                    <input type="text" id="fbName" class="form-control" placeholder="Nguyễn Văn A" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Số điện thoại liên hệ:</label>
                    <input type="tel" id="fbPhone" class="form-control" placeholder="09xxxxxxxx" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Nội dung phản ánh:</label>
                    <textarea id="fbContent" class="form-control" rows="3" placeholder="Chất lượng món ăn, thời gian giao hàng hoặc thái độ nhân viên..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" onclick="sendComplaint()">Gửi Phản Hồi</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ĐẶT HÀNG THÀNH CÔNG -->
<div class="modal fade" id="shopOrderSuccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content rounded-4 border-0 shadow text-center p-4">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 58px; height: 58px; background: #ECFDF5; color: #10B981; font-size: 1.8rem;">
                <i class="fas fa-check"></i>
            </div>
            <h5 class="fw-bold mb-1 text-dark">Đặt Hàng Thành Công!</h5>
            <p class="text-muted small mb-3">Đơn hàng của bạn đã được chuyển đến bếp chế biến</p>

            <div class="p-3 rounded-3 text-start small mb-3 bg-light border">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Mã đơn hàng:</span>
                    <span class="fw-bold text-dark font-monospace" id="shopSuccessOrderCode">--</span>
                </div>
                <div class="d-flex justify-content-between mb-1" id="shopSuccessShipperRow">
                    <span class="text-muted">Tài xế giao hàng:</span>
                    <span class="fw-semibold text-dark" id="shopSuccessShipper">--</span>
                </div>
                <div class="d-flex justify-content-between mb-1" id="shopSuccessPointsUsedRow" style="display: none;">
                    <span class="text-muted">Điểm đã sử dụng:</span>
                    <span class="fw-bold text-danger" id="shopSuccessPointsUsed">-0 điểm</span>
                </div>
                <div class="d-flex justify-content-between mb-1" id="shopSuccessPointsEarnedRow" style="display: none;">
                    <span class="text-muted">Điểm tích lũy thêm:</span>
                    <span class="fw-bold text-success" id="shopSuccessPointsEarned">+0 điểm</span>
                </div>
                <div class="d-flex justify-content-between mb-1" id="shopSuccessPointsRemainingRow" style="display: none;">
                    <span class="text-muted">Số dư điểm hiện có:</span>
                    <span class="fw-bold text-warning" id="shopSuccessPointsRemaining">0 điểm</span>
                </div>
                <div class="d-flex justify-content-between pt-1 border-top">
                    <span class="text-muted">Thời gian dự kiến:</span>
                    <span class="fw-bold text-success">Khoảng 20 - 30 phút</span>
                </div>
            </div>

            <button type="button" class="btn btn-danger w-100 py-2 fw-bold mb-2 shadow-sm" onclick="trackFromSuccess()">
                <i class="fas fa-truck-fast me-1"></i> Theo Dõi Trực Tiếp Đơn Hàng Này
            </button>
            <button type="button" class="btn btn-outline-secondary w-100 py-2 fw-semibold" data-bs-dismiss="modal">
                <i class="fas fa-utensils me-1"></i> Tiếp tục xem thực đơn
            </button>
        </div>
    </div>
</div>

<!-- TOAST CONTAINER -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;" id="shopToastContainer"></div>

@section scripts {
<script>
    let cart = [];
    let shippingFee = 0;
    let currentCustomer = null;
    let pointsDiscountAmount = 0;
    let pointsToUse = 0;
    let isUsingPoints = false;
    let phoneCheckTimeout = null;
    let trackIntervalId = null;
    let trackCurrentSeconds = 0;

    function formatMoney(amount) {
        return Number(amount).toLocaleString('vi-VN') + ' đ';
    }

    function openPointsModal(prefillPhone) {
        const phone = prefillPhone || document.getElementById('custPhone')?.value.trim() || '@ViewBag.CustomerPhone';
        const input = document.getElementById('lookupPhoneInput');
        if (input && phone) input.value = phone;
        const modalEl = document.getElementById('pointsModal');
        if (modalEl) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
            if (input && input.value.trim()) queryPointsFromModal();
        }
    }

    function queryPointsFromModal() {
        const phone = document.getElementById('lookupPhoneInput')?.value.trim() || '';
        const loading = document.getElementById('pointsLoadingState');
        const alertBox = document.getElementById('pointsErrorAlert');
        const resultCard = document.getElementById('pointsResultCard');

        if (!phone) {
            alertBox.textContent = 'Vui lòng nhập số điện thoại thành viên cần tra cứu!';
            alertBox.classList.remove('d-none');
            resultCard.classList.add('d-none');
            return;
        }

        loading.classList.remove('d-none');
        alertBox.classList.add('d-none');
        resultCard.classList.add('d-none');

        fetch('@Url.Action("GetCustomerPoints", "Shop")?phone=' + encodeURIComponent(phone))
            .then(r => r.json())
            .then(data => {
                loading.classList.add('d-none');
                if (data.success && data.customer) {
                    const cust = data.customer;
                    currentCustomer = cust;
                    document.getElementById('resCustName').textContent = cust.name || 'Khách hàng';
                    document.getElementById('resCustPhone').textContent = cust.phone;
                    document.getElementById('resCustTier').textContent = cust.tier || 'Đồng';
                    document.getElementById('resCustPoints').textContent = cust.points || 0;
                    document.getElementById('resCustValue').textContent = formatMoney(cust.discountValue || (cust.points * 1000));

                    const p = cust.points || 0;
                    let nextDesc = '';
                    let progress = 0;
                    if (p < 50) {
                        nextDesc = 'Cần thêm ' + (50 - p) + ' điểm để lên Bạc (50đ)';
                        progress = Math.min(100, Math.round((p / 50) * 100));
                    } else if (p < 150) {
                        nextDesc = 'Cần thêm ' + (150 - p) + ' điểm để lên Vàng (150đ)';
                        progress = Math.min(100, Math.round(((p - 50) / 100) * 100));
                    } else if (p < 300) {
                        nextDesc = 'Cần thêm ' + (300 - p) + ' điểm để lên Kim Cương (300đ)';
                        progress = Math.min(100, Math.round(((p - 150) / 150) * 100));
                    } else {
                        nextDesc = 'Bạn đang là thành viên VIP Kim Cương!';
                        progress = 100;
                    }
                    document.getElementById('resNextTierDesc').textContent = nextDesc;
                    document.getElementById('resTierProgressBar').style.width = progress + '%';

                    const histEl = document.getElementById('resPointHistoryList');
                    if (data.history && data.history.length > 0) {
                        histEl.innerHTML = `
                            <table class="table table-sm table-borderless small mb-0">
                                <tbody>
                                    ${data.history.map(h => `
                                        <tr class="border-bottom border-light">
                                            <td class="text-muted text-nowrap py-1" style="width: 140px;">${h.date}</td>
                                            <td class="py-1">${h.description}</td>
                                            <td class="text-end fw-bold py-1 ${h.points >= 0 ? 'text-success' : 'text-danger'}">
                                                ${h.points > 0 ? '+' : ''}${h.points} đ
                                            </td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>`;
                    } else {
                        histEl.innerHTML = '<div class="text-muted small text-center py-2">Chưa có giao dịch tích điểm nào.</div>';
                    }

                    resultCard.classList.remove('d-none');
                    updateCartLoyaltyUI(cust);
                } else {
                    alertBox.textContent = data.message || 'Không tìm thấy dữ liệu thành viên cho số điện thoại này.';
                    alertBox.classList.remove('d-none');
                }
            })
            .catch(() => {
                loading.classList.add('d-none');
                alertBox.textContent = 'Lỗi kết nối máy chủ khi tra cứu điểm!';
                alertBox.classList.remove('d-none');
            });
    }

    function applyCustomerToCart() {
        const phone = document.getElementById('resCustPhone')?.textContent || document.getElementById('lookupPhoneInput')?.value.trim();
        if (phone) {
            const phoneInput = document.getElementById('custPhone');
            if (phoneInput) phoneInput.value = phone;
        }
        const modalEl = document.getElementById('pointsModal');
        if (modalEl) bootstrap.Modal.getInstance(modalEl)?.hide();

        switchRightPanel('cart');
        handlePhoneBlur();

        setTimeout(() => {
            const chk = document.getElementById('chkUseLoyaltyPoints');
            if (chk && !chk.checked && currentCustomer && currentCustomer.points > 0) {
                chk.checked = true;
                toggleUsePointsCart();
            }
            showShopToast('Đã áp dụng thông tin thành viên vào giỏ hàng!', 'success');
        }, 300);
    }

    function checkPointsFromCart() {
        openPointsModal(document.getElementById('custPhone')?.value.trim());
    }

    function handlePhoneInput() {
        clearTimeout(phoneCheckTimeout);
        const val = (document.getElementById('custPhone')?.value || '').trim().replace(/[\s.-]/g, '');
        if (val.length >= 10) phoneCheckTimeout = setTimeout(handlePhoneBlur, 500);
    }

    function handlePhoneBlur() {
        const phone = (document.getElementById('custPhone')?.value || '').trim();
        if (!phone || phone.length < 9) {
            document.getElementById('loyaltyCartBox')?.classList.add('d-none');
            isUsingPoints = false;
            pointsDiscountAmount = 0;
            pointsToUse = 0;
            renderCart();
            return;
        }

        fetch('@Url.Action("GetCustomerPoints", "Shop")?phone=' + encodeURIComponent(phone))
            .then(r => r.json())
            .then(data => {
                if (data.success && data.customer) {
                    currentCustomer = data.customer;
                    updateCartLoyaltyUI(data.customer);
                } else {
                    currentCustomer = null;
                    document.getElementById('loyaltyCartBox')?.classList.add('d-none');
                    isUsingPoints = false;
                    pointsDiscountAmount = 0;
                    pointsToUse = 0;
                    renderCart();
                }
            })
            .catch(() => {});
    }

    function updateCartLoyaltyUI(cust) {
        const box = document.getElementById('loyaltyCartBox');
        if (!box || !cust) return;

        document.getElementById('loyaltyCustomerName').textContent = cust.name;
        document.getElementById('loyaltyCustomerTier').textContent = cust.tier;
        document.getElementById('loyaltyCustomerPoints').textContent = cust.points;
        document.getElementById('loyaltyCustomerValue').textContent = formatMoney(cust.points * 1000);

        box.classList.remove('d-none');

        const chk = document.getElementById('chkUseLoyaltyPoints');
        if (chk) {
            chk.disabled = cust.points <= 0;
            if (cust.points <= 0) chk.checked = false;
        }
        renderCart();
    }

    function toggleUsePointsCart() {
        const chk = document.getElementById('chkUseLoyaltyPoints');
        const wrap = document.getElementById('loyaltyPointsInputWrap');
        isUsingPoints = Boolean(chk && chk.checked);

        if (isUsingPoints) {
            wrap?.classList.remove('d-none');
            useMaxPointsCart();
        } else {
            wrap?.classList.add('d-none');
            pointsDiscountAmount = 0;
            pointsToUse = 0;
            renderCart();
        }
    }

    function useMaxPointsCart() {
        if (!currentCustomer) return;
        let subTotal = 0;
        cart.forEach(i => subTotal += i.price * i.quantity);
        const maxPointsCanUse = Math.min(currentCustomer.points || 0, Math.floor(subTotal / 1000));
        pointsToUse = Math.max(0, maxPointsCanUse);
        const input = document.getElementById('inputPointsToUse');
        if (input) input.value = pointsToUse;
        onPointsAmountChange();
    }

    function onPointsAmountChange() {
        if (!isUsingPoints || !currentCustomer) return;
        const input = document.getElementById('inputPointsToUse');
        let val = parseInt(input?.value, 10);
        if (isNaN(val) || val < 0) val = 0;

        let subTotal = 0;
        cart.forEach(i => subTotal += i.price * i.quantity);
        const maxPointsCanUse = Math.min(currentCustomer.points || 0, Math.floor(subTotal / 1000));

        if (val > maxPointsCanUse) {
            val = maxPointsCanUse;
            if (input) input.value = val;
        }
        pointsToUse = val;
        pointsDiscountAmount = pointsToUse * 1000;

        const preview = document.getElementById('loyaltyDiscountPreviewText');
        if (preview) preview.textContent = '-' + formatMoney(pointsDiscountAmount);

        renderCart();
    }

    function filterMenu(catId, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active', 'btn-dark'));
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.add('btn-outline-secondary'));
        if (btn) {
            btn.classList.add('active', 'btn-dark');
            btn.classList.remove('btn-outline-secondary');
        }

        const items = document.querySelectorAll('.food-item');
        items.forEach(el => {
            let show = false;
            if (catId === 'all') show = true;
            else if (catId === 'combo') show = el.getAttribute('data-combo') === 'true';
            else show = el.getAttribute('data-category') === String(catId);
            el.style.display = show ? 'block' : 'none';
        });
    }

    function addToCartBtn(btn) {
        if (!btn) return;
        const id = parseInt(btn.getAttribute('data-id'), 10);
        const name = btn.getAttribute('data-name') || '';
        const price = parseFloat(btn.getAttribute('data-price')) || 0;
        addToCart(id, name, price);
    }

    function addToCart(id, name, price) {
        const found = cart.find(i => i.id === id);
        if (found) found.quantity++;
        else cart.push({ id, name, price, quantity: 1 });
        renderCart();
        showShopToast('Đã thêm "' + name + '" vào giỏ!', 'success');
    }

    function updateItemQuantity(id, delta) {
        const idx = cart.findIndex(i => i.id === id);
        if (idx !== -1) {
            cart[idx].quantity += delta;
            if (cart[idx].quantity <= 0) cart.splice(idx, 1);
            renderCart();
        }
    }

    function renderCart() {
        const listEl = document.getElementById('cartItemsList');
        const noticeEl = document.getElementById('emptyCartNotice');
        const subTotalEl = document.getElementById('subTotalText');
        const finalTotalEl = document.getElementById('finalTotalText');
        const badgeEl = document.getElementById('cartCountBadge');
        const rowDiscount = document.getElementById('rowDiscountPoints');
        const rowShip = document.getElementById('rowShipFee');
        const shipFeeEl = document.getElementById('cartShipFeeText');
        const discTextEl = document.getElementById('cartDiscountPointsText');

        if (cart.length === 0) {
            listEl.innerHTML = '';
            listEl.appendChild(noticeEl);
            noticeEl.style.display = 'block';
            badgeEl.innerText = '0 món';
            document.getElementById('cartCountBadgeTab').innerText = '0';
            subTotalEl.innerText = '0 đ';
            if (rowDiscount) rowDiscount.style.display = 'none';
            if (rowShip) rowShip.style.display = 'none';
            finalTotalEl.innerText = formatMoney(shippingFee);
            return;
        }

        listEl.innerHTML = '';
        let subTotal = 0;
        let totalCount = 0;

        cart.forEach(item => {
            totalCount += item.quantity;
            subTotal += item.price * item.quantity;

            const row = document.createElement('div');
            row.className = 'd-flex justify-content-between align-items-center mb-2 pb-2 border-bottom';
            row.innerHTML = `
                <div style="max-width: 55%;">
                    <div class="fw-semibold small text-truncate text-dark">${item.name}</div>
                    <small class="text-danger">${formatMoney(item.price)}</small>
                </div>
                <div class="d-flex align-items-center bg-light rounded-2 border px-1">
                    <button class="btn btn-sm p-0 px-2 text-muted border-0" onclick="updateItemQuantity(${item.id}, -1)">-</button>
                    <span class="small fw-bold px-2">${item.quantity}</span>
                    <button class="btn btn-sm p-0 px-2 text-muted border-0" onclick="updateItemQuantity(${item.id}, 1)">+</button>
                </div>`;
            listEl.appendChild(row);
        });

        if (isUsingPoints && currentCustomer && currentCustomer.points > 0) {
            const maxPoints = Math.min(currentCustomer.points, Math.floor(subTotal / 1000));
            if (pointsToUse > maxPoints) {
                pointsToUse = maxPoints;
                const input = document.getElementById('inputPointsToUse');
                if (input) input.value = pointsToUse;
            }
            pointsDiscountAmount = pointsToUse * 1000;
            if (pointsDiscountAmount > 0) {
                if (rowDiscount) rowDiscount.style.display = 'flex';
                if (discTextEl) discTextEl.innerText = '-' + formatMoney(pointsDiscountAmount);
            } else {
                if (rowDiscount) rowDiscount.style.display = 'none';
            }
        } else {
            pointsDiscountAmount = 0;
            if (rowDiscount) rowDiscount.style.display = 'none';
        }

        // TÍNH PHÍ SHIP TỰ ĐỘNG & MINH BẠCH:
        // Đơn >= 100k: Miễn phí ship (0đ)
        // Đơn < 100k: 15.000đ
        if (subTotal >= 100000) {
            shippingFee = 0;
            if (shipFeeEl) shipFeeEl.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fas fa-check-circle me-1"></i> Miễn phí (Đơn >= 100k)</span>';
        } else {
            shippingFee = 15000;
            const diff = 100000 - subTotal;
            if (shipFeeEl) shipFeeEl.innerHTML = `<span class="fw-semibold text-dark">${formatMoney(shippingFee)}</span> <small class="text-muted d-block" style="font-size:0.7rem;">(Mua thêm ${formatMoney(diff)} để được Freeship)</small>`;
        }

        const finalTotal = Math.max(0, subTotal - pointsDiscountAmount) + shippingFee;
        badgeEl.innerText = `${totalCount} món`;
        document.getElementById('cartCountBadgeTab').innerText = String(totalCount);
        subTotalEl.innerText = formatMoney(subTotal);
        finalTotalEl.innerText = formatMoney(finalTotal);
    }

    function showShopToast(message, type) {
        var container = document.getElementById('shopToastContainer');
        if (!container) return;
        var toastEl = document.createElement('div');
        toastEl.className = 'toast align-items-center text-white bg-' + (type === 'error' ? 'danger' : 'dark') + ' border-0 show mb-2';
        toastEl.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
        container.appendChild(toastEl);
        setTimeout(() => toastEl.remove(), 3500);
    }

    function checkoutOrder() {
        if (cart.length === 0) return showShopToast('Vui lòng chọn ít nhất 1 món ăn!', 'warning');
        const phone = document.getElementById('custPhone').value.trim();
        if (!phone) return showShopToast('Vui lòng nhập số điện thoại nhận hàng!', 'warning');
        const cleanPhone = phone.replace(/[\s.-]/g, '');
        if (!/^[0-9]{9,11}$/.test(cleanPhone)) {
            return showShopToast('Số điện thoại không hợp lệ (cần từ 9 đến 11 số)!', 'warning');
        }

        const address = document.getElementById('deliveryAddress').value.trim();
        if (!address) return showShopToast('Vui lòng nhập địa chỉ nhận hàng!', 'warning');

        const custName = document.getElementById('custName')?.value.trim() || '';
        const btn = document.getElementById('btnSubmitOrder');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý...';

        fetch('@Url.Action("Checkout", "Shop")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                Items: cart,
                Address: address,
                PaymentMethod: document.getElementById('payMethod').value,
                ShippingFee: shippingFee,
                CustomerPhone: cleanPhone,
                CustomerName: custName,
                UsePoints: isUsingPoints,
                PointsToUse: pointsToUse
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                if (data.isRedirect && data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    document.getElementById('shopSuccessOrderCode').textContent = data.orderCode;
                    const shipperEl = document.getElementById('shopSuccessShipper');
                    if (data.driverName) {
                        shipperEl.textContent = data.driverName + ' (' + (data.driverPhone || '') + ')';
                        document.getElementById('shopSuccessShipperRow').style.display = 'flex';
                    } else {
                        document.getElementById('shopSuccessShipperRow').style.display = 'none';
                    }

                    if (data.pointsUsed > 0) {
                        document.getElementById('shopSuccessPointsUsed').textContent = '-' + data.pointsUsed + ' điểm (-' + formatMoney(data.discountAmount) + ')';
                        document.getElementById('shopSuccessPointsUsedRow').style.display = 'flex';
                    } else {
                        document.getElementById('shopSuccessPointsUsedRow').style.display = 'none';
                    }

                    if (data.pointsEarned > 0) {
                        document.getElementById('shopSuccessPointsEarned').textContent = '+' + data.pointsEarned + ' điểm';
                        document.getElementById('shopSuccessPointsEarnedRow').style.display = 'flex';
                    } else {
                        document.getElementById('shopSuccessPointsEarnedRow').style.display = 'none';
                    }

                    if (data.remainingPoints !== undefined) {
                        document.getElementById('shopSuccessPointsRemaining').textContent = data.remainingPoints + ' điểm';
                        document.getElementById('shopSuccessPointsRemainingRow').style.display = 'flex';
                    } else {
                        document.getElementById('shopSuccessPointsRemainingRow').style.display = 'none';
                    }

                    bootstrap.Modal.getOrCreateInstance(document.getElementById('shopOrderSuccessModal')).show();
                    cart = [];
                    isUsingPoints = false;
                    renderCart();
                    document.getElementById('deliveryAddress').value = '';
                }
            } else {
                showShopToast(data.message || 'Lỗi khi đặt hàng!', 'error');
            }
        })
        .catch(() => showShopToast('Đã tiếp nhận đơn hàng thành công!', 'info'))
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = 'XÁC NHẬN ĐẶT HÀNG';
        });
    }

    // THEO DÕI ĐƠN HÀNG THỜI GIAN THỰC (5p -> đang giao, 15p -> đã giao)
    function openTrackOrderModal(prefillCode) {
        if (trackIntervalId) {
            clearInterval(trackIntervalId);
            trackIntervalId = null;
        }
        const query = prefillCode || document.getElementById('custPhone')?.value.trim() || '';
        const input = document.getElementById('trackQueryInput');
        if (input && query) input.value = query;
        const modalEl = document.getElementById('trackOrderModal');
        if (modalEl) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
            if (input && input.value.trim()) queryTrackOrder();
        }
    }

    function queryTrackOrder() {
        const query = document.getElementById('trackQueryInput')?.value.trim();
        const loading = document.getElementById('trackLoadingState');
        const alertBox = document.getElementById('trackErrorAlert');
        const resultCard = document.getElementById('trackResultCard');

        if (!query) {
            alertBox.textContent = 'Vui lòng nhập mã đơn hàng hoặc số điện thoại!';
            alertBox.classList.remove('d-none');
            resultCard.classList.add('d-none');
            return;
        }

        loading.classList.remove('d-none');
        alertBox.classList.add('d-none');
        resultCard.classList.add('d-none');

        if (trackIntervalId) {
            clearInterval(trackIntervalId);
            trackIntervalId = null;
        }

        fetch('@Url.Action("TrackOrder", "Shop")?query=' + encodeURIComponent(query))
            .then(r => r.json())
            .then(data => {
                loading.classList.add('d-none');
                if (data.success && data.order) {
                    renderTrackUI(data.order);
                } else {
                    alertBox.textContent = data.message || 'Không tìm thấy thông tin đơn hàng!';
                    alertBox.classList.remove('d-none');
                }
            })
            .catch(() => {
                loading.classList.add('d-none');
                alertBox.textContent = 'Lỗi kết nối máy chủ khi tra cứu!';
                alertBox.classList.remove('d-none');
            });
    }

    function renderTrackUI(order) {
        const resultCard = document.getElementById('trackResultCard');
        resultCard.classList.remove('d-none');

        document.getElementById('trackOrderCode').textContent = order.orderCode;
        document.getElementById('trackOrderDate').textContent = order.orderDate;
        document.getElementById('trackShipperName').textContent = order.shipperName;
        document.getElementById('trackShipperPhone').textContent = order.shipperPhone;
        document.getElementById('trackAddress').textContent = order.shippingAddress || 'Nhận tại quầy';
        document.getElementById('trackPayMethod').textContent = order.paymentMethod;
        document.getElementById('trackTotalAmount').textContent = formatMoney(order.totalAmount);

        const itemsEl = document.getElementById('trackItemsList');
        itemsEl.innerHTML = '';
        if (order.items && order.items.length) {
            order.items.forEach(it => {
                itemsEl.innerHTML += `
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
                        <div>
                            <span class="fw-semibold text-dark">${it.productName}</span>
                            <small class="text-muted ms-1">x${it.quantity}</small>
                        </div>
                        <span class="text-danger fw-bold">${formatMoney(it.lineTotal)}</span>
                    </div>`;
            });
        }

        trackCurrentSeconds = order.elapsedSeconds || 0;
        updateTrackStep(trackCurrentSeconds);

        trackIntervalId = setInterval(function() {
            trackCurrentSeconds += 1;
            updateTrackStep(trackCurrentSeconds);
        }, 1000);
    }

    function updateTrackStep(seconds) {
        const step1Icon = document.getElementById('stepIcon1');
        const step2Icon = document.getElementById('stepIcon2');
        const step3Icon = document.getElementById('stepIcon3');
        const step1Text = document.getElementById('stepText1');
        const step2Text = document.getElementById('stepText2');
        const step3Text = document.getElementById('stepText3');
        const progressBar = document.getElementById('trackProgressBar');
        const titleEl = document.getElementById('trackStatusTitle');
        const descEl = document.getElementById('trackStatusDesc');
        const timerBadge = document.getElementById('trackTimerBadge');
        const timerText = document.getElementById('trackTimerText');

        if (seconds < 300) {
            progressBar.style.width = '33%';
            step1Icon.style.background = '#E11D48';
            step1Icon.style.color = '#fff';
            step1Text.className = 'fw-bold small mt-2 text-danger';

            step2Icon.style.background = '#E2E8F0';
            step2Icon.style.color = '#64748B';
            step2Text.className = 'fw-bold small mt-2 text-muted';

            step3Icon.style.background = '#E2E8F0';
            step3Icon.style.color = '#64748B';
            step3Text.className = 'fw-bold small mt-2 text-muted';

            const remain = 300 - seconds;
            const min = Math.floor(remain / 60);
            const sec = remain % 60;
            const fmt = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;

            titleEl.textContent = 'Đang chuẩn bị món';
            descEl.textContent = 'Đầu bếp đang chế biến các món ăn nóng hổi theo đơn của bạn.';
            timerBadge.className = 'badge bg-warning text-dark py-2 px-3 rounded-pill fw-bold';
            timerText.innerHTML = `<i class="fas fa-clock me-1"></i> Bếp đang làm món: chuyển giao hàng sau <b>${fmt}</b>`;
        } 
        else if (seconds < 900) {
            progressBar.style.width = '66%';
            step1Icon.style.background = '#10B981';
            step1Icon.style.color = '#fff';
            step1Text.className = 'fw-bold small mt-2 text-success';

            step2Icon.style.background = '#0284C7';
            step2Icon.style.color = '#fff';
            step2Text.className = 'fw-bold small mt-2 text-primary';

            step3Icon.style.background = '#E2E8F0';
            step3Icon.style.color = '#64748B';
            step3Text.className = 'fw-bold small mt-2 text-muted';

            const remain = 900 - seconds;
            const min = Math.floor(remain / 60);
            const sec = remain % 60;
            const fmt = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;

            titleEl.textContent = 'Đang giao hàng';
            descEl.textContent = 'Tài xế đang di chuyển giao hàng đến địa chỉ của bạn.';
            timerBadge.className = 'badge bg-primary text-white py-2 px-3 rounded-pill fw-bold';
            timerText.innerHTML = `<i class="fas fa-motorcycle me-1"></i> Đang giao hàng: dự kiến đến nơi sau <b>${fmt}</b>`;
        } 
        else {
            progressBar.style.width = '100%';
            step1Icon.style.background = '#10B981';
            step1Icon.style.color = '#fff';
            step1Text.className = 'fw-bold small mt-2 text-success';

            step2Icon.style.background = '#10B981';
            step2Icon.style.color = '#fff';
            step2Text.className = 'fw-bold small mt-2 text-success';

            step3Icon.style.background = '#10B981';
            step3Icon.style.color = '#fff';
            step3Text.className = 'fw-bold small mt-2 text-success';

            titleEl.textContent = 'Đã giao hàng thành công';
            descEl.textContent = 'Đơn hàng đã được giao tận nơi. Chúc bạn có bữa ăn thật ngon miệng!';
            timerBadge.className = 'badge bg-success text-white py-2 px-3 rounded-pill fw-bold';
            timerText.innerHTML = `<i class="fas fa-circle-check me-1"></i> Đã hoàn tất giao hàng`;
        }
    }

    function trackFromSuccess() {
        const code = document.getElementById('shopSuccessOrderCode')?.textContent?.trim();
        bootstrap.Modal.getInstance(document.getElementById('shopOrderSuccessModal'))?.hide();
        openTrackOrderModal(code);
    }

    function sendBotMessage() {
        const input = document.getElementById('botInput');
        const msg = input.value.trim();
        if (!msg) return;
        const chatLogs = document.getElementById('chatLogs');
        chatLogs.innerHTML += `<div class="p-2 rounded-2 bg-primary text-white small mb-2 text-end ms-auto" style="max-width: 80%;">${msg}</div>`;
        input.value = '';

        fetch('@Url.Action("ChatBot", "Shop")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: msg })
        })
        .then(r => r.json())
        .then(data => {
            chatLogs.innerHTML += `<div class="p-2 rounded-2 bg-white small mb-2 shadow-sm" style="max-width: 85%;">🤖 ${data.reply.replace(/\n/g, '<br>')}</div>`;
            chatLogs.scrollTop = chatLogs.scrollHeight;
        });
    }

    function switchRightPanel(tab) {
        const tabCart = document.getElementById('tabBtnCart');
        const tabAi = document.getElementById('tabBtnAi');
        const cartWrap = document.getElementById('cartPanelWrap');
        const botWrap = document.getElementById('botCardWrap');

        if (tab === 'ai') {
            tabCart?.classList.remove('btn-dark', 'text-white', 'active');
            tabAi?.classList.add('btn-primary', 'text-white', 'active');
            if (cartWrap) cartWrap.style.display = 'none';
            if (botWrap) botWrap.style.display = 'block';
        } else {
            tabAi?.classList.remove('btn-primary', 'text-white', 'active');
            tabCart?.classList.add('btn-dark', 'text-white', 'active');
            if (cartWrap) cartWrap.style.display = 'block';
            if (botWrap) botWrap.style.display = window.innerWidth >= 992 ? 'block' : 'none';
        }
    }

    function openFloatingAiChat() {
        switchRightPanel('ai');
        document.getElementById('botCardWrap')?.scrollIntoView({ behavior: 'smooth' });
    }

    function sendComplaint() {
        const name = document.getElementById('fbName').value.trim();
        const phone = document.getElementById('fbPhone').value.trim();
        const content = document.getElementById('fbContent').value.trim();
        if (!content) return showShopToast('Vui lòng nhập nội dung phản hồi!', 'warning');

        fetch('@Url.Action("SendComplaint", "Shop")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ customerName: name, phone: phone, content: content })
        })
        .then(r => r.json())
        .then(data => {
            showShopToast(data.message || 'Đã gửi phản hồi thành công!', 'success');
            bootstrap.Modal.getInstance(document.getElementById('feedbackModal'))?.hide();
            document.getElementById('fbContent').value = '';
        });
    }

    window.addEventListener('DOMContentLoaded', function() {
        const phone = document.getElementById('custPhone')?.value.trim();
        if (phone && phone.length >= 9) handlePhoneBlur();
    });
</script>
}
