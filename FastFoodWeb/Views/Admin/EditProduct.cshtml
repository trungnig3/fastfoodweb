@model FastFoodWeb.Models.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Chỉnh Sửa Món Ăn";
    var categories = ViewBag.Categories as IEnumerable<FastFoodWeb.Models.Category> ?? new List<FastFoodWeb.Models.Category>();
}

<div class="container py-3" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0 text-dark">Chỉnh Sửa Món Ăn #@Model.ProductId</h4>
        <a href="@Url.Action("Products", "Admin")" class="btn btn-outline-dark btn-sm"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card p-4 border shadow-sm rounded-4">
        @using (Html.BeginForm("EditProduct", "Admin", new { id = Model.ProductId }, FormMethod.Post))
        {
            <div class="mb-3">
                <label class="form-label small fw-bold">Tên món ăn *:</label>
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", required = "required" })
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Giá bán (VNĐ) *:</label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", required = "required" })
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Số lượng tồn kho thực tế *:</label>
                    @Html.TextBoxFor(m => m.StockQuantity, new { @class = "form-control", type = "number", required = "required" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Danh mục món ăn *:</label>
                <select name="CategoryId" class="form-select" required>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId" @(c.CategoryId == Model.CategoryId ? "selected" : "")>@c.CategoryName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Đường dẫn hình ảnh (URL):</label>
                @Html.TextBoxFor(m => m.ImageURL, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Mô tả món ăn:</label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3" })
            </div>

            <div class="d-flex gap-4 mb-4">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsCombo, new { @class = "form-check-input" })
                    <label class="form-check-label small fw-bold" for="IsCombo">Là Combo tiết kiệm</label>
                </div>
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label small fw-bold" for="IsActive">Kinh doanh ngay</label>
                </div>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold">
                <i class="fas fa-save me-1"></i> Lưu Cập Nhật Món Ăn
            </button>
        }
    </div>
</div>
