@model IEnumerable<FastFoodWeb.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản Lý Tồn Kho";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Quản Lý Tồn Kho Sản Phẩm</h4>
        <p class="text-muted small mb-0">Theo dõi số lượng hàng thực tế, thông báo cạn kiệt và cập nhật kho nhanh chóng</p>
    </div>
</div>

<div class="card border shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">Hình</th>
                    <th>Tên Món Ăn</th>
                    <th>Danh Mục</th>
                    <th>Giá Bán</th>
                    <th style="width: 180px;">Số Lượng Trong Kho</th>
                    <th>Trạng Thái Kho</th>
                    <th class="text-end" style="width: 120px;">Lưu Nhanh</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <img src="@p.ImageURL" class="rounded object-fit-cover" style="width: 44px; height: 44px;" onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500'" />
                        </td>
                        <td>
                            <b class="text-dark">@p.ProductName</b>
                        </td>
                        <td>@(p.Category != null ? p.Category.CategoryName : (p.CategoryId == 1 ? "Món Chính" : "Combo"))</td>
                        <td><b class="text-danger">@p.Price.ToString("N0") đ</b></td>
                        <td>
                            <div class="input-group input-group-sm">
                                <input type="number" id="stock_@p.ProductId" class="form-control text-center fw-bold" value="@p.StockQuantity" min="0" />
                                <span class="input-group-text">phần</span>
                            </div>
                        </td>
                        <td>
                            @if (p.StockQuantity <= 0)
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                            else if (p.StockQuantity <= 10)
                            {
                                <span class="badge bg-warning text-dark">Sắp hết hàng</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Còn hàng dồi dào</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-dark fw-bold" onclick="saveStock(@p.ProductId)">
                                <i class="fas fa-save me-1"></i> Lưu
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function saveStock(id) {
        const val = document.getElementById('stock_' + id).value;
        fetch('@Url.Action("UpdateStock", "Admin")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id + '&stock=' + encodeURIComponent(val)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('Đã cập nhật kho thành công!');
                location.reload();
            } else {
                alert(data.message || 'Lỗi cập nhật kho');
            }
        });
    }
</script>
