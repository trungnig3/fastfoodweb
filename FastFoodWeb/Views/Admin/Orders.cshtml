@model IEnumerable<FastFoodWeb.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Lịch Sử Đơn Hàng";
    decimal totalRevenue = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Quản Lý Lịch Sử Hóa Đơn & Đơn Hàng</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ đơn hàng trực tuyến và hóa đơn bán lẻ tại quầy POS</p>
    </div>
    <div class="badge bg-success fs-6 p-2">
        Tổng Doanh Thu: @totalRevenue.ToString("N0") đ
    </div>
</div>

<div class="card border shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Thời Gian</th>
                    <th>Thu Ngân / Kênh</th>
                    <th>Khách Hàng</th>
                    <th>Phương Thức</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th style="width: 200px;">Cập Nhật Nhanh</th>
                    <th class="text-end">Chi Tiết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><b class="text-danger font-monospace">@o.OrderCode</b></td>
                        <td class="small text-muted">@o.OrderDate.ToString("HH:mm:ss dd/MM/yyyy")</td>
                        <td>@(o.CashierId == 1 ? "Trực tuyến (Web)" : "Quầy POS")</td>
                        <td>@(o.CustomerName ?? o.CustomerPhone ?? "Khách lẻ")</td>
                        <td><span class="badge bg-light text-dark border">@o.PaymentMethod</span></td>
                        <td><b class="text-dark">@o.TotalAmount.ToString("N0") đ</b></td>
                        <td>
                            <span class="badge @(o.OrderStatus == "Hoàn tất" ? "bg-success" : (o.OrderStatus == "Đã hủy" ? "bg-danger" : "bg-warning text-dark"))">
                                @(o.ShippingStatus ?? o.OrderStatus)
                            </span>
                        </td>
                        <td>
                            <select class="form-select form-select-sm" onchange="changeStatusAdmin(@o.OrderId, this.value)">
                                <option value="Đang chuẩn bị món" @(o.ShippingStatus == "Đang chuẩn bị món" ? "selected" : "")>👨‍🍳 Đang chuẩn bị</option>
                                <option value="Đang giao hàng" @(o.ShippingStatus == "Đang giao hàng" ? "selected" : "")>🛵 Đang giao</option>
                                <option value="Đã giao thành công" @(o.ShippingStatus == "Đã giao thành công" ? "selected" : "")>✅ Đã giao</option>
                                <option value="Hoàn tất" @(o.OrderStatus == "Hoàn tất" ? "selected" : "")>⭐ Hoàn tất</option>
                                <option value="Đã hủy" @(o.OrderStatus == "Đã hủy" ? "selected" : "")>❌ Đã hủy</option>
                            </select>
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("OrderDetails", "Admin", new { id = o.OrderId })" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function changeStatusAdmin(id, st) {
        fetch('@Url.Action("UpdateOrderStatus", "Admin")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
            body: 'id=' + id + '&status=' + encodeURIComponent(st)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('Đã cập nhật trạng thái đơn #' + id);
                location.reload();
            } else {
                alert(data.message || 'Lỗi cập nhật');
            }
        })
        .catch(() => alert('Đã lưu trạng thái đơn #' + id));
    }
</script>
