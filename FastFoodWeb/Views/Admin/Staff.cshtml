@model IEnumerable<FastFoodWeb.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản Lý Nhân Viên & Lương";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Quản Lý Nhân Sự & Mức Lương Theo Giờ</h4>
        <p class="text-muted small mb-0">Thiết lập tài khoản nhân viên thu ngân, quyền hạn và tính toán lương ca tự động</p>
    </div>
</div>

<div class="card border shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Họ Và Tên</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Vai Trò</th>
                    <th>Số Điện Thoại</th>
                    <th>Mức Lương / Giờ</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><b>#@u.UserId</b></td>
                        <td><b class="text-dark">@u.FullName</b></td>
                        <td class="font-monospace text-primary">@u.Username</td>
                        <td>
                            <span class="badge @(u.RoleId == 1 ? "bg-danger" : (u.RoleId == 2 ? "bg-primary" : "bg-secondary"))">
                                @(u.RoleId == 1 ? "Quản trị viên (Admin)" : (u.RoleId == 2 ? "Thu ngân (Cashier)" : "Khách hàng"))
                            </span>
                        </td>
                        <td>@(u.PhoneNumber ?? "Chưa cập nhật")</td>
                        <td><b class="text-success">@u.HourlyRate.ToString("N0") đ/giờ</b></td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                @(u.IsActive ? "Đang làm việc" : "Đã khóa")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
