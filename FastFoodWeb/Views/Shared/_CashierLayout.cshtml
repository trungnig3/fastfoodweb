<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Bàn Làm Việc Thu Ngân FastFood</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 py-2 shadow-sm">
        <a class="navbar-brand fw-bold text-danger d-flex align-items-center gap-2" href="@Url.Action("Index", "Cashier")">
            <i class="fas fa-cash-register"></i> FastFood Cashier
        </a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="@Url.Action("Index", "Cashier")"><i class="fas fa-desktop me-1"></i> Bàn Thu Ngân</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="@Url.Action("Index", "Pos")"><i class="fas fa-calculator me-1"></i> Màn Hình POS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="@Url.Action("Orders", "Cashier")"><i class="fas fa-list-check me-1"></i> Đơn Trong Ca</a>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-light btn-sm"><i class="fas fa-shop me-1"></i> Cửa Hàng</a>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i> Đăng Xuất</a>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4 px-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
