<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-heading); letter-spacing: -0.02em;">Bàn Làm Việc Thu Ngân</h4>
        <p class="text-muted small mb-0">Ca trực: <strong><%= shiftInfo.shiftName %></strong> · Bắt đầu: <span class="tabular-nums"><%= shiftInfo.startTime %></span></p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Pos" class="btn-brand-primary">
            <i class="fas fa-desktop"></i> Mở Màn Hình Bán Hàng POS
        </a>
    </div>
</div>

<!-- 4 THẺ CHỈ SỐ CA LÀM VIỆC -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Doanh thu ca hiện tại</span>
                <span class="p-2 rounded-2 text-danger" style="background: #FFF1F2;">
                    <i class="fas fa-money-bill-wave"></i>
                </span>
            </div>
            <div class="fs-4 fw-bold tabular-nums text-dark mb-1">
                <%= Number(shiftRevenue).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted">
                Tiền mặt: <strong class="text-success"><%= Number(cashRevenue).toLocaleString('vi-VN') %> đ</strong>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Số hóa đơn đã lập</span>
                <span class="p-2 rounded-2 text-primary" style="background: #EFF6FF;">
                    <i class="fas fa-receipt"></i>
                </span>
            </div>
            <div class="fs-4 fw-bold tabular-nums text-dark mb-1">
                <%= shiftOrdersCount %> <span class="fs-6 fw-normal text-muted">đơn</span>
            </div>
            <div class="small text-muted">
                Chuyển khoản VNPAY: <strong><%= Number(transferRevenue).toLocaleString('vi-VN') %> đ</strong>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Tiền lẻ đầu ca</span>
                <span class="p-2 rounded-2 text-warning" style="background: #FFFBEB;">
                    <i class="fas fa-vault"></i>
                </span>
            </div>
            <div class="fs-4 fw-bold tabular-nums text-dark mb-1">
                <%= Number(startingCash).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted">
                Số dư ban đầu khi nhận ca
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="dash-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small fw-semibold text-uppercase">Lý thuyết trong két</span>
                <span class="p-2 rounded-2 text-success" style="background: #ECFDF5;">
                    <i class="fas fa-calculator"></i>
                </span>
            </div>
            <div class="fs-4 fw-bold tabular-nums text-success mb-1">
                <%= Number(expectedCashInDrawer).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted">
                Tiền mặt dự kiến có trong két
            </div>
        </div>
    </div>
</div>

<!-- LỊCH SỬ GIAO DỊCH GẦN ĐÂY CỦA THU NGÂN -->
<div class="dash-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-0 text-dark">Giao Dịch Gần Đây Trong Ca</h6>
            <small class="text-muted">Các đơn bán hàng được lập bởi tài khoản thu ngân hiện tại</small>
        </div>
        <a href="/Cashier/Orders" class="btn-brand-secondary py-1 px-3" style="font-size: 0.8rem;">
            Xem tất cả đơn <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="dash-table">
            <thead>
                <tr>
                    <th>Mã Hóa Đơn</th>
                    <th>Thời Gian</th>
                    <th>Phương Thức</th>
                    <th class="text-end">Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Chi Tiết</th>
                </tr>
            </thead>
            <tbody>
                <% if (recentOrders && recentOrders.length > 0) { %>
                    <% recentOrders.forEach(function(o) { %>
                        <tr>
                            <td>
                                <code><%= o.OrderCode %></code>
                            </td>
                            <td class="text-muted small tabular-nums">
                                <%= new Date(o.OrderDate).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                            </td>
                            <td>
                                <span class="small text-muted"><%= o.PaymentMethod %></span>
                            </td>
                            <td class="text-end tabular-nums fw-bold text-dark">
                                <%= Number(o.TotalAmount).toLocaleString('vi-VN') %> đ
                            </td>
                            <td>
                                <% if (o.OrderStatus === 'Hoàn tất' || o.OrderStatus === 'Completed') { %>
                                    <span class="status-badge badge-success"><i class="fas fa-check"></i> Hoàn tất</span>
                                <% } else if (o.OrderStatus === 'Pending') { %>
                                    <span class="status-badge badge-warning"><i class="fas fa-clock"></i> Chờ xử lý</span>
                                <% } else { %>
                                    <span class="status-badge badge-danger"><i class="fas fa-xmark"></i> Đã hủy</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <a href="/Cashier/OrderDetails/<%= o.OrderId %>" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.78rem; border-radius: 6px;">
                                    In / Xem
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Chưa phát sinh giao dịch nào trong ca làm việc này.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
