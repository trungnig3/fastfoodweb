<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biên Bản Đối Soát Ca Làm Việc | FastFood POS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        :root {
            --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        body {
            font-family: var(--font-sans);
            background-color: #F1F5F9;
            color: #1E293B;
            padding: 30px 15px;
        }

        .tabular-nums {
            font-variant-numeric: tabular-nums;
        }

        .receipt-card {
            max-width: 440px;
            margin: 0 auto;
            background: #FFFFFF;
            border-radius: 12px;
            border: 1px solid #E2E8F0;
            padding: 28px 24px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        }

        .receipt-header {
            text-align: center;
            border-bottom: 1px dashed #CBD5E1;
            padding-bottom: 16px;
            margin-bottom: 16px;
        }

        .receipt-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }

        .receipt-meta {
            font-size: 0.8rem;
            color: #64748B;
            line-height: 1.4;
        }

        .section-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748B;
            margin-bottom: 8px;
        }

        .receipt-line {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            margin-bottom: 6px;
        }

        .receipt-line.total-line {
            border-top: 1px dashed #CBD5E1;
            padding-top: 8px;
            margin-top: 8px;
            font-weight: 700;
            font-size: 0.92rem;
            color: #0F172A;
        }

        .diff-banner {
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            font-weight: 800;
            font-size: 0.95rem;
            margin: 14px 0;
        }

        .diff-success { background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; }
        .diff-warning { background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; }
        .diff-danger  { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; }

        .item-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.82rem;
            padding: 4px 0;
            border-bottom: 1px dotted #F1F5F9;
        }

        @media print {
            body { background: white; padding: 0; }
            .receipt-card { border: none; box-shadow: none; padding: 0; width: 100%; max-width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>

    <div class="receipt-card">
        <!-- HEADER -->
        <div class="receipt-header">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <i class="fas fa-hamburger text-danger fs-5"></i>
                <h5 class="receipt-title mb-0">FASTFOOD EXPRESS</h5>
            </div>
            <div class="fw-bold small text-dark mb-1">BIÊN BẢN ĐỐI SOÁT & KẾT CA</div>
            <div class="receipt-meta">
                <div>Thu ngân: <strong><%= cashierName %></strong></div>
                <div>Bắt đầu: <span class="tabular-nums"><%= new Date(startTime).toLocaleString('vi-VN') %></span></div>
                <div>Kết thúc: <span class="tabular-nums"><%= new Date(endTime).toLocaleString('vi-VN') %></span></div>
            </div>
        </div>

        <!-- CASH FLOW RECONCILIATION -->
        <div class="mb-3">
            <div class="section-label">Dòng tiền lý thuyết (Hệ thống)</div>
            
            <div class="receipt-line">
                <span class="text-muted">Tiền lẻ đầu ca:</span>
                <span class="tabular-nums fw-semibold"><%= Number(startingCash).toLocaleString('vi-VN') %> đ</span>
            </div>
            <div class="receipt-line">
                <span class="text-muted">+ Doanh thu Tiền mặt:</span>
                <span class="tabular-nums fw-semibold text-success">+<%= Number(cashRevenue).toLocaleString('vi-VN') %> đ</span>
            </div>
            <div class="receipt-line">
                <span class="text-muted">+ Doanh thu VNPAY QR:</span>
                <span class="tabular-nums fw-semibold text-primary">+<%= Number(transferRevenue).toLocaleString('vi-VN') %> đ</span>
            </div>
            
            <div class="receipt-line total-line">
                <span>LÝ THUYẾT TRONG KÉT:</span>
                <span class="tabular-nums text-danger"><%= Number(expectedCashInDrawer).toLocaleString('vi-VN') %> đ</span>
            </div>
        </div>

        <!-- ACTUAL CASH -->
        <div class="mb-2">
            <div class="section-label">Kiểm đếm thực tế</div>
            
            <div class="receipt-line fs-6 fw-bold">
                <span class="text-dark">TIỀN MẶT THỰC ĐẾM:</span>
                <span class="tabular-nums text-primary"><%= Number(actualCash).toLocaleString('vi-VN') %> đ</span>
            </div>

            <% 
                const diff = Number(cashDifference || 0);
                let diffText = 'KHỚP TIỀN 100%';
                let diffClass = 'diff-success';
                if (diff > 0) {
                    diffText = 'THỪA TIỀN: +' + diff.toLocaleString('vi-VN') + ' đ';
                    diffClass = 'diff-warning';
                } else if (diff < 0) {
                    diffText = 'THIẾU KÉT: ' + diff.toLocaleString('vi-VN') + ' đ (Trừ lương)';
                    diffClass = 'diff-danger';
                }
            %>

            <div class="diff-banner <%= diffClass %>">
                <%= diffText %>
            </div>
        </div>

        <!-- ITEMS SOLD BREAKDOWN -->
        <div class="mb-4 pt-2 border-top">
            <div class="section-label">Chi tiết sản phẩm đã bán trong ca</div>
            <% if (itemsSold && itemsSold.length > 0) { %>
                <% itemsSold.forEach(function(item) { %>
                    <div class="item-row">
                        <span class="text-dark"><%= item.ProductName %></span>
                        <span class="tabular-nums fw-bold text-muted">x<%= item.Quantity %></span>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="text-center py-2 text-muted small">Không phát sinh đơn bán nào trong ca.</div>
            <% } %>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="no-print d-flex flex-column gap-2 pt-2 border-top">
            <button type="button" class="btn btn-dark fw-semibold py-2" onclick="window.print()">
                <i class="fas fa-print me-1"></i> In Báo Cáo Đối Soát
            </button>
            <a href="/Pos" class="btn btn-outline-secondary fw-semibold py-2">
                <i class="fas fa-arrow-left me-1"></i> Mở Ca Mới (POS)
            </a>
            <a href="/Account/Logout" class="btn btn-danger fw-semibold py-2">
                <i class="fas fa-arrow-right-from-bracket me-1"></i> Xác Nhận & Đăng Xuất
            </a>
        </div>
    </div>

</body>
</html>
