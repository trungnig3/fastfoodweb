    <!-- FLOATING TOASTS -->
    <div class="pos-toast-wrap" id="posToastWrap"></div>

    <!-- Bootstrap 5 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Live Clock
        function updatePosClock() {
            var clock = document.getElementById('posLiveClock');
            if (clock) {
                var now = new Date();
                var h = String(now.getHours()).padStart(2, '0');
                var m = String(now.getMinutes()).padStart(2, '0');
                var s = String(now.getSeconds()).padStart(2, '0');
                clock.textContent = h + ':' + m + ':' + s;
            }
        }
        setInterval(updatePosClock, 1000);
        updatePosClock();

        // Toast Helper
        function showPosToast(message, type) {
            type = type || 'success';
            var wrap = document.getElementById('posToastWrap');
            var t = document.createElement('div');
            t.className = 'pos-toast toast-' + type;
            var icon = '<i class="fas fa-check-circle text-success fs-6"></i>';
            if (type === 'error') icon = '<i class="fas fa-circle-exclamation text-danger fs-6"></i>';
            if (type === 'warning') icon = '<i class="fas fa-triangle-exclamation text-warning fs-6"></i>';
            t.innerHTML = icon + '<span>' + message + '</span>';
            wrap.appendChild(t);
            setTimeout(function() {
                t.style.opacity = '0';
                t.style.transform = 'translateY(10px)';
                t.style.transition = 'all 0.2s';
                setTimeout(function() { if (t.parentNode) t.parentNode.removeChild(t); }, 200);
            }, 3000);
        }

        // Cart State
        var posCart = [];
        var activeCustomer = null;
        var activePaymentMethod = 'Tiền mặt';
        var currentFilterCat = 'all';
        var lastCompletedOrder = null;

        function formatVND(num) {
            return Number(num).toLocaleString('vi-VN') + ' đ';
        }

        // Filter Categories
        function filterCategory(cat, btn) {
            currentFilterCat = cat;
            document.querySelectorAll('.filter-tab-btn').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            applyCardFilters();
        }

        function filterBySearch(keyword) {
            applyCardFilters();
        }

        function applyCardFilters() {
            var query = (document.getElementById('dishSearch').value || '').trim().toLowerCase();
            var cols = document.querySelectorAll('.product-card-col');

            cols.forEach(function(col) {
                var itemCat = col.getAttribute('data-cat');
                var isCombo = col.getAttribute('data-combo') === 'true';
                var itemName = col.getAttribute('data-name') || '';

                var matchCat = true;
                if (currentFilterCat === 'combo') {
                    matchCat = isCombo;
                } else if (currentFilterCat !== 'all') {
                    matchCat = (itemCat === currentFilterCat);
                }

                var matchSearch = query ? itemName.includes(query) : true;

                if (matchCat && matchSearch) {
                    col.style.display = '';
                } else {
                    col.style.display = 'none';
                }
            });
        }

        // Add item to cart
        function addToCart(id, name, price, stock) {
            var item = posCart.find(function(x) { return x.id === id; });
            if (item) {
                if (item.quantity >= stock) {
                    showPosToast('Kho chỉ còn ' + stock + ' phần!', 'warning');
                    return;
                }
                item.quantity++;
            } else {
                if (stock <= 0) {
                    showPosToast('Món này đã tạm hết hàng!', 'error');
                    return;
                }
                posCart.push({ id: id, name: name, price: price, quantity: 1, stock: stock });
            }
            renderCartUI();
        }

        function changeItemQty(id, delta) {
            var idx = posCart.findIndex(function(x) { return x.id === id; });
            if (idx === -1) return;

            var item = posCart[idx];
            var newQty = item.quantity + delta;

            if (newQty <= 0) {
                posCart.splice(idx, 1);
            } else if (newQty > item.stock) {
                showPosToast('Kho chỉ còn ' + item.stock + ' phần!', 'warning');
                return;
            } else {
                item.quantity = newQty;
            }
            renderCartUI();
        }

        function removeCartItem(id) {
            posCart = posCart.filter(function(x) { return x.id !== id; });
            renderCartUI();
        }

        function clearCart() {
            posCart = [];
            renderCartUI();
        }

        // Render Cart UI
        function renderCartUI() {
            var wrap = document.getElementById('cartListWrap');
            var badge = document.getElementById('cartCountBadge');
            var payBtn = document.getElementById('btnSubmitCheckout');

            if (posCart.length === 0) {
                wrap.innerHTML = '\
                    <div class="text-center py-5 text-muted" id="emptyCartNotice">\
                        <i class="fas fa-utensils fa-2x mb-2 d-block opacity-25"></i>\
                        <div class="small fw-semibold">Chưa có món ăn nào trong đơn</div>\
                        <div class="small text-muted">Nhấp vào món bên trái để thêm vào hóa đơn</div>\
                    </div>';
                badge.textContent = '0 món';
                payBtn.disabled = true;
                renderCartTotals();
                return;
            }

            var totalCount = 0;
            var html = '';

            posCart.forEach(function(item) {
                totalCount += item.quantity;
                var lineTotal = item.price * item.quantity;
                html += '\
                    <div class="cart-item-row">\
                        <div class="cart-item-info">\
                            <div class="cart-item-name" title="' + item.name + '">' + item.name + '</div>\
                            <div class="cart-item-price tabular-nums">' + formatVND(item.price) + '</div>\
                        </div>\
                        <div class="cart-stepper">\
                            <button type="button" onclick="changeItemQty(' + item.id + ', -1)">-</button>\
                            <span class="tabular-nums">' + item.quantity + '</span>\
                            <button type="button" onclick="changeItemQty(' + item.id + ', 1)">+</button>\
                        </div>\
                        <div class="cart-item-total tabular-nums">' + formatVND(lineTotal) + '</div>\
                        <button type="button" class="cart-delete-btn" onclick="removeCartItem(' + item.id + ')" title="Xóa món">\
                            <i class="fas fa-xmark"></i>\
                        </button>\
                    </div>';
            });

            wrap.innerHTML = html;
            badge.textContent = totalCount + ' món';
            payBtn.disabled = false;
            renderCartTotals();
        }

        // Totals & Discount Calculation
        function renderCartTotals() {
            var subTotal = posCart.reduce(function(acc, x) { return acc + (x.price * x.quantity); }, 0);
            var discount = 0;

            var usePoints = document.getElementById('chkUseLoyaltyPoints')?.checked;
            if (usePoints && activeCustomer && activeCustomer.points > 0) {
                discount = activeCustomer.points * 1000;
                if (discount > subTotal) discount = subTotal;
                document.getElementById('cartDiscountRow').classList.remove('d-none');
                document.getElementById('cartDiscountDisplay').textContent = '-' + formatVND(discount);
            } else {
                document.getElementById('cartDiscountRow').classList.add('d-none');
            }

            var finalTotal = Math.max(0, subTotal - discount);
            document.getElementById('cartSubTotalDisplay').textContent = formatVND(subTotal);
            document.getElementById('cartFinalTotalDisplay').textContent = formatVND(finalTotal);
            document.getElementById('btnPayAmount').textContent = formatVND(finalTotal);

            calculateChange();
        }

        // Payment Method selection
        function setPaymentMode(mode) {
            activePaymentMethod = mode;
            var btnCash = document.getElementById('btnPayCash');
            var btnVnPay = document.getElementById('btnPayVnPay');
            var cashBox = document.getElementById('cashChangeCalcBox');

            if (mode === 'Tiền mặt') {
                btnCash.classList.add('active');
                btnVnPay.classList.remove('active');
                cashBox.classList.remove('d-none');
            } else {
                btnCash.classList.remove('active');
                btnVnPay.classList.add('active');
                cashBox.classList.add('d-none');
            }
        }

        // Cash Change Helpers
        function calculateChange() {
            var finalTotal = parseInt((document.getElementById('cartFinalTotalDisplay').textContent || '0').replace(/\D/g, ''), 10) || 0;
            var given = parseFloat(document.getElementById('cashGivenInput').value) || 0;
            var changeDisplay = document.getElementById('cashChangeDisplay');

            if (given > 0 && given >= finalTotal) {
                changeDisplay.textContent = formatVND(given - finalTotal);
                changeDisplay.classList.remove('text-danger');
                changeDisplay.classList.add('text-success');
            } else if (given > 0 && given < finalTotal) {
                changeDisplay.textContent = 'Còn thiếu ' + formatVND(finalTotal - given);
                changeDisplay.classList.remove('text-success');
                changeDisplay.classList.add('text-danger');
            } else {
                changeDisplay.textContent = '0 đ';
                changeDisplay.classList.remove('text-danger');
                changeDisplay.classList.add('text-success');
            }
        }

        function setQuickCash(amount) {
            document.getElementById('cashGivenInput').value = amount;
            calculateChange();
        }

        function setExactCash() {
            var finalTotal = parseInt((document.getElementById('cartFinalTotalDisplay').textContent || '0').replace(/\D/g, ''), 10) || 0;
            document.getElementById('cashGivenInput').value = finalTotal;
            calculateChange();
        }

        // Customer Loyalty Search
        function searchLoyaltyCustomer() {
            var phone = (document.getElementById('txtPhoneInput').value || '').trim();
            if (!phone) {
                showPosToast('Vui lòng nhập số điện thoại khách hàng!', 'warning');
                return;
            }

            fetch('/Pos/FindCustomer?phone=' + encodeURIComponent(phone))
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    var pill = document.getElementById('customerFoundPill');
                    var newAlert = document.getElementById('newCustomerAlert');

                    if (data.found) {
                        activeCustomer = data;
                        document.getElementById('customerFoundName').textContent = 'Khách: ' + data.name;
                        document.getElementById('customerFoundPoints').textContent = data.points;
                        document.getElementById('customerFoundTier').textContent = data.tier;
                        pill.classList.remove('d-none');
                        newAlert.classList.add('d-none');
                        showPosToast('Đã nhận diện thành viên: ' + data.name, 'success');
                    } else {
                        activeCustomer = null;
                        pill.classList.add('d-none');
                        newAlert.classList.remove('d-none');
                        showPosToast('Khách hàng mới sẽ được tạo sau đơn này', 'info');
                    }
                    renderCartTotals();
                })
                .catch(function() {
                    showPosToast('Lỗi khi tra cứu khách hàng!', 'error');
                });
        }

        // Submit Checkout
        function submitPosOrder() {
            if (posCart.length === 0) {
                showPosToast('Giỏ hàng trống!', 'warning');
                return;
            }

            var phone = (document.getElementById('txtPhoneInput').value || '').trim();
            var usePoints = document.getElementById('chkUseLoyaltyPoints')?.checked || false;
            var btn = document.getElementById('btnSubmitCheckout');

            btn.disabled = true;
            btn.innerHTML = '<span><i class="fas fa-spinner fa-spin me-1"></i> ĐANG XỬ LÝ...</span>';

            var payload = {
                Items: posCart.map(function(i) { return { Id: i.id, Quantity: i.quantity }; }),
                CustomerId: activeCustomer ? activeCustomer.id : null,
                CustomerPhone: phone,
                PaymentMethod: activePaymentMethod,
                UsePoints: usePoints
            };

            fetch('/Pos/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    if (data.isRedirect && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        var phoneVal = (document.getElementById('txtPhoneInput').value || '').trim();
                        var cashGivenNum = parseFloat(document.getElementById('cashGivenInput').value) || 0;
                        var discountEl = document.getElementById('cartDiscountRow');
                        var isDiscountActive = discountEl && !discountEl.classList.contains('d-none');

                        lastCompletedOrder = {
                            orderCode: data.orderCode,
                            items: JSON.parse(JSON.stringify(posCart)),
                            subtotal: document.getElementById('cartSubTotalDisplay').textContent,
                            discount: isDiscountActive ? document.getElementById('cartDiscountDisplay').textContent : '0 đ',
                            totalAmount: document.getElementById('cartFinalTotalDisplay').textContent,
                            paymentMethod: activePaymentMethod === 'VnPay' ? 'VNPAY QR' : 'Tiền mặt',
                            cashGiven: activePaymentMethod === 'Cash' ? (cashGivenNum > 0 ? formatVnd(cashGivenNum) : document.getElementById('cartFinalTotalDisplay').textContent) : '0 đ',
                            change: activePaymentMethod === 'Cash' ? document.getElementById('cashChangeDisplay').textContent : '0 đ',
                            customer: activeCustomer ? activeCustomer.name + ' (' + activeCustomer.phone + ')' : (phoneVal ? phoneVal : 'Khách lẻ tại quầy'),
                            cashier: '<%= cashierName %>',
                            time: new Date().toLocaleString('vi-VN')
                        };

                        document.getElementById('successOrderCode').textContent = data.orderCode;
                        document.getElementById('successPaymentMethod').textContent = lastCompletedOrder.paymentMethod;
                        document.getElementById('successTotalAmount').textContent = lastCompletedOrder.totalAmount;

                        var modal = new bootstrap.Modal(document.getElementById('orderSuccessModal'));
                        modal.show();

                        // Reset cart state
                        posCart = [];
                        activeCustomer = null;
                        document.getElementById('txtPhoneInput').value = '';
                        document.getElementById('cashGivenInput').value = '';
                        document.getElementById('customerFoundPill').classList.add('d-none');
                        document.getElementById('newCustomerAlert').classList.add('d-none');
                        renderCartUI();
                    }
                } else {
                    showPosToast(data.message || 'Thanh toán thất bại!', 'error');
                }
            })
            .catch(function() {
                showPosToast('Lỗi kết nối máy chủ!', 'error');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = '<span><i class="fas fa-check-circle me-1"></i> THANH TOÁN</span><span class="tabular-nums" id="btnPayAmount">' + document.getElementById('cartFinalTotalDisplay').textContent + '</span>';
            });
        }

        // Print Receipt (Prints ONLY the isolated 80mm receipt ticket, not the web page)
        function printReceipt() {
            if (!lastCompletedOrder) {
                showPosToast('Không có dữ liệu biên lai!', 'warning');
                return;
            }

            var itemsRows = '';
            (lastCompletedOrder.items || []).forEach(function(item) {
                itemsRows += '<tr>' +
                    '<td style="padding: 5px 0; border-bottom: 1px dotted #ccc;">' +
                        '<div style="font-weight: bold;">' + item.name + '</div>' +
                        '<div style="font-size: 11px; color: #555;">' + item.quantity + ' x ' + formatVnd(item.price) + '</div>' +
                    '</td>' +
                    '<td style="padding: 5px 0; text-align: right; vertical-align: top; font-weight: bold; border-bottom: 1px dotted #ccc;">' +
                        formatVnd(item.price * item.quantity) +
                    '</td>' +
                '</tr>';
            });

            var receiptHtml = 
                '<div style="width: 72mm; margin: 0 auto; padding: 2mm; font-family: \'Courier New\', Courier, monospace, sans-serif; font-size: 13px; color: #000; line-height: 1.35;">' +
                    '<div style="text-align: center; margin-bottom: 6px;">' +
                        '<div style="font-size: 18px; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase;">FASTFOOD SYSTEM</div>' +
                        '<div style="font-size: 11px; color: #333; margin-top: 2px;">Cửa Hàng Thức Ăn Nhanh & POS</div>' +
                        '<div style="font-size: 11px; color: #444;">ĐC: Cầu Giấy, Hà Nội · Hotline: 1900 1234</div>' +
                    '</div>' +
                    '<div style="border-top: 1px dashed #000; margin: 6px 0;"></div>' +
                    '<div style="text-align: center; font-size: 15px; font-weight: bold; margin: 4px 0 2px;">HÓA ĐƠN BÁN LẺ</div>' +
                    '<div style="font-size: 12px; font-weight: bold; text-align: center;">Số HĐ: ' + lastCompletedOrder.orderCode + '</div>' +
                    '<div style="border-top: 1px dashed #000; margin: 6px 0;"></div>' +
                    '<div style="font-size: 11px; line-height: 1.5;">' +
                        '<div><strong>Thời gian:</strong> ' + lastCompletedOrder.time + '</div>' +
                        '<div><strong>Thu ngân:</strong> ' + lastCompletedOrder.cashier + '</div>' +
                        '<div><strong>Khách hàng:</strong> ' + lastCompletedOrder.customer + '</div>' +
                    '</div>' +
                    '<div style="border-top: 1px dashed #000; margin: 6px 0;"></div>' +
                    '<table style="width: 100%; border-collapse: collapse; font-size: 12px;">' +
                        '<thead>' +
                            '<tr style="border-bottom: 1px solid #000;">' +
                                '<th style="text-align: left; padding-bottom: 4px;">Món ăn</th>' +
                                '<th style="text-align: right; padding-bottom: 4px;">Thành tiền</th>' +
                            '</tr>' +
                        '</thead>' +
                        '<tbody>' + itemsRows + '</tbody>' +
                    '</table>' +
                    '<div style="border-top: 1px dashed #000; margin: 8px 0;"></div>' +
                    '<table style="width: 100%; font-size: 12px; line-height: 1.6;">' +
                        '<tr><td>Tiền hàng:</td><td style="text-align: right; font-weight: 600;">' + lastCompletedOrder.subtotal + '</td></tr>' +
                        (lastCompletedOrder.discount !== '0 đ' ? '<tr><td>Giảm tích điểm:</td><td style="text-align: right; color: red;">' + lastCompletedOrder.discount + '</td></tr>' : '') +
                        '<tr style="font-size: 14px; font-weight: bold;"><td style="padding-top: 4px; border-top: 1px solid #000;">TỔNG CỘNG:</td><td style="text-align: right; padding-top: 4px; border-top: 1px solid #000;">' + lastCompletedOrder.totalAmount + '</td></tr>' +
                        '<tr><td>Phương thức:</td><td style="text-align: right; font-weight: 600;">' + lastCompletedOrder.paymentMethod + '</td></tr>' +
                        (lastCompletedOrder.paymentMethod === 'Tiền mặt' ?
                            '<tr><td>Tiền khách đưa:</td><td style="text-align: right;">' + lastCompletedOrder.cashGiven + '</td></tr>' +
                            '<tr><td style="font-weight: bold;">Tiền thối lại:</td><td style="text-align: right; font-weight: bold;">' + lastCompletedOrder.change + '</td></tr>' : '') +
                    '</table>' +
                    '<div style="border-top: 1px dashed #000; margin: 10px 0;"></div>' +
                    '<div style="text-align: center; font-size: 11px; color: #222;">' +
                        '<div style="font-weight: bold;">CẢM ƠN QUÝ KHÁCH & HẸN GẶP LẠI!</div>' +
                        '<div style="margin-top: 3px; font-size: 10px; color: #666;">(Phiếu tính tiền khởi tạo trực tiếp tại quầy POS)</div>' +
                    '</div>' +
                '</div>';

            var printFrame = document.getElementById('receiptPrintIframe');
            if (!printFrame) {
                printFrame = document.createElement('iframe');
                printFrame.id = 'receiptPrintIframe';
                printFrame.style.position = 'fixed';
                printFrame.style.right = '0';
                printFrame.style.bottom = '0';
                printFrame.style.width = '0';
                printFrame.style.height = '0';
                printFrame.style.border = '0';
                document.body.appendChild(printFrame);
            }

            var frameDoc = printFrame.contentWindow.document;
            frameDoc.open();
            frameDoc.write('<!DOCTYPE html><html><head><title>BienLai_' + lastCompletedOrder.orderCode + '</title>');
            frameDoc.write('<style>');
            frameDoc.write('@page { size: 80mm auto; margin: 0; }');
            frameDoc.write('body { margin: 0; padding: 0; background: #fff; color: #000; -webkit-print-color-adjust: exact; }');
            frameDoc.write('</style></head><body>');
            frameDoc.write(receiptHtml);
            frameDoc.write('</body></html>');
            frameDoc.close();

            setTimeout(function() {
                printFrame.contentWindow.focus();
                printFrame.contentWindow.print();
            }, 300);
        }

        // Starting Cash Modal Save
        function saveStartingCash() {
            var val = parseFloat(document.getElementById('startingCashInput').value) || 0;
            fetch('/Pos/SaveStartingCash', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'startingCash=' + val
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    var el = document.getElementById('startCashModal');
                    if (el) el.remove();
                    showPosToast('Đã lưu tiền đầu ca thành công!', 'success');
                } else {
                    showPosToast(data.message, 'error');
                }
            });
        }

        // End Shift Close
        function submitCloseShift() {
            var cash = parseFloat(document.getElementById('actualCashInput').value);
            if (isNaN(cash) || cash < 0) {
                showPosToast('Vui lòng nhập số tiền thực tế trong két!', 'warning');
                return;
            }

            fetch('/Pos/CloseShift', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'actualCash=' + cash
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.success) {
                    window.location.href = '/Pos/EndShiftReport';
                } else {
                    showPosToast(data.message, 'error');
                }
            })
            .catch(function() {
                showPosToast('Lỗi kết nối máy chủ!', 'error');
            });
        }

        // Open Shift History Modal
        function openShiftHistoryModal() {
            var modal = new bootstrap.Modal(document.getElementById('shiftHistoryModal'));
            modal.show();

            fetch('/Pos/GetOrderHistory')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    var tbody = document.getElementById('shiftOrdersTbody');
                    if (data.success && data.orders && data.orders.length > 0) {
                        var html = '';
                        data.orders.forEach(function(o) {
                            var itemsStr = o.items.map(function(i) { return i.qty + 'x ' + i.name; }).join(', ');
                            html += '\
                                <tr>\
                                    <td><code class="text-dark fw-bold">' + o.orderCode + '</code></td>\
                                    <td class="tabular-nums small text-muted">' + new Date(o.date).toLocaleTimeString('vi-VN') + '</td>\
                                    <td class="small text-truncate" style="max-width: 250px;" title="' + itemsStr + '">' + itemsStr + '</td>\
                                    <td><span class="status-badge badge-neutral">' + o.payment + '</span></td>\
                                    <td class="text-end fw-bold text-dark tabular-nums">' + formatVND(o.total) + '</td>\
                                </tr>';
                        });
                        tbody.innerHTML = html;
                    } else {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Chưa có đơn hàng nào trong ca này.</td></tr>';
                    }
                });
        }
    </script>
</body>
</html>
