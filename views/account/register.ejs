<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Ký Tài Khoản Khách Hàng | FastFood Express</title>
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
        :root {
            --font-sans: 'Be Vietnam Pro', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            --primary: #E11D48;
            --primary-hover: #BE123C;
        }

        body {
            font-family: var(--font-sans);
            background-color: #0F172A;
            background-image: 
                radial-gradient(at 0% 0%, rgba(225, 29, 72, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(234, 88, 12, 0.12) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            margin: 0;
        }

        .register-card {
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 480px;
            padding: 36px 32px;
            position: relative;
        }

        .brand-badge-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, #E11D48 0%, #EA580C 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin: 0 auto 16px auto;
            box-shadow: 0 8px 16px rgba(225, 29, 72, 0.25);
        }

        .form-control-custom {
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.92rem;
            font-weight: 500;
            color: #0F172A;
            transition: all 0.15s ease;
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.12);
            outline: none;
        }

        .btn-submit-register {
            background: var(--primary);
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 700;
            font-size: 0.95rem;
            width: 100%;
            transition: all 0.2s ease;
        }

        .btn-submit-register:hover {
            background: var(--primary-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.25);
        }
    </style>
</head>
<body>

    <div class="register-card">
        <div class="text-center mb-4">
            <div class="brand-badge-icon">
                <i class="fas fa-user-plus"></i>
            </div>
            <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.02em;">Đăng Ký Tài Khoản Khách Hàng</h4>
            <p class="text-muted small mb-0">Tạo tài khoản để nhận điểm thưởng & ưu đãi đặt món</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-circle-exclamation"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <form method="post" action="/Account/Register" id="registerForm">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Họ và tên <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="far fa-user"></i></span>
                    <input type="text" class="form-control form-control-custom border-start-0 ps-0" name="fullName" placeholder="Ví dụ: Nguyễn Văn An" value="<%= typeof fullName !== 'undefined' ? fullName : '' %>" required autocomplete="name">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Số điện thoại <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-phone"></i></span>
                    <input type="tel" class="form-control form-control-custom border-start-0 ps-0" name="phone" placeholder="09xxxxxxxx (dùng tích điểm)" value="<%= typeof phone !== 'undefined' ? phone : '' %>" required pattern="[0-9]{9,11}" title="Vui lòng nhập số điện thoại từ 9 đến 11 chữ số">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Email / Gmail <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                    <input type="email" class="form-control form-control-custom border-start-0 ps-0" name="email" placeholder="example@gmail.com (nhận OTP & ưu đãi)" value="<%= typeof email !== 'undefined' ? email : '' %>" required autocomplete="email">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Tên đăng nhập <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-at"></i></span>
                    <input type="text" class="form-control form-control-custom border-start-0 ps-0" name="username" placeholder="Nhập tên tài khoản (viết liền không dấu)" value="<%= typeof username !== 'undefined' ? username : '' %>" required autocomplete="username">
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Mật khẩu <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                    <input type="password" class="form-control form-control-custom border-start-0 ps-0" id="txtPassword" name="password" placeholder="Nhập mật khẩu" required autocomplete="new-password">
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-muted text-uppercase">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-shield-halved"></i></span>
                    <input type="password" class="form-control form-control-custom border-start-0 ps-0" id="txtConfirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu" required autocomplete="new-password">
                </div>
            </div>

            <button type="submit" class="btn-submit-register" id="btnSubmit">
                <span>Đăng Ký & Vào Đặt Món</span> <i class="fas fa-arrow-right ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <span class="small text-muted">Đã có tài khoản?</span>
            <a href="/Account/Login" class="small text-decoration-none fw-bold text-danger ms-1">
                Đăng nhập ngay
            </a>
        </div>
        
        <div class="text-center mt-2">
            <a href="/Shop" class="small text-decoration-none text-muted">
                <i class="fas fa-arrow-left me-1"></i> Quay lại thực đơn FastFood Express
            </a>
        </div>
    </div>

    <script>
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            var p1 = document.getElementById('txtPassword').value;
            var p2 = document.getElementById('txtConfirmPassword').value;
            if (p1 !== p2) {
                e.preventDefault();
                alert('Mật khẩu và xác nhận mật khẩu không khớp nhau!');
                return false;
            }
            var btn = document.getElementById('btnSubmit');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang tạo tài khoản...';
            btn.style.opacity = '0.8';
            btn.style.pointerEvents = 'none';
        });
    </script>
</body>
</html>
