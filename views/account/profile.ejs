<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thông Tin Cá Nhân & Tài Khoản | FastFood Express</title>
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
        :root {
            --font-sans: 'Be Vietnam Pro', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            --primary: #E11D48;
            --primary-hover: #BE123C;
        }

        body {
            font-family: var(--font-sans);
            background-color: #F8FAFC;
            color: #1E293B;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .profile-nav {
            background: #FFFFFF;
            border-bottom: 1px solid #E2E8F0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .profile-card {
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.08);
            border: 1px solid #E2E8F0;
        }

        .form-control-custom {
            border: 1px solid #CBD5E1;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.92rem;
            font-weight: 500;
            color: #0F172A;
            transition: all 0.15s ease;
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.12);
            outline: none;
        }

        .btn-brand-primary {
            background: var(--primary);
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 12px 24px;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .btn-brand-primary:hover {
            background: var(--primary-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.25);
        }
    </style>
</head>
<body>

    <!-- TOPBAR -->
    <header class="profile-nav py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/Shop" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-5">
                <span class="badge bg-danger p-2 rounded-3"><i class="fas fa-hamburger fs-5"></i></span>
                <span>FastFood Express</span>
            </a>

            <div class="d-flex align-items-center gap-2">
                <a href="/Shop" class="btn btn-outline-secondary btn-sm fw-semibold">
                    <i class="fas fa-utensils me-1"></i> Quay lại Thực Đơn
                </a>
                <a href="/Account/Logout" class="btn btn-outline-danger btn-sm fw-semibold">
                    <i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
                </a>
            </div>
        </div>
    </header>

    <div class="container py-4" style="max-width: 860px;">
        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/Shop" class="text-decoration-none text-muted">Trang Chủ</a></li>
                <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Hồ Sơ Cá Nhân</li>
            </ol>
        </nav>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-circle-exclamation fs-5"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-check-circle fs-5"></i>
                <div><%= success %></div>
            </div>
        <% } %>

        <div class="row g-4">
            <!-- CỘT 1: THẺ THÔNG TIN TỔNG QUAN & HẠNG THÀNH VIÊN -->
            <div class="col-lg-4 col-md-5">
                <div class="profile-card p-4 text-center mb-3">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger text-white shadow-sm" style="width: 72px; height: 72px; font-size: 2rem;">
                        <i class="fas fa-user"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark"><%= user.FullName %></h5>
                    <div class="small text-muted font-monospace mb-2">@<%= user.Username %></div>
                    
                    <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill fs-6 mb-3 shadow-sm">
                        <i class="fas fa-crown text-danger me-1"></i> Hạng <%= tier %>
                    </span>

                    <div class="p-3 rounded-3 bg-light border text-start">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">Điểm tích lũy:</span>
                            <span class="fw-bold text-danger fs-5"><%= points %> đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-muted">
                            <span>Quy đổi giảm giá:</span>
                            <span class="fw-bold text-success"><%= (points * 1000).toLocaleString('vi-VN') %> đ</span>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-3 bg-white border small text-muted" style="line-height: 1.6;">
                    <div class="fw-bold text-dark mb-2"><i class="fas fa-shield-alt text-primary me-1"></i> Quyền Lợi Thành Viên:</div>
                    <ul class="mb-0 ps-3">
                        <li>Mỗi <b>10.000 đ</b> mua hàng &rarr; Tích <b>1 điểm</b></li>
                        <li><b>1 điểm</b> = <b>1.000 đ</b> giảm giá hóa đơn</li>
                        <li>Được ưu tiên giao hàng nhanh và nhận ưu đãi sinh nhật</li>
                    </ul>
                </div>
            </div>

            <!-- CỘT 2: FORM CHỈNH SỬA THÔNG TIN CÁ NHÂN & MẬT KHẨU -->
            <div class="col-lg-8 col-md-7">
                <div class="profile-card p-4">
                    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                        <i class="fas fa-user-pen text-danger me-2"></i>Chỉnh Sửa Thông Tin Cá Nhân
                    </h5>

                    <form method="post" action="/Account/Profile">
                        <!-- THÔNG TIN CƠ BẢN -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-custom" name="fullName" value="<%= user.FullName %>" required autocomplete="name" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label small fw-bold text-dark text-uppercase mb-1">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control form-control-custom" name="phone" value="<%= user.PhoneNumber || '' %>" required pattern="[0-9]{9,11}" />
                                <small class="text-muted" style="font-size: 0.72rem;">Dùng để nhận hàng và tích lũy điểm</small>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-bold text-dark text-uppercase mb-1">Email / Gmail <span class="text-danger">*</span></label>
                                <input type="email" class="form-control form-control-custom" name="email" value="<%= user.Email || '' %>" required autocomplete="email" />
                                <small class="text-muted" style="font-size: 0.72rem;">Dùng để khôi phục mật khẩu & nhận OTP</small>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Tên đăng nhập (Cố định)</label>
                            <input type="text" class="form-control form-control-custom bg-light text-muted" value="<%= user.Username %>" disabled readonly />
                        </div>

                        <!-- KHỐI ĐỔI MẬT KHẨU (TÙY CHỌN) -->
                        <div class="p-3 mb-4 rounded-3 border bg-light">
                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <span class="fw-bold text-dark small"><i class="fas fa-lock text-warning me-1"></i> Đổi Mật Khẩu (Nếu muốn thay đổi)</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Để trống nếu không đổi mật khẩu</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Mật khẩu hiện tại</label>
                                <input type="password" class="form-control form-control-custom bg-white" name="currentPassword" placeholder="Nhập mật khẩu cũ nếu đổi mật khẩu" autocomplete="current-password" />
                            </div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Mật khẩu mới</label>
                                    <input type="password" class="form-control form-control-custom bg-white" name="newPassword" placeholder="Tối thiểu 3 ký tự" autocomplete="new-password" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Xác nhận mật khẩu mới</label>
                                    <input type="password" class="form-control form-control-custom bg-white" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a href="/Shop" class="btn btn-outline-secondary fw-semibold">
                                <i class="fas fa-times me-1"></i> Hủy Bỏ
                            </a>
                            <button type="submit" class="btn btn-brand-primary">
                                <i class="fas fa-floppy-disk me-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
