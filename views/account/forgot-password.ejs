<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên Mật Khẩu & Xác Thực OTP | FastFood Express</title>
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
        :root {
            --font-sans: 'Be Vietnam Pro', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            --primary: #E11D48;
            --primary-hover: #BE123C;
        }

        body {
            font-family: var(--font-sans);
            background-color: #0F172A;
            background-image: 
                radial-gradient(at 0% 0%, rgba(225, 29, 72, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(234, 88, 12, 0.12) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            margin: 0;
        }

        .auth-card {
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 460px;
            padding: 36px 32px;
            position: relative;
        }

        .brand-badge-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, #E11D48 0%, #EA580C 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin: 0 auto 16px auto;
            box-shadow: 0 8px 16px rgba(225, 29, 72, 0.25);
        }

        .form-control-custom {
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.92rem;
            font-weight: 500;
            color: #0F172A;
            transition: all 0.15s ease;
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.12);
            outline: none;
        }

        .btn-submit-action {
            background: var(--primary);
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 700;
            font-size: 0.95rem;
            width: 100%;
            transition: all 0.2s ease;
        }

        .btn-submit-action:hover {
            background: var(--primary-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.25);
        }

        .otp-display-banner {
            background: #FFFBEB;
            border: 1px dashed #F59E0B;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="brand-badge-icon">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.02em;">Khôi Phục Mật Khẩu</h4>
            <p class="text-muted small mb-0">Xác thực mã OTP gửi về Email hoặc Số điện thoại</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-circle-exclamation"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <div><%= success %></div>
            </div>
        <% } %>

        <% if (typeof step !== 'undefined' && step === 2) { %>
            <!-- BƯỚC 2: NHẬP MÃ OTP VÀ ĐẶT LẠI MẬT KHẨU MỚI -->
            <% if (typeof generatedOtp !== 'undefined' && generatedOtp) { %>
                <div class="otp-display-banner">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-dark"><i class="fas fa-key text-warning me-1"></i> Mã OTP Xác Thực:</span>
                        <span class="badge bg-warning text-dark fw-bold px-2 py-1 fs-6 font-monospace"><%= generatedOtp %></span>
                    </div>
                    <small class="text-muted" style="font-size: 0.75rem;">Mã OTP đã được gửi đến tài khoản. Vui lòng nhập mã này vào ô bên dưới.</small>
                </div>
            <% } %>

            <form method="post" action="/Account/ResetPassword">
                <input type="hidden" name="target" value="<%= typeof target !== 'undefined' ? target : '' %>" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Mã OTP (6 chữ số) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-shield-alt"></i></span>
                        <input type="text" class="form-control form-control-custom border-start-0 ps-0 text-center fw-bold fs-5 font-monospace text-danger" name="otp" placeholder="123456" maxlength="6" required autocomplete="one-time-code" autofocus>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Mật khẩu mới <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control form-control-custom border-start-0 ps-0" name="newPassword" placeholder="Nhập mật khẩu mới" required autocomplete="new-password">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-lock-open"></i></span>
                        <input type="password" class="form-control form-control-custom border-start-0 ps-0" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" required autocomplete="new-password">
                    </div>
                </div>

                <button type="submit" class="btn-submit-action mb-3">
                    <i class="fas fa-circle-check me-1"></i> Xác Nhận Đổi Mật Khẩu
                </button>
            </form>

            <form method="post" action="/Account/ForgotPassword" class="text-center mb-2">
                <input type="hidden" name="accountQuery" value="<%= typeof target !== 'undefined' ? target : '' %>" />
                <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none">
                    <i class="fas fa-rotate-right me-1"></i> Chưa nhận được mã? Gửi lại OTP
                </button>
            </form>

        <% } else { %>
            <!-- BƯỚC 1: NHẬP EMAIL HOẶC SỐ ĐIỆN THOẠI ĐỂ NHẬN OTP -->
            <form method="post" action="/Account/ForgotPassword">
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Email / Gmail Hoặc Số Điện Thoại <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-user-check"></i></span>
                        <input type="text" class="form-control form-control-custom border-start-0 ps-0" name="accountQuery" placeholder="Nhập email hoặc SĐT đã đăng ký..." value="<%= typeof target !== 'undefined' ? target : '' %>" required autocomplete="off" autofocus>
                    </div>
                    <small class="text-muted mt-1 d-block" style="font-size: 0.78rem;">Ví dụ: <code>khachhang@gmail.com</code> hoặc <code>0987654321</code></small>
                </div>

                <button type="submit" class="btn-submit-action mb-3">
                    <i class="fas fa-paper-plane me-1"></i> Gửi Mã Xác Thực OTP
                </button>
            </form>
        <% } %>

        <div class="text-center pt-3 border-top">
            <a href="/Account/Login" class="small text-decoration-none text-muted fw-semibold">
                <i class="fas fa-arrow-left me-1"></i> Quay lại Đăng nhập
            </a>
            <span class="mx-2 text-muted">|</span>
            <a href="/Account/Register" class="small text-decoration-none text-danger fw-semibold">
                Đăng ký mới
            </a>
        </div>
    </div>

</body>
</html>
