<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập Hệ Thống | FastFood Management</title>
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
        :root {
            --font-sans: 'Be Vietnam Pro', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            --primary: #E11D48;
            --primary-hover: #BE123C;
        }

        body {
            font-family: var(--font-sans);
            background-color: #0F172A;
            background-image: 
                radial-gradient(at 0% 0%, rgba(225, 29, 72, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(234, 88, 12, 0.12) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            margin: 0;
        }

        .login-card {
            background: #FFFFFF;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
            width: 100%;
            max-width: 440px;
            padding: 36px 32px;
            position: relative;
        }

        .brand-badge-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: linear-gradient(135deg, #E11D48 0%, #EA580C 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin: 0 auto 16px auto;
            box-shadow: 0 8px 16px rgba(225, 29, 72, 0.25);
        }

        .form-control-custom {
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.92rem;
            font-weight: 500;
            color: #0F172A;
            transition: all 0.15s ease;
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.12);
            outline: none;
        }

        .btn-submit-login {
            background: #0F172A;
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: 700;
            font-size: 0.95rem;
            width: 100%;
            transition: all 0.2s ease;
        }

        .btn-submit-login:hover {
            background: #1E293B;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .demo-panel {
            background: #F8FAFC;
            border: 1px dashed #CBD5E1;
            border-radius: 10px;
            padding: 14px;
            margin-top: 24px;
        }

        .quick-fill-btn {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 0.78rem;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: left;
        }

        .quick-fill-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: #FFF1F2;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-badge-icon">
                <i class="fas fa-hamburger"></i>
            </div>
            <h4 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.02em;">Đăng Nhập Hệ Thống</h4>
            <p class="text-muted small mb-0">Hệ thống Quản lý Bán hàng & Vận hành FastFood</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-circle-exclamation"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <div><%= successMessage %></div>
            </div>
        <% } %>

        <form method="post" action="/Account/Login" id="loginForm">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Tên đăng nhập</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="far fa-user"></i></span>
                    <input type="text" class="form-control form-control-custom border-start-0 ps-0" id="txtUsername" name="username" placeholder="Nhập tài khoản" value="<%= typeof username !== 'undefined' ? username : '' %>" required autocomplete="off">
                </div>
            </div>
            
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small fw-semibold text-muted text-uppercase mb-0">Mật khẩu</label>
                    <a href="/Account/ForgotPassword" class="small text-decoration-none text-muted" style="font-size: 0.8rem;">
                        Quên mật khẩu?
                    </a>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                    <input type="password" class="form-control form-control-custom border-start-0 ps-0" id="txtPassword" name="password" placeholder="Nhập mật khẩu" required autocomplete="off">
                </div>
            </div>

            <button type="submit" class="btn-submit-login" id="btnSubmit">
                <span>Vào Hệ Thống</span> <i class="fas fa-arrow-right ms-1"></i>
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <span class="small text-muted">Bạn là khách hàng mới?</span>
            <a href="/Account/Register" class="small text-decoration-none fw-bold text-danger ms-1">
                <i class="fas fa-user-plus me-1"></i>Đăng ký tài khoản ngay
            </a>
        </div>

        <!-- TÀI KHOẢN MẪU DÀNH CHO BẢO VỆ ĐỒ ÁN / KIỂM THỬ -->
        <div class="demo-panel">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="small fw-bold text-dark"><i class="fas fa-key text-warning me-1"></i> Tài khoản demo:</span>
                <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">Click để điền nhanh</span>
            </div>
            <div class="d-grid gap-2">
                <button type="button" class="quick-fill-btn d-flex justify-content-between align-items-center" onclick="fillAccount('admin', '123')">
                    <span>👑 Quản Trị Viên (ADMIN)</span>
                    <code>admin / 123</code>
                </button>
                <button type="button" class="quick-fill-btn d-flex justify-content-between align-items-center" onclick="fillAccount('thungan', '123')">
                    <span>🛒 Thu Ngân Quầy Bán (THU NGÂN)</span>
                    <code>thungan / 123</code>
                </button>
                <button type="button" class="quick-fill-btn d-flex justify-content-between align-items-center" onclick="fillAccount('khachhang', '123')">
                    <span>🍔 Khách Hàng Đặt Món (KHÁCH HÀNG)</span>
                    <code>khachhang / 123</code>
                </button>
            </div>
        </div>

        <div class="text-center mt-3 pt-2">
            <a href="/Shop" class="small text-decoration-none text-muted fw-semibold">
                <i class="fas fa-store me-1"></i> Xem giao diện khách hàng đặt món
            </a>
        </div>
    </div>

    <script>
        function fillAccount(u, p) {
            document.getElementById('txtUsername').value = u;
            document.getElementById('txtPassword').value = p;
        }

        document.getElementById('loginForm').addEventListener('submit', function() {
            var btn = document.getElementById('btnSubmit');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang xác thực...';
            btn.style.opacity = '0.8';
            btn.style.pointerEvents = 'none';
        });
    </script>
</body>
</html>
