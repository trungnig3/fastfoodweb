<div class="mx-auto" style="max-width: 680px;">
    <div class="d-flex align-items-center gap-2 mb-3">
        <a href="/Admin/Products" class="btn-brand-secondary py-1 px-2" style="font-size: 0.8rem;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h4 class="fw-bold mb-0" style="color: var(--text-heading); letter-spacing: -0.02em;">
            Chỉnh Sửa Món Ăn #<%= product.ProductId %>
        </h4>
    </div>

    <div class="dash-card p-4">
        <form method="post" action="/Admin/EditProduct/<%= product.ProductId %>">
            <input type="hidden" name="ProductId" value="<%= product.ProductId %>" />

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Tên món ăn / Combo <span class="text-danger">*</span></label>
                <input type="text" name="ProductName" class="form-control form-control-custom w-100" required value="<%= product.ProductName %>" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Giá bán (VND) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="number" name="Price" class="form-control form-control-custom" required min="0" step="1000" value="<%= product.Price %>" />
                        <span class="input-group-text bg-light text-muted border-start-0">đ</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-muted text-uppercase">Số lượng tồn kho <span class="text-danger">*</span></label>
                    <input type="number" name="StockQuantity" class="form-control form-control-custom w-100" required min="0" value="<%= product.StockQuantity %>" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted text-uppercase">Danh mục phân loại <span class="text-danger">*</span></label>
                <select name="CategoryId" class="form-select form-select-custom w-100" required>
                    <% categories.forEach(function(c) { %>
                        <option value="<%= c.CategoryId %>" <%= product.CategoryId === c.CategoryId ? 'selected' : '' %>><%= c.CategoryName %></option>
                    <% }); %>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-muted text-uppercase">Đường dẫn hình ảnh (URL)</label>
                <input type="url" name="ImageURL" id="imgInput" class="form-control form-control-custom w-100" value="<%= product.ImageURL %>" oninput="previewImage(this.value)" />
                <div class="mt-2 text-center" id="imgPreviewWrapper">
                    <img id="imgPreview" src="<%= product.ImageURL || 'https://placehold.co/140x140?text=No+Image' %>" alt="<%= product.ProductName %>" style="max-height: 140px; border-radius: 8px; border: 1px solid var(--border-subtle); object-fit: cover;" />
                </div>
            </div>

            <div class="p-3 mb-4 rounded-3" style="background: #F8FAFC; border: 1px solid var(--border-subtle);">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="IsCombo" value="true" id="isComboCheck" <%= product.IsCombo ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold text-dark small" for="isComboCheck">
                                Đây là phần ăn Combo
                            </label>
                        </div>
                        <small class="text-muted d-block ps-4">Gói kết hợp nhiều món với mức giá ưu đãi</small>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="isActiveCheck" <%= product.IsActive ? 'checked' : '' %>>
                            <label class="form-check-label fw-semibold text-dark small" for="isActiveCheck">
                                Kích hoạt kinh doanh
                            </label>
                        </div>
                        <small class="text-muted d-block ps-4">Cho phép hiển thị trên màn hình POS và trang đặt món</small>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <a href="/Admin/Products" class="btn-brand-secondary">Hủy bỏ</a>
                <button type="submit" class="btn-brand-primary">
                    <i class="fas fa-check"></i> Cập Nhật Món Ăn
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function previewImage(url) {
    const img = document.getElementById('imgPreview');
    if (url && url.startsWith('http')) {
        img.src = url;
    }
}
</script>
