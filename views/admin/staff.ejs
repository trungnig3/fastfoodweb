<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-heading); letter-spacing: -0.02em;">Quản Lý Nhân Sự & Tài Khoản</h4>
        <p class="text-muted small mb-0">Danh sách nhân viên thu ngân và quản trị viên vận hành hệ thống</p>
    </div>
    <a href="/Admin/CreateStaff" class="btn-brand-primary">
        <i class="fas fa-user-plus"></i> Thêm Nhân Viên Mới
    </a>
</div>

<div class="dash-table-wrap">
    <div class="table-responsive">
        <table class="dash-table">
            <thead>
                <tr>
                    <th style="width: 70px;">Mã</th>
                    <th>Họ Và Tên</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Lương Cơ Bản / Giờ</th>
                    <th>Vai Trò (Role)</th>
                    <th>Trạng Thái</th>
                    <th class="text-end" style="width: 140px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(function(item) { %>
                    <tr>
                        <td class="tabular-nums font-monospace text-muted small">#<%= item.UserId %></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    <%= (item.FullName || item.Username).charAt(0).toUpperCase() %>
                                </div>
                                <span class="fw-semibold text-dark"><%= item.FullName %></span>
                            </div>
                        </td>
                        <td>
                            <code class="text-dark"><%= item.Username %></code>
                        </td>
                        <td class="tabular-nums text-muted">
                            <%= Number(item.HourlyRate).toLocaleString('vi-VN') %> đ/h
                        </td>
                        <td>
                            <% if (item.Role && item.Role.RoleName === 'Admin') { %>
                                <span class="status-badge badge-danger"><i class="fas fa-shield"></i> Quản trị viên</span>
                            <% } else { %>
                                <span class="status-badge badge-info"><i class="fas fa-cash-register"></i> Thu ngân</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (item.IsActive) { %>
                                <span class="status-badge badge-success"><i class="fas fa-circle-check"></i> Hoạt động</span>
                            <% } else { %>
                                <span class="status-badge badge-neutral"><i class="fas fa-lock"></i> Đã khóa</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a href="/Admin/EditStaff/<%= item.UserId %>" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.78rem; border-radius: 6px;" title="Chỉnh sửa">
                                    <i class="fas fa-pen-to-square"></i> Sửa
                                </a>
                                <% if (item.Username !== 'admin' && item.Username !== 'admin2') { %>
                                    <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.78rem; border-radius: 6px;" onclick="deleteStaff(<%= item.UserId %>, '<%= item.FullName %>')" title="Xóa nhân viên">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<script>
function deleteStaff(id, name) {
    showConfirmDialog('Xóa Nhân Viên', 'Bạn có chắc chắn muốn xóa nhân viên ' + name + ' khỏi hệ thống không?', function() {
        fetch('/Admin/DeleteUser', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast('Đã xóa nhân viên ' + name + ' thành công!', 'success');
                setTimeout(() => location.reload(), 600);
            } else {
                showToast('Không thể xóa tài khoản này: ' + (data.message || 'Lỗi hệ thống'), 'error');
            }
        })
        .catch(() => showToast('Lỗi kết nối máy chủ!', 'error'));
    });
}
</script>
