<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-heading); letter-spacing: -0.02em;">Tổng Hợp & Quản Lý Đánh Giá Khách Hàng</h4>
        <p class="text-muted small mb-0">Thống kê mức độ hài lòng 1 - 5 sao, phân tích trải nghiệm và phản hồi ý kiến khách hàng</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="fas fa-print me-1"></i> In Báo Cáo
        </button>
        <a href="/Shop" target="_blank" class="btn btn-sm btn-outline-danger fw-semibold">
            <i class="fas fa-arrow-up-right-from-square me-1"></i> Xem Trang Khách Hàng
        </a>
    </div>
</div>

<!-- KHỐI 1: TỔNG HỢP CHỈ SỐ ĐÁNH GIÁ (SCORECARD & BIỂU ĐỒ SAO) -->
<div class="row g-3 mb-4">
    <!-- CỘT 1: ĐIỂM TRUNG BÌNH TỔNG QUAN -->
    <div class="col-lg-4 col-md-5">
        <div class="dash-card h-100 text-center d-flex flex-column justify-content-center p-4">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Điểm Đánh Giá Trung Bình</span>
            <div class="display-4 fw-bold tabular-nums text-warning my-1">
                <%= stats.avgFormatted %> <span class="fs-4 text-muted fw-normal">/ 5.0</span>
            </div>
            <div class="text-warning mb-2 fs-5">
                <% const fullStars = Math.round(stats.avgRating); %>
                <% for(let s=1; s<=5; s++) { %>
                    <i class="fas fa-star <%= s <= fullStars ? 'text-warning' : 'text-secondary opacity-25' %>"></i>
                <% } %>
            </div>
            <div class="small text-muted">Dựa trên <b><%= stats.total %></b> lượt đánh giá thực tế từ khách hàng</div>
            <div class="mt-3 pt-3 border-top d-flex justify-content-around text-center">
                <div>
                    <div class="fw-bold text-success fs-5 tabular-nums"><%= stats.positivePercent %>%</div>
                    <small class="text-muted" style="font-size: 0.72rem;">Hài lòng (4-5⭐)</small>
                </div>
                <div class="vr"></div>
                <div>
                    <div class="fw-bold text-dark fs-5 tabular-nums"><%= (stats.starCounts[5] || 0) %></div>
                    <small class="text-muted" style="font-size: 0.72rem;">5 Sao Tuyệt Vời</small>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT 2: BIỂU ĐỒ PHÂN BỔ SỐ SAO (5⭐ -> 1⭐) -->
    <div class="col-lg-8 col-md-7">
        <div class="dash-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-chart-simple text-danger me-2"></i>Phân Bổ Đánh Giá Theo Số Sao</h6>
                <span class="badge bg-light text-dark border small">Tổng: <%= stats.total %> lượt</span>
            </div>

            <div class="star-breakdown-list">
                <!-- 5 SAO -->
                <div class="d-flex align-items-center gap-3 mb-2">
                    <a href="/Admin/Reviews?star=5" class="text-decoration-none text-dark fw-bold small text-nowrap" style="width: 80px;">
                        5 <i class="fas fa-star text-warning"></i>
                        <span class="text-muted fw-normal">(<%= stats.starCounts[5] || 0 %>)</span>
                    </a>
                    <div class="progress flex-grow-1" style="height: 10px; border-radius: 5px; background: #F1F5F9;">
                        <div class="progress-bar bg-success" style="width: <%= stats.starPercentages[5] || 0 %>%; border-radius: 5px;"></div>
                    </div>
                    <span class="small fw-semibold text-muted tabular-nums" style="width: 45px; text-align: right;"><%= stats.starPercentages[5] || 0 %>%</span>
                </div>

                <!-- 4 SAO -->
                <div class="d-flex align-items-center gap-3 mb-2">
                    <a href="/Admin/Reviews?star=4" class="text-decoration-none text-dark fw-bold small text-nowrap" style="width: 80px;">
                        4 <i class="fas fa-star text-warning"></i>
                        <span class="text-muted fw-normal">(<%= stats.starCounts[4] || 0 %>)</span>
                    </a>
                    <div class="progress flex-grow-1" style="height: 10px; border-radius: 5px; background: #F1F5F9;">
                        <div class="progress-bar bg-primary" style="width: <%= stats.starPercentages[4] || 0 %>%; border-radius: 5px;"></div>
                    </div>
                    <span class="small fw-semibold text-muted tabular-nums" style="width: 45px; text-align: right;"><%= stats.starPercentages[4] || 0 %>%</span>
                </div>

                <!-- 3 SAO -->
                <div class="d-flex align-items-center gap-3 mb-2">
                    <a href="/Admin/Reviews?star=3" class="text-decoration-none text-dark fw-bold small text-nowrap" style="width: 80px;">
                        3 <i class="fas fa-star text-warning"></i>
                        <span class="text-muted fw-normal">(<%= stats.starCounts[3] || 0 %>)</span>
                    </a>
                    <div class="progress flex-grow-1" style="height: 10px; border-radius: 5px; background: #F1F5F9;">
                        <div class="progress-bar bg-warning" style="width: <%= stats.starPercentages[3] || 0 %>%; border-radius: 5px;"></div>
                    </div>
                    <span class="small fw-semibold text-muted tabular-nums" style="width: 45px; text-align: right;"><%= stats.starPercentages[3] || 0 %>%</span>
                </div>

                <!-- 2 SAO -->
                <div class="d-flex align-items-center gap-3 mb-2">
                    <a href="/Admin/Reviews?star=2" class="text-decoration-none text-dark fw-bold small text-nowrap" style="width: 80px;">
                        2 <i class="fas fa-star text-warning"></i>
                        <span class="text-muted fw-normal">(<%= stats.starCounts[2] || 0 %>)</span>
                    </a>
                    <div class="progress flex-grow-1" style="height: 10px; border-radius: 5px; background: #F1F5F9;">
                        <div class="progress-bar" style="background: #F97316; width: <%= stats.starPercentages[2] || 0 %>%; border-radius: 5px;"></div>
                    </div>
                    <span class="small fw-semibold text-muted tabular-nums" style="width: 45px; text-align: right;"><%= stats.starPercentages[2] || 0 %>%</span>
                </div>

                <!-- 1 SAO -->
                <div class="d-flex align-items-center gap-3 mb-0">
                    <a href="/Admin/Reviews?star=1" class="text-decoration-none text-dark fw-bold small text-nowrap" style="width: 80px;">
                        1 <i class="fas fa-star text-danger"></i>
                        <span class="text-muted fw-normal">(<%= stats.starCounts[1] || 0 %>)</span>
                    </a>
                    <div class="progress flex-grow-1" style="height: 10px; border-radius: 5px; background: #F1F5F9;">
                        <div class="progress-bar bg-danger" style="width: <%= stats.starPercentages[1] || 0 %>%; border-radius: 5px;"></div>
                    </div>
                    <span class="small fw-semibold text-muted tabular-nums" style="width: 45px; text-align: right;"><%= stats.starPercentages[1] || 0 %>%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KHỐI 2: THANH BỘ LỌC ĐÁNH GIÁ (SAO, DANH MỤC, TÌM KIẾM) -->
<div class="dash-card p-3 mb-4">
    <form method="GET" action="/Admin/Reviews" class="row g-2 align-items-center">
        <!-- LỌC THEO SỐ SAO -->
        <div class="col-lg-4 col-md-6">
            <div class="d-flex flex-wrap gap-1">
                <a href="/Admin/Reviews" class="btn btn-sm <%= !selectedStar ? 'btn-dark' : 'btn-outline-secondary' %>">
                    Tất cả (<%= stats.total %>)
                </a>
                <a href="/Admin/Reviews?star=5" class="btn btn-sm <%= selectedStar === 5 ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary' %>">
                    5 ⭐ (<%= stats.starCounts[5] || 0 %>)
                </a>
                <a href="/Admin/Reviews?star=4" class="btn btn-sm <%= selectedStar === 4 ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary' %>">
                    4 ⭐ (<%= stats.starCounts[4] || 0 %>)
                </a>
                <a href="/Admin/Reviews?star=3" class="btn btn-sm <%= selectedStar === 3 ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary' %>">
                    3 ⭐ (<%= stats.starCounts[3] || 0 %>)
                </a>
                <a href="/Admin/Reviews?star=1" class="btn btn-sm <%= selectedStar === 1 ? 'btn-danger text-white fw-bold' : 'btn-outline-secondary' %>">
                    1 ⭐ (<%= stats.starCounts[1] || 0 %>)
                </a>
            </div>
        </div>

        <!-- LỌC THEO DANH MỤC GÓP Ý -->
        <div class="col-lg-3 col-md-6">
            <select name="category" class="form-select form-select-custom py-1" style="font-size: 0.85rem;" onchange="this.form.submit()">
                <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>-- Tất Cả Chủ Đề --</option>
                <option value="Chất lượng món ăn" <%= selectedCategory === 'Chất lượng món ăn' ? 'selected' : '' %>>🍔 Chất lượng món ăn</option>
                <option value="Tốc độ giao hàng" <%= selectedCategory === 'Tốc độ giao hàng' ? 'selected' : '' %>>🛵 Tốc độ giao hàng</option>
                <option value="Thái độ phục vụ" <%= selectedCategory === 'Thái độ phục vụ' ? 'selected' : '' %>>👨‍🍳 Thái độ phục vụ</option>
                <option value="Giá cả & Khuyến mãi" <%= selectedCategory === 'Giá cả & Khuyến mãi' ? 'selected' : '' %>>🏷️ Giá cả & Khuyến mãi</option>
                <option value="Góp ý khác" <%= selectedCategory === 'Góp ý khác' ? 'selected' : '' %>>💬 Góp ý khác</option>
            </select>
        </div>

        <!-- TÌM KIẾM THEO TỪ KHÓA -->
        <div class="col-lg-5 col-md-12">
            <div class="input-group">
                <input type="text" name="search" class="form-control form-control-custom" placeholder="Tìm kiếm theo tên khách, SĐT, nội dung..." value="<%= searchKey %>" />
                <button type="submit" class="btn btn-dark px-3 fw-semibold">
                    <i class="fas fa-search me-1"></i> Lọc
                </button>
                <% if (searchKey || selectedStar || (selectedCategory && selectedCategory !== 'all')) { %>
                    <a href="/Admin/Reviews" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                <% } %>
            </div>
        </div>
    </form>
</div>

<!-- KHỐI 3: DANH SÁCH CÁC ĐÁNH GIÁ & GÓP Ý -->
<div class="dash-table-wrap">
    <div class="table-responsive">
        <table class="dash-table">
            <thead>
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th style="width: 170px;">Khách Hàng</th>
                    <th style="width: 140px;">Mức Đánh Giá</th>
                    <th style="width: 160px;">Chủ Đề</th>
                    <th>Nội Dung Nhận Xét & Phản Hồi</th>
                    <th style="width: 140px;">Thời Gian</th>
                    <th class="text-end" style="width: 140px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                <% if (reviews && reviews.length > 0) { %>
                    <% reviews.forEach(function(item) { %>
                        <tr>
                            <td class="font-monospace small text-muted">#<%= item.ReviewId %></td>
                            <td>
                                <div class="fw-bold text-dark small"><%= item.CustomerName %></div>
                                <% if (item.Phone) { %>
                                    <small class="text-muted font-monospace"><i class="fas fa-phone me-1" style="font-size: 0.7rem;"></i><%= item.Phone %></small>
                                <% } else { %>
                                    <small class="text-muted">Khách vãng lai</small>
                                <% } %>
                            </td>
                            <td>
                                <div class="text-warning text-nowrap" title="<%= item.Rating %>/5 sao">
                                    <% for(let i=1; i<=5; i++) { %>
                                        <i class="fas fa-star <%= i <= item.Rating ? 'text-warning' : 'text-secondary opacity-25' %>" style="font-size: 0.85rem;"></i>
                                    <% } %>
                                </div>
                                <small class="fw-bold <%= item.Rating >= 4 ? 'text-success' : (item.Rating === 3 ? 'text-warning' : 'text-danger') %>">
                                    <%= item.Rating === 5 ? '5 Sao (Tuyệt vời)' : (item.Rating === 4 ? '4 Sao (Rất tốt)' : (item.Rating === 3 ? '3 Sao (Bình thường)' : (item.Rating === 2 ? '2 Sao (Chưa tốt)' : '1 Sao (Rất tệ)'))) %>
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 small">
                                    <i class="fas fa-tag me-1 text-primary"></i> <%= item.Category || 'Chung' %>
                                </span>
                            </td>
                            <td>
                                <div class="text-dark small" style="line-height: 1.5; max-width: 380px;">
                                    "<%= item.Content %>"
                                </div>
                                <% if (item.Reply) { %>
                                    <div class="mt-2 p-2 rounded-2 bg-light border-start border-3 border-success small text-muted" style="font-size: 0.78rem;">
                                        <b class="text-success"><i class="fas fa-reply me-1"></i>Phản hồi từ quán:</b> <%= item.Reply %>
                                    </div>
                                <% } %>
                            </td>
                            <td class="text-muted small tabular-nums">
                                <%= new Date(item.CreatedAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %><br>
                                <%= new Date(item.CreatedAt).toLocaleDateString('vi-VN') %>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2 me-1" style="font-size: 0.78rem;" onclick="openReplyModal(<%= item.ReviewId %>, '<%= item.CustomerName.replace(/'/g, "\\'") %>', '<%= (item.Reply || '').replace(/'/g, "\\'") %>')">
                                    <i class="fas fa-comment-dots"></i> <%= item.Reply ? 'Sửa' : 'Trả lời' %>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.78rem;" onclick="deleteReview(<%= item.ReviewId %>)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-star fa-2x mb-2 text-secondary opacity-50"></i>
                            <div>Không tìm thấy đánh giá nào phù hợp với bộ lọc hiện tại.</div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL PHẢN HỒI Ý KIẾN KHÁCH HÀNG -->
<div class="modal fade" id="replyReviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3" style="background: #1E293B; color: #fff;">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-reply text-warning fs-5"></i>
                    <h6 class="modal-title fw-bold text-white mb-0">Phản Hồi Đánh Giá Của Khách</h6>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="/Admin/ReplyReview" id="replyReviewForm">
                <input type="hidden" name="id" id="replyReviewId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Khách hàng:</label>
                        <input type="text" class="form-control form-control-custom bg-light" id="replyCustomerName" disabled readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1">Nội dung câu trả lời của quán <span class="text-danger">*</span>:</label>
                        <textarea name="reply" id="replyContentInput" class="form-control form-control-custom" rows="4" placeholder="Ví dụ: Dạ FastFood Express cảm ơn bạn rất nhiều ạ! Chúc bạn có những bữa ăn thật ngon miệng cùng quán..." required></textarea>
                        <small class="text-muted" style="font-size: 0.72rem;">Câu phản hồi sẽ được hiển thị công khai tới khách hàng trên hệ thống.</small>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-bs-dismiss="modal">Hủy Bỏ</button>
                    <button type="submit" class="btn btn-danger btn-sm fw-bold px-3">
                        <i class="fas fa-paper-plane me-1"></i> Lưu Phản Hồi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function openReplyModal(id, custName, currentReply) {
    document.getElementById('replyReviewId').value = id;
    document.getElementById('replyCustomerName').value = custName;
    document.getElementById('replyContentInput').value = currentReply || '';
    const modal = new bootstrap.Modal(document.getElementById('replyReviewModal'));
    modal.show();
}

function deleteReview(id) {
    if (!confirm('Bạn có chắc chắn muốn xóa đánh giá #' + id + ' này không?')) return;

    fetch('/Admin/DeleteReview', {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: 'id=' + encodeURIComponent(id)
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showToast('Đã xóa đánh giá thành công!', 'success');
            setTimeout(() => window.location.reload(), 600);
        } else {
            showToast('Lỗi khi xóa: ' + (data.message || 'Không thể xóa'), 'error');
        }
    })
    .catch(() => {
        showToast('Lỗi kết nối máy chủ!', 'error');
    });
}
</script>
