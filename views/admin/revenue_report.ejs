<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-heading); letter-spacing: -0.02em;">Báo Cáo Doanh Thu Theo Thời Gian</h4>
        <p class="text-muted small mb-0">Thống kê chi tiết các khoản thu từ khách hàng theo từng mốc ngày cụ thể</p>
    </div>

    <!-- BỘ LỌC NGÀY -->
    <form method="get" action="/Admin/RevenueReport" class="d-flex gap-2 align-items-center bg-white p-2 rounded-3 border">
        <span class="small fw-semibold text-muted ps-1">Từ:</span>
        <input type="date" name="startDate" value="<%= startDate || '' %>" class="form-control form-control-custom py-1 px-2" style="font-size: 0.85rem;" />
        <span class="small fw-semibold text-muted">Đến:</span>
        <input type="date" name="endDate" value="<%= endDate || '' %>" class="form-control form-control-custom py-1 px-2" style="font-size: 0.85rem;" />
        <button type="submit" class="btn-brand-primary py-1 px-3" style="font-size: 0.85rem;">
            <i class="fas fa-filter me-1"></i> Lọc
        </button>
        <% if (startDate || endDate) { %>
            <a href="/Admin/RevenueReport" class="btn-brand-secondary py-1 px-2" style="font-size: 0.85rem;" title="Đặt lại">
                <i class="fas fa-rotate-left"></i>
            </a>
        <% } %>
    </form>
</div>

<!-- TỔNG KẾT KHOẢNG THỜI GIAN -->
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Doanh thu trong kỳ lọc</span>
            <div class="fs-4 fw-bold tabular-nums text-dark">
                <%= Number(totalRevenue).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted mt-1">Từ các đơn hàng thành công trong mốc thời gian đã chọn</div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Số lượng hóa đơn</span>
            <div class="fs-4 fw-bold tabular-nums text-primary">
                <%= totalOrders %> <span class="fs-6 fw-normal text-muted">đơn hoàn tất</span>
            </div>
            <div class="small text-muted mt-1">Đã giao tận nơi và thanh toán tại quầy</div>
        </div>
    </div>
</div>

<!-- BẢNG HÓA ĐƠN TRONG KỲ -->
<div class="dash-table-wrap">
    <div class="table-responsive">
        <table class="dash-table">
            <thead>
                <tr>
                    <th style="width: 140px;">Mã Đơn</th>
                    <th>Ngày Bán</th>
                    <th>Kênh Bán</th>
                    <th>Phương Thức</th>
                    <th class="text-end">Doanh Thu</th>
                </tr>
            </thead>
            <tbody>
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(function(o) { %>
                        <tr>
                            <td>
                                <a href="/Admin/OrderDetails/<%= o.OrderId %>" class="fw-bold text-dark text-decoration-none">
                                    <code><%= o.OrderCode %></code>
                                </a>
                            </td>
                            <td class="tabular-nums small text-muted">
                                <%= new Date(o.OrderDate).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %> · <%= new Date(o.OrderDate).toLocaleDateString('vi-VN') %>
                            </td>
                            <td>
                                <span class="status-badge <%= o.ShippingAddress ? 'badge-info' : 'badge-neutral' %>">
                                    <%= o.ShippingAddress ? 'Giao Online' : 'Quầy POS' %>
                                </span>
                            </td>
                            <td>
                                <span class="small text-muted"><%= o.PaymentMethod %></span>
                            </td>
                            <td class="text-end tabular-nums fw-bold text-dark">
                                <%= Number(o.TotalAmount).toLocaleString('vi-VN') %> đ
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">Không tìm thấy đơn hàng nào trong khoảng thời gian này.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
