<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-heading); letter-spacing: -0.02em;">Báo Cáo Tổng Hợp Hoạt Động</h4>
        <p class="text-muted small mb-0">Tổng kết doanh số kinh doanh, cơ cấu sản phẩm bán chạy và kiểm soát thu ngân</p>
    </div>
</div>

<!-- 3 THẺ TỔNG QUAN -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Doanh thu ngày hôm nay</span>
            <div class="fs-4 fw-bold tabular-nums text-dark">
                <%= Number(totalRevenue).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted mt-1">Từ các đơn hàng thành công</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tổng số đơn hàng</span>
            <div class="fs-4 fw-bold tabular-nums text-primary">
                <%= totalOrders %> <span class="fs-6 fw-normal text-muted">đơn</span>
            </div>
            <div class="small text-muted mt-1">Gồm đơn tại quầy và online</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Giá trị trung bình / đơn</span>
            <div class="fs-4 fw-bold tabular-nums text-success">
                <%= Number(Math.round(avgOrderValue)).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted mt-1">Mức chi tiêu trung bình trên mỗi lượt mua</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- TOP MÓN ĂN BÁN CHẠY -->
    <div class="col-lg-5">
        <div class="dash-card h-100">
            <h6 class="fw-bold mb-1 text-dark">Top Món Ăn Bán Chạy</h6>
            <small class="text-muted d-block mb-3">Xếp hạng theo số lượng phần ăn đã bán</small>

            <div class="dash-table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Tên Món Ăn</th>
                            <th class="text-end">Đã Bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (topProducts && topProducts.length > 0) { %>
                            <% topProducts.forEach(function(item, idx) { %>
                                <tr>
                                    <td class="tabular-nums font-monospace text-muted small"><%= idx + 1 %></td>
                                    <td class="fw-semibold text-dark"><%= item.ProductName %></td>
                                    <td class="text-end tabular-nums fw-bold text-danger">
                                        <%= item.QuantitySold %> phần
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">Chưa có dữ liệu thống kê món ăn.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- KIỂM SOÁT ĐỐI SOÁT TIỀN KÉT & TRỪ LƯƠNG -->
    <div class="col-lg-7">
        <div class="dash-card h-100">
            <h6 class="fw-bold mb-1 text-dark">Kiểm Soát Đối Soát Tiền Két Ca Trực</h6>
            <small class="text-muted d-block mb-3">Đối chiếu tiền mặt lý thuyết trong két với tiền thực đếm khi đóng ca</small>

            <div class="dash-table-wrap">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Thời Gian</th>
                            <th>Thu Ngân</th>
                            <th class="text-end">Lý Thuyết</th>
                            <th class="text-end">Thực Đếm</th>
                            <th class="text-end">Chênh Lệch</th>
                            <th class="text-center">Xử Lý Lương</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (shiftReports && shiftReports.length > 0) { %>
                            <% shiftReports.forEach(function(shift) { %>
                                <tr>
                                    <td class="tabular-nums small text-muted">
                                        <%= new Date(shift.Date).toLocaleDateString('vi-VN') %> <%= new Date(shift.Date).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %>
                                    </td>
                                    <td class="fw-semibold text-dark"><%= shift.CashierName %></td>
                                    <td class="text-end tabular-nums text-muted"><%= Number(shift.ExpectedCash).toLocaleString('vi-VN') %> đ</td>
                                    <td class="text-end tabular-nums fw-bold text-dark"><%= Number(shift.ActualCash).toLocaleString('vi-VN') %> đ</td>
                                    <td class="text-end tabular-nums">
                                        <% if (shift.Difference === 0) { %>
                                            <span class="status-badge badge-success"><i class="fas fa-check"></i> Khớp</span>
                                        <% } else if (shift.Difference > 0) { %>
                                            <span class="status-badge badge-warning">+<%= Number(shift.Difference).toLocaleString('vi-VN') %> đ</span>
                                        <% } else { %>
                                            <span class="status-badge badge-danger"><%= Number(shift.Difference).toLocaleString('vi-VN') %> đ</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (shift.Difference < 0) { %>
                                            <span class="status-badge badge-danger">Trừ <%= Number(Math.abs(shift.Difference)).toLocaleString('vi-VN') %> đ</span>
                                        <% } else { %>
                                            <span class="status-badge badge-neutral">Không phạt</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Chưa có ca làm việc nào được đóng gần đây.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
