<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-heading); letter-spacing: -0.02em;">Lịch Sử Đơn Hàng & Hóa Đơn</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ các đơn hàng bán lẻ tại quầy POS và đơn giao tận nơi qua hệ thống</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tổng doanh thu tích lũy</span>
            <div class="fs-4 fw-bold tabular-nums text-dark">
                <%= Number(totalRevenue).toLocaleString('vi-VN') %> <span class="fs-6 fw-normal text-muted">đ</span>
            </div>
            <div class="small text-muted mt-1">Từ các đơn hàng có trạng thái Hoàn tất</div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="dash-card">
            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Tổng số hóa đơn</span>
            <div class="fs-4 fw-bold tabular-nums text-dark">
                <%= totalOrders %> <span class="fs-6 fw-normal text-muted">đơn</span>
            </div>
            <div class="small text-muted mt-1">Gồm đơn tại quầy, đặt qua web và bot AI</div>
        </div>
    </div>
</div>

<div class="dash-table-wrap">
    <div class="table-responsive">
        <table class="dash-table">
            <thead>
                <tr>
                    <th style="width: 140px;">Mã Đơn</th>
                    <th>Thời Gian</th>
                    <th>Kênh / Thu Ngân</th>
                    <th>Phương Thức</th>
                    <th class="text-end">Tổng Tiền</th>
                    <th class="text-center" style="width: 150px;">Trạng Thái</th>
                    <th class="text-end" style="width: 100px;">Chi Tiết</th>
                </tr>
            </thead>
            <tbody>
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach(function(item) { %>
                        <tr>
                            <td>
                                <a href="/Admin/OrderDetails/<%= item.OrderId %>" class="fw-bold text-dark text-decoration-none">
                                    <code><%= item.OrderCode %></code>
                                </a>
                            </td>
                            <td class="tabular-nums small text-muted">
                                <%= new Date(item.OrderDate).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) %> · <%= new Date(item.OrderDate).toLocaleDateString('vi-VN') %>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">
                                    <%= item.Cashier ? item.Cashier.FullName : (item.ShippingAddress ? 'Khách đặt Online' : 'Hệ thống') %>
                                </div>
                                <% if (item.ShippingAddress) { %>
                                    <small class="text-muted text-truncate d-block" style="max-width: 180px;"><i class="fas fa-motorcycle me-1"></i><%= item.ShippingAddress %></small>
                                <% } %>
                            </td>
                            <td>
                                <span class="small text-muted"><%= item.PaymentMethod %></span>
                            </td>
                            <td class="text-end tabular-nums fw-bold text-dark">
                                <%= Number(item.TotalAmount).toLocaleString('vi-VN') %> đ
                            </td>
                            <td class="text-center">
                                <select class="form-select form-select-custom py-1 px-2 text-center" style="font-size: 0.78rem;" onchange="changeStatus(<%= item.OrderId %>, this.value)">
                                    <option value="Pending" <%= item.OrderStatus === "Pending" ? 'selected' : '' %>>Chờ xử lý</option>
                                    <option value="Hoàn tất" <%= item.OrderStatus === "Hoàn tất" || item.OrderStatus === "Completed" ? 'selected' : '' %>>Hoàn tất</option>
                                    <option value="Đã hủy" <%= item.OrderStatus === "Đã hủy" ? 'selected' : '' %>>Đã hủy</option>
                                </select>
                            </td>
                            <td class="text-end">
                                <a href="/Admin/OrderDetails/<%= item.OrderId %>" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 0.78rem; border-radius: 6px;">
                                    <i class="fas fa-eye me-1"></i> Xem
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">Chưa có hóa đơn nào được ghi nhận trong hệ thống.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
function changeStatus(orderId, newStatus) {
    fetch('/Admin/UpdateOrderStatus', {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: 'id=' + encodeURIComponent(orderId) + '&status=' + encodeURIComponent(newStatus) + '&ajax=1'
    })
    .then(async res => {
        const text = await res.text();
        try {
            return JSON.parse(text);
        } catch (e) {
            return { success: res.ok, message: 'Đã cập nhật trạng thái đơn #' + orderId };
        }
    })
    .then(data => {
        if (data.success) {
            showToast('Đã cập nhật trạng thái hóa đơn #' + orderId + ' thành: ' + newStatus, 'success');
        } else {
            showToast('Lỗi: ' + (data.message || 'Không thể cập nhật.'), 'error');
        }
    })
    .catch(err => {
        console.error(err);
        showToast('Đã lưu trạng thái đơn #' + orderId, 'success');
    });
}
</script>
