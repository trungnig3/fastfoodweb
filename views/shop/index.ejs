                            <i class="fas fa-star text-warning star-btn" data-star="4" onclick="setFeedbackRating(4)" onmouseenter="previewStars(4)" onmouseleave="resetPreviewStars()"></i>
                            <i class="fas fa-star text-warning star-btn" data-star="5" onclick="setFeedbackRating(5)" onmouseenter="previewStars(5)" onmouseleave="resetPreviewStars()"></i>
