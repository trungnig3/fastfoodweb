                    <!-- 2. Chọn chủ đề / danh mục -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Chủ đề đánh giá / khiếu nại:</label>
                        <div class="d-flex flex-wrap gap-2" id="fbCategoryChips">
                            <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1 small category-chip active" onclick="setFeedbackCategory('Chất lượng món ăn', this)">🍔 Chất lượng món ăn</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 small category-chip" onclick="setFeedbackCategory('Tốc độ giao hàng', this)">🛵 Tốc độ giao hàng</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 small category-chip" onclick="setFeedbackCategory('Thái độ phục vụ', this)">👨‍🍳 Thái độ phục vụ</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 small category-chip" onclick="setFeedbackCategory('Giá cả & Khuyến mãi', this)">💰 Giá & Khuyến mãi</button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 small category-chip" onclick="setFeedbackCategory('Khiếu nại dịch vụ', this)">⚠️ Khiếu nại dịch vụ</button>
                        </div>
                        <input type="hidden" id="fbCategory" value="Chất lượng món ăn" />
                    </div>

                    <!-- 3. Thông tin người gửi -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Họ và tên:</label>
                            <input type="text" id="fbName" class="form-control form-control-custom w-100" placeholder="Nguyễn Văn A" value="<%= typeof user !== 'undefined' && user ? user.FullName : '' %>" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Số điện thoại:</label>
                            <input type="tel" id="fbPhone" class="form-control form-control-custom w-100" placeholder="09xxxxxxxx" value="<%= typeof customerPhone !== 'undefined' ? customerPhone : '' %>" />
                        </div>
                    </div>

                    <!-- 4. Nội dung -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Nội dung chi tiết:</label>
                        <textarea id="fbContent" class="form-control form-control-custom w-100" rows="3" placeholder="Chia sẻ trải nghiệm hương vị món ăn, shipper giao hàng hoặc góp ý để quán phục vụ tốt hơn..."></textarea>
                    </div>

                    <div class="p-2 rounded-2 bg-light border d-flex align-items-center gap-2 small text-muted" style="font-size: 0.75rem;">
                        <i class="fas fa-envelope-circle-check text-primary fs-6"></i>
                        <span>Đánh giá & khiếu nại sẽ được đồng bộ trực tiếp lên hệ thống và gửi email thông báo tới Quản trị viên.</span>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light py-2 px-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="button" class="btn btn-brand-primary rounded-pill px-4 fw-bold" id="btnSubmitFeedback" onclick="sendComplaint()">
                        <i class="fas fa-paper-plane me-1"></i> Gửi Đánh Giá Ngay
                    </button>
                </div>
            </div>
        </div>
    </div>

