            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-body p-4 text-center">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 58px; height: 58px; background: #ECFDF5; color: #10B981; font-size: 1.8rem;">
                        <i class="fas fa-check"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Đặt Hàng Thành Công!</h5>
                    <p class="text-muted small mb-3">Đơn hàng của bạn đã được chuyển đến bếp chế biến</p>

                    <div class="p-3 rounded-3 text-start small mb-3" style="background: #F8FAFC; border: 1px dashed var(--border-subtle);">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Mã đơn hàng:</span>
                            <span class="fw-bold text-dark font-monospace" id="shopSuccessOrderCode">--</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1" id="shopSuccessShipperRow">
                            <span class="text-muted">Tài xế giao hàng:</span>
                            <span class="fw-semibold text-dark" id="shopSuccessShipper">--</span>
                        </div>
                        <div class="d-flex justify-content-between pt-1 border-top">
                            <span class="text-muted">Thời gian dự kiến:</span>
                            <span class="fw-bold text-success">Khoảng 20 - 30 phút</span>
                        </div>
                    </div>

                    <button type="button" class="btn btn-brand-primary w-100 justify-content-center py-2" data-bs-dismiss="modal">
                        <i class="fas fa-utensils me-1"></i> Tiếp tục xem thực đơn
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FLOATING TOASTS -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;" id="shopToastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let cart = [];
        let shippingFee = 0;

        function formatMoney(amount) {
            return Number(amount).toLocaleString('vi-VN') + ' đ';
        }

        function filterMenu(catId, btn) {
            document.querySelectorAll('.filter-category-btn, .cat-menu-item').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const items = document.querySelectorAll('.food-item');
            let count = 0;
            items.forEach(el => {
                let show = false;
                if (catId === 'all') {
                    show = true;
                } else if (catId === 'combo') {
                    show = el.getAttribute('data-combo') === 'true';
                } else {
                    show = el.getAttribute('data-category') === String(catId);
                }
                el.style.display = show ? 'block' : 'none';
                if (show) count++;
            });
            const badge = document.getElementById('itemsCountBadge');
            if (badge) badge.textContent = count + ' món';
        }

        function addToCart(id, name, price) {
            const found = cart.find(i => i.id === id);
            if (found) {
                found.quantity++;
            } else {
                cart.push({ id, name, price, quantity: 1 });
            }
            renderCart();
        }

        function updateItemQuantity(id, delta) {
            const idx = cart.findIndex(i => i.id === id);
            if (idx !== -1) {
                cart[idx].quantity += delta;
                if (cart[idx].quantity <= 0) {
                    cart.splice(idx, 1);
                }
                renderCart();
            }
        }

        function renderCart() {
            const listEl = document.getElementById('cartItemsList');
            const noticeEl = document.getElementById('emptyCartNotice');
            const subTotalEl = document.getElementById('subTotalText');
            const finalTotalEl = document.getElementById('finalTotalText');
            const badgeEl = document.getElementById('cartCountBadge');

            if (cart.length === 0) {
                listEl.innerHTML = '';
                listEl.appendChild(noticeEl);
                noticeEl.style.display = 'block';
                badgeEl.innerText = '0 món';
                subTotalEl.innerText = '0 đ';
                finalTotalEl.innerText = formatMoney(shippingFee);
                return;
            }

            listEl.innerHTML = '';
            let subTotal = 0;
            let totalCount = 0;

            cart.forEach(item => {
                totalCount += item.quantity;
                const lineTotal = item.price * item.quantity;
                subTotal += lineTotal;

                const row = document.createElement('div');
                row.className = 'd-flex justify-content-between align-items-center mb-2 pb-2 border-bottom';
                row.innerHTML = `
                    <div style="max-width: 55%;">
                        <div class="fw-semibold small text-truncate text-dark">${item.name}</div>
                        <small class="text-danger tabular-nums">${formatMoney(item.price)}</small>
                    </div>
                    <div class="d-flex align-items-center bg-light rounded-2 border px-1">
                        <button class="btn btn-sm p-0 px-2 text-muted border-0" onclick="updateItemQuantity(${item.id}, -1)">-</button>
                        <span class="small fw-bold px-2 tabular-nums">${item.quantity}</span>
                        <button class="btn btn-sm p-0 px-2 text-muted border-0" onclick="updateItemQuantity(${item.id}, 1)">+</button>
                    </div>
                `;
                listEl.appendChild(row);
            });

            badgeEl.innerText = `${totalCount} món`;
            subTotalEl.innerText = formatMoney(subTotal);
            finalTotalEl.innerText = formatMoney(subTotal + shippingFee);
        }

        async function calcDeliveryFee() {
            const addr = document.getElementById('deliveryAddress').value.trim();
            const statusEl = document.getElementById('deliveryFeeStatus');
            if (!addr) {
                shippingFee = 0;
                statusEl.innerHTML = '';
                renderCart();
                return;
            }

            statusEl.innerHTML = '<span class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Đang tính khoảng cách...</span>';

            try {
                const query = encodeURIComponent(addr + ', Việt Nam');
                const geo = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}&limit=1`).then(r => r.json());

                if (geo && geo.length > 0) {
                    const lat = parseFloat(geo[0].lat);
                    const lon = parseFloat(geo[0].lon);
                    const osrm = await fetch(`https://router.project-osrm.org/route/v1/driving/105.795139,21.037814;${lon},${lat}?overview=false`).then(r => r.json());
                    if (osrm && osrm.routes && osrm.routes.length > 0) {
                        const distKm = osrm.routes[0].distance / 1000;
                        if (distKm <= 2) {
                            shippingFee = 0;
                            statusEl.innerHTML = `<span class="text-success"><i class="fas fa-check-circle me-1"></i>${distKm.toFixed(1)} km - Miễn phí ship!</span>`;
                        } else {
                            shippingFee = Math.ceil(distKm - 2) * 5000;
                            statusEl.innerHTML = `<span class="text-primary"><i class="fas fa-motorcycle me-1"></i>${distKm.toFixed(1)} km - Phí ship: ${formatMoney(shippingFee)}</span>`;
                        }
                    } else {
                        shippingFee = 15000;
                        statusEl.innerHTML = `<span class="text-muted">Cước giao hàng cố định: ${formatMoney(shippingFee)}</span>`;
                    }
                } else {
                    shippingFee = 15000;
                    statusEl.innerHTML = `<span class="text-muted">Cước giao hàng tiêu chuẩn: ${formatMoney(shippingFee)}</span>`;
                }
            } catch (e) {
                shippingFee = 15000;
                statusEl.innerHTML = `<span class="text-muted">Cước giao hàng: ${formatMoney(shippingFee)}</span>`;
            }
            renderCart();
        }

        function showShopToast(message, type) {
            type = type || 'success';
            var container = document.getElementById('shopToastContainer');
            if (!container) return;
            var toastEl = document.createElement('div');
            toastEl.className = 'toast align-items-center text-white bg-' + (type === 'error' ? 'danger' : (type === 'warning' ? 'warning text-dark' : 'dark')) + ' border-0 show mb-2';
            toastEl.setAttribute('role', 'alert');
            toastEl.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            container.appendChild(toastEl);
            setTimeout(function() { toastEl.remove(); }, 3500);
        }

        function checkoutOrder() {
            if (cart.length === 0) return showShopToast('Vui lòng chọn ít nhất 1 món ăn vào giỏ hàng!', 'warning');
            
            const phone = document.getElementById('custPhone').value.trim();
            if (!phone) {
                document.getElementById('custPhone').focus();
                return showShopToast('Vui lòng nhập số điện thoại nhận hàng (bắt buộc)!', 'warning');
            }
            const cleanPhone = phone.replace(/[\s.-]/g, '');
            if (!/^[0-9]{9,11}$/.test(cleanPhone)) {
                document.getElementById('custPhone').focus();
                return showShopToast('Số điện thoại không hợp lệ (cần từ 9 đến 11 chữ số)!', 'warning');
            }

            const address = document.getElementById('deliveryAddress').value.trim();
            if (!address) {
                document.getElementById('deliveryAddress').focus();
                return showShopToast('Vui lòng nhập địa chỉ nhận hàng!', 'warning');
            }

            const method = document.getElementById('payMethod').value;
            const btn = document.getElementById('btnSubmitOrder');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý đơn...';

            fetch('/Shop/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Items: cart,
                    Address: address,
                    PaymentMethod: method,
                    ShippingFee: shippingFee,
                    CustomerPhone: phone
                })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    if (data.isRedirect && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        document.getElementById('shopSuccessOrderCode').textContent = data.orderCode;
                        const shipperEl = document.getElementById('shopSuccessShipper');
                        if (data.driverName) {
                            shipperEl.textContent = data.driverName + ' (' + (data.driverPhone || '') + ')';
                            document.getElementById('shopSuccessShipperRow').style.display = 'flex';
                        } else {
                            document.getElementById('shopSuccessShipperRow').style.display = 'none';
                        }

                        var modal = new bootstrap.Modal(document.getElementById('shopOrderSuccessModal'));
                        modal.show();

                        cart = [];
                        renderCart();
                        document.getElementById('deliveryAddress').value = '';
                        document.getElementById('custPhone').value = '';
                        document.getElementById('deliveryFeeStatus').innerHTML = '';
                    }
                } else {
                    showShopToast('Lỗi: ' + (data.message || 'Không thể đặt hàng.'), 'error');
                }
            })
            .catch(() => showShopToast('Đã tiếp nhận thông tin đơn hàng thành công!', 'info'))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = 'XÁC NHẬN ĐẶT HÀNG';
            });
        }

        async function sendBotMessage() {
            const input = document.getElementById('botInput');
            const msg = input.value.trim();
            if (!msg) return;

            const chatLogs = document.getElementById('chatLogs');
            chatLogs.innerHTML += `<div class="msg-bubble msg-user">${msg}</div>`;
            input.value = '';
            chatLogs.scrollTop = chatLogs.scrollHeight;

            const tempId = 'bot-temp-' + Date.now();
            chatLogs.innerHTML += `<div id="${tempId}" class="msg-bubble msg-bot text-muted"><i class="fas fa-spinner fa-spin me-1"></i> Đang suy nghĩ...</div>`;
            chatLogs.scrollTop = chatLogs.scrollHeight;

            try {
                const res = await fetch('/Shop/ChatBot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Message: msg })
                }).then(r => r.json());

                document.getElementById(tempId)?.remove();
                const replyHtml = res.reply.replace(/\n/g, '<br>');
                chatLogs.innerHTML += `<div class="msg-bubble msg-bot">🤖 ${replyHtml}</div>`;
                chatLogs.scrollTop = chatLogs.scrollHeight;
            } catch (e) {
                document.getElementById(tempId)?.remove();
                chatLogs.innerHTML += `<div class="msg-bubble msg-bot text-danger">Lỗi kết nối đến trợ lý AI.</div>`;
            }
        }

        function sendComplaint() {
            const name = document.getElementById('fbName').value.trim();
            const phone = document.getElementById('fbPhone').value.trim();
            const content = document.getElementById('fbContent').value.trim();
            if (!content) return showShopToast('Vui lòng nhập nội dung phản hồi!', 'warning');

            fetch('/Shop/SendComplaint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CustomerName: name, Phone: phone, Content: content })
            })
            .then(r => r.json())
            .then(data => {
                showShopToast(data.message || 'Đã gửi phản hồi thành công!', 'success');
                bootstrap.Modal.getInstance(document.getElementById('feedbackModal'))?.hide();
                document.getElementById('fbContent').value = '';
            })
            .catch(() => showShopToast('Lỗi khi gửi phản hồi!', 'error'));
        }
    </script>
</body>
</html>
