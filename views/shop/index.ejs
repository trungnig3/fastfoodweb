    <!-- NÚT NỔI TRỢ LÝ AI (KHÔNG BAO GIỜ BỊ CHE KHUẤT) -->
    <div style="position: fixed; bottom: 24px; right: 24px; z-index: 1055;" class="no-print">
        <button type="button" class="btn btn-dark shadow-lg rounded-pill px-3 py-2 d-flex align-items-center gap-2 border border-2 border-white" onclick="openFloatingAiChat()" title="Mở Trợ Lý AI" style="box-shadow: 0 8px 24px rgba(0,0,0,0.28);">
            <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.85rem;">
                <i class="fas fa-robot"></i>
            </span>
            <span class="fw-bold small">Trợ Lý AI</span>
        </button>
    </div>

    <!-- FLOATING TOASTS -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;" id="shopToastContainer"></div>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let cart = [];
        let shippingFee = 0;
        let currentCustomer = null;
        let pointsDiscountAmount = 0;
        let pointsToUse = 0;
        let isUsingPoints = false;
        let phoneCheckTimeout = null;
        let trackIntervalId = null;
        let trackCurrentSeconds = 0;

        function formatMoney(amount) {
            return Number(amount).toLocaleString('vi-VN') + ' đ';
        }

        // ==================== TRA CỨU & DÙNG ĐIỂM THÀNH VIÊN ====================
        function openPointsModal(prefillPhone) {
            const phone = prefillPhone || (document.getElementById('custPhone') ? document.getElementById('custPhone').value.trim() : '') || '<%= customerPhone %>';
            const input = document.getElementById('lookupPhoneInput');
            if (input && phone) {
                input.value = phone;
            }
            const modalEl = document.getElementById('pointsModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
                if (input && input.value.trim()) {
                    queryPointsFromModal();
                }
            }
        }

        function queryPointsFromModal() {
            const phoneInput = document.getElementById('lookupPhoneInput');
            const phone = phoneInput ? phoneInput.value.trim() : '';
            const loading = document.getElementById('pointsLoadingState');
            const alertBox = document.getElementById('pointsErrorAlert');
            const resultCard = document.getElementById('pointsResultCard');

            if (!phone) {
                alertBox.textContent = 'Vui lòng nhập số điện thoại thành viên cần tra cứu!';
                alertBox.classList.remove('d-none');
                resultCard.classList.add('d-none');
                return;
            }

            loading.classList.remove('d-none');
            alertBox.classList.add('d-none');
            resultCard.classList.add('d-none');

            fetch('/Shop/GetCustomerPoints?phone=' + encodeURIComponent(phone))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    loading.classList.add('d-none');
                    if (data.success && data.customer) {
                        const cust = data.customer;
                        currentCustomer = cust;
                        document.getElementById('resCustName').textContent = cust.name || 'Khách hàng';
                        document.getElementById('resCustPhone').textContent = cust.phone;
                        document.getElementById('resCustTier').textContent = cust.tier || 'Đồng';
                        document.getElementById('resCustPoints').textContent = cust.points || 0;
                        document.getElementById('resCustValue').textContent = formatMoney(cust.discountValue || (cust.points * 1000));

                        const tierBadge = document.getElementById('resCustTierBadge');
                        if (tierBadge) {
                            if (cust.tier === 'Kim Cương') tierBadge.className = 'badge bg-info text-dark fw-bold px-3 py-2 fs-6 rounded-pill shadow-sm';
                            else if (cust.tier === 'Vàng') tierBadge.className = 'badge bg-warning text-dark fw-bold px-3 py-2 fs-6 rounded-pill shadow-sm';
                            else if (cust.tier === 'Bạc') tierBadge.className = 'badge bg-secondary text-white fw-bold px-3 py-2 fs-6 rounded-pill shadow-sm';
                            else tierBadge.className = 'badge bg-light text-dark fw-bold px-3 py-2 fs-6 rounded-pill shadow-sm';
                        }

                        const p = cust.points || 0;
                        let nextDesc = '';
                        let progress = 0;
                        if (p < 50) {
                            nextDesc = 'Cần thêm ' + (50 - p) + ' điểm để lên Bạc (50đ)';
                            progress = Math.min(100, Math.round((p / 50) * 100));
                        } else if (p < 150) {
                            nextDesc = 'Cần thêm ' + (150 - p) + ' điểm để lên Vàng (150đ)';
                            progress = Math.min(100, Math.round(((p - 50) / 100) * 100));
                        } else if (p < 300) {
                            nextDesc = 'Cần thêm ' + (300 - p) + ' điểm để lên Kim Cương (300đ)';
                            progress = Math.min(100, Math.round(((p - 150) / 150) * 100));
                        } else {
                            nextDesc = 'Đã đạt hạng tối đa Kim Cương!';
                            progress = 100;
                        }
                        document.getElementById('resNextTierDesc').textContent = nextDesc;
                        document.getElementById('resTierProgressBar').style.width = progress + '%';

                        const historyList = document.getElementById('resPointHistoryList');
                        historyList.innerHTML = '';
                        if (cust.history && cust.history.length > 0) {
                            cust.history.forEach(function(h) {
                                const isPlus = h.points >= 0;
                                historyList.innerHTML += '<div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light small"><div><div class="fw-semibold text-dark">' + (h.note || 'Tích lũy điểm') + '</div><small class="text-muted" style="font-size: 0.7rem;">' + h.date + '</small></div><span class="fw-bold ' + (isPlus ? 'text-success' : 'text-danger') + '">' + (isPlus ? '+' : '') + h.points + ' đ</span></div>';
                            });
                        } else {
                            historyList.innerHTML = '<div class="text-center text-muted small py-2">Chưa có lịch sử giao dịch điểm.</div>';
                        }

                        resultCard.classList.remove('d-none');
                        syncLoyaltyCartUI(cust);
                    } else {
                        alertBox.textContent = data.message || 'Không tìm thấy thông tin thành viên!';
                        alertBox.classList.remove('d-none');
                    }
                })
                .catch(function() {
                    loading.classList.add('d-none');
                    alertBox.textContent = 'Lỗi kết nối máy chủ khi tra cứu!';
                    alertBox.classList.remove('d-none');
                });
        }

        function handlePhoneBlur() {
            const phoneEl = document.getElementById('custPhone');
            const phone = phoneEl ? phoneEl.value.trim() : '';
            if (!phone || phone.length < 9) {
                hideLoyaltySection();
                return;
            }

            clearTimeout(phoneCheckTimeout);
            phoneCheckTimeout = setTimeout(function() {
                fetch('/Shop/GetCustomerPoints?phone=' + encodeURIComponent(phone))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success && data.customer) {
                            currentCustomer = data.customer;
                            syncLoyaltyCartUI(data.customer);
                        } else {
                            hideLoyaltySection();
                        }
                    })
                    .catch(function() { hideLoyaltySection(); });
            }, 300);
        }

        function syncLoyaltyCartUI(cust) {
            const wrap = document.getElementById('loyaltySectionCart');
            if (!wrap) return;
            if (cust && cust.points > 0) {
                wrap.classList.remove('d-none');
                document.getElementById('loyaltyCustomerPoints').textContent = cust.points;
                document.getElementById('loyaltyCustomerValue').textContent = formatMoney(cust.discountValue || (cust.points * 1000));
            } else {
                wrap.classList.add('d-none');
            }
            renderCart();
        }

        function hideLoyaltySection() {
            currentCustomer = null;
            isUsingPoints = false;
            pointsDiscountAmount = 0;
            pointsToUse = 0;
            const wrap = document.getElementById('loyaltySectionCart');
            if (wrap) wrap.classList.add('d-none');
            const chk = document.getElementById('chkUseLoyaltyPoints');
            if (chk) chk.checked = false;
            const inputWrap = document.getElementById('loyaltyPointsInputWrap');
            if (inputWrap) inputWrap.classList.add('d-none');
            renderCart();
        }

        function toggleUsePointsCart() {
            const chk = document.getElementById('chkUseLoyaltyPoints');
            const wrap = document.getElementById('loyaltyPointsInputWrap');
            isUsingPoints = Boolean(chk && chk.checked);

            if (isUsingPoints) {
                if (wrap) wrap.classList.remove('d-none');
                useMaxPointsCart();
            } else {
                if (wrap) wrap.classList.add('d-none');
                pointsDiscountAmount = 0;
                pointsToUse = 0;
                renderCart();
            }
        }

        function useMaxPointsCart() {
            if (!currentCustomer) return;
            let subTotal = 0;
            cart.forEach(function(i) { subTotal += i.price * i.quantity; });
            const maxPointsCanUse = Math.min(currentCustomer.points || 0, Math.floor(subTotal / 1000));
            pointsToUse = Math.max(0, maxPointsCanUse);
            const input = document.getElementById('inputPointsToUse');
            if (input) input.value = pointsToUse;
            onPointsAmountChange();
        }

        function onPointsAmountChange() {
            if (!isUsingPoints || !currentCustomer) return;
            const input = document.getElementById('inputPointsToUse');
            let val = parseInt(input ? input.value : '0', 10);
            if (isNaN(val) || val < 0) val = 0;

            let subTotal = 0;
            cart.forEach(function(i) { subTotal += i.price * i.quantity; });
            const maxPointsCanUse = Math.min(currentCustomer.points || 0, Math.floor(subTotal / 1000));

            if (val > maxPointsCanUse) {
                val = maxPointsCanUse;
                if (input) input.value = val;
            }
            pointsToUse = val;
            pointsDiscountAmount = pointsToUse * 1000;

            const preview = document.getElementById('loyaltyDiscountPreviewText');
            if (preview) preview.textContent = '-' + formatMoney(pointsDiscountAmount);

            renderCart();
        }

        function filterMenu(catId, btn) {
            document.querySelectorAll('.filter-category-btn, .cat-menu-item').forEach(function(b) { b.classList.remove('active'); });
            if (btn) btn.classList.add('active');

            const items = document.querySelectorAll('.food-item');
            let count = 0;
            items.forEach(function(el) {
                let show = false;
                if (catId === 'all') {
                    show = true;
                } else if (catId === 'combo') {
                    show = el.getAttribute('data-combo') === 'true';
                } else {
                    show = el.getAttribute('data-category') === String(catId);
                }
                el.style.display = show ? 'block' : 'none';
                if (show) count++;
            });
            const badge = document.getElementById('itemsCountBadge');
            if (badge) badge.textContent = count + ' món';
        }

        function addToCartBtn(btn) {
            if (!btn) return;
            const id = parseInt(btn.getAttribute('data-id'), 10);
            const name = btn.getAttribute('data-name') || '';
            const price = parseFloat(btn.getAttribute('data-price')) || 0;
            addToCart(id, name, price);
        }

        function addToCart(id, name, price) {
            const found = cart.find(function(i) { return i.id === id; });
            if (found) {
                found.quantity++;
            } else {
                cart.push({ id: id, name: name, price: price, quantity: 1 });
            }
            renderCart();
            showShopToast('Đã thêm "' + name + '" vào giỏ hàng!', 'success');
        }

        function updateItemQuantity(id, delta) {
            const idx = cart.findIndex(function(i) { return i.id === id; });
            if (idx !== -1) {
                cart[idx].quantity += delta;
                if (cart[idx].quantity <= 0) {
                    cart.splice(idx, 1);
                }
                renderCart();
            }
        }

        function onAddressChanged() {
            const addrEl = document.getElementById('deliveryAddress');
            const addr = addrEl ? addrEl.value.trim() : '';
            const statusEl = document.getElementById('deliveryFeeStatus');
            if (!addr) {
                shippingFee = 0;
                if (statusEl) statusEl.innerHTML = '';
                renderCart();
                return;
            }

            let subTotal = 0;
            cart.forEach(function(i) { subTotal += i.price * i.quantity; });

            if (subTotal >= 150000) {
                shippingFee = 0;
                if (statusEl) statusEl.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Đơn hàng từ 150k - Miễn phí vận chuyển!</span>';
            } else {
                shippingFee = 15000;
                if (statusEl) statusEl.innerHTML = '<span class="text-primary"><i class="fas fa-truck me-1"></i>Phí giao hàng tận nơi: <b>' + formatMoney(shippingFee) + '</b></span>';
            }
            renderCart();
        }

        function renderCart() {
            const listEl = document.getElementById('cartItemsList');
            const noticeEl = document.getElementById('emptyCartNotice');
            const subTotalEl = document.getElementById('subTotalText');
            const finalTotalEl = document.getElementById('finalTotalText');
            const badgeEl = document.getElementById('cartCountBadge');
            const rowDiscount = document.getElementById('rowDiscountPoints');
            const rowShip = document.getElementById('rowShipFee');
            const shipFeeEl = document.getElementById('cartShipFeeText');
            const discTextEl = document.getElementById('cartDiscountPointsText');

            if (cart.length === 0) {
                listEl.innerHTML = '';
                if (noticeEl) {
                    listEl.appendChild(noticeEl);
                    noticeEl.style.display = 'block';
                }
                if (badgeEl) badgeEl.innerText = '0 món';
                const tabBadge = document.getElementById('cartCountBadgeTab');
                if (tabBadge) tabBadge.innerText = '0';
                if (subTotalEl) subTotalEl.innerText = '0 đ';
                if (rowDiscount) rowDiscount.style.display = 'none';
                if (rowShip) rowShip.style.display = 'none';
                if (finalTotalEl) finalTotalEl.innerText = formatMoney(shippingFee);
                return;
            }

            listEl.innerHTML = '';
            let subTotal = 0;
            let totalCount = 0;

            cart.forEach(function(item) {
                totalCount += item.quantity;
                const lineTotal = item.price * item.quantity;
                subTotal += lineTotal;

                const row = document.createElement('div');
                row.className = 'd-flex justify-content-between align-items-center mb-2 pb-2 border-bottom';
                row.innerHTML = '<div style="max-width: 55%;"><div class="fw-semibold small text-truncate text-dark">' + item.name + '</div><small class="text-danger tabular-nums">' + formatMoney(item.price) + '</small></div><div class="d-flex align-items-center bg-light rounded-2 border px-1"><button type="button" class="btn btn-sm p-0 px-2 text-muted border-0" onclick="updateItemQuantity(' + item.id + ', -1)">-</button><span class="small fw-bold px-2 tabular-nums">' + item.quantity + '</span><button type="button" class="btn btn-sm p-0 px-2 text-muted border-0" onclick="updateItemQuantity(' + item.id + ', 1)">+</button></div>';
                listEl.appendChild(row);
            });

            // Recheck freeship condition
            const addrEl = document.getElementById('deliveryAddress');
            const addr = addrEl ? addrEl.value.trim() : '';
            if (addr) {
                if (subTotal >= 150000) {
                    shippingFee = 0;
                    const statusEl = document.getElementById('deliveryFeeStatus');
                    if (statusEl) statusEl.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Đơn hàng từ 150k - Miễn phí vận chuyển!</span>';
                } else {
                    shippingFee = 15000;
                    const statusEl = document.getElementById('deliveryFeeStatus');
                    if (statusEl) statusEl.innerHTML = '<span class="text-primary"><i class="fas fa-truck me-1"></i>Phí giao hàng tận nơi: <b>' + formatMoney(shippingFee) + '</b></span>';
                }
            }

            // Xử lý giảm trừ điểm nếu kích hoạt
            if (isUsingPoints && currentCustomer && currentCustomer.points > 0) {
                const maxPoints = Math.min(currentCustomer.points, Math.floor(subTotal / 1000));
                if (pointsToUse > maxPoints) {
                    pointsToUse = maxPoints;
                    const input = document.getElementById('inputPointsToUse');
                    if (input) input.value = pointsToUse;
                }
                pointsDiscountAmount = pointsToUse * 1000;

                if (pointsDiscountAmount > 0) {
                    if (rowDiscount) rowDiscount.style.display = 'flex';
                    if (discTextEl) discTextEl.innerText = '-' + formatMoney(pointsDiscountAmount);
                } else {
                    if (rowDiscount) rowDiscount.style.display = 'none';
                }
            } else {
                pointsDiscountAmount = 0;
                if (rowDiscount) rowDiscount.style.display = 'none';
            }

            if (rowShip) {
                if (shippingFee > 0 || addr) {
                    rowShip.style.display = 'flex';
                    if (shipFeeEl) shipFeeEl.innerText = shippingFee === 0 ? 'Miễn phí' : formatMoney(shippingFee);
                } else {
                    rowShip.style.display = 'none';
                }
            }

            const finalTotal = Math.max(0, subTotal - pointsDiscountAmount) + shippingFee;

            if (badgeEl) badgeEl.innerText = totalCount + ' món';
            const tabBadge = document.getElementById('cartCountBadgeTab');
            if (tabBadge) tabBadge.innerText = String(totalCount);
            if (subTotalEl) subTotalEl.innerText = formatMoney(subTotal);
            if (finalTotalEl) finalTotalEl.innerText = formatMoney(finalTotal);
        }

        function showShopToast(message, type) {
            type = type || 'success';
            const container = document.getElementById('shopToastContainer');
            if (!container) return;
            const toastEl = document.createElement('div');
            const bgClass = type === 'error' ? 'danger' : (type === 'warning' ? 'warning text-dark' : 'dark');
            toastEl.className = 'toast align-items-center text-white bg-' + bgClass + ' border-0 show mb-2';
            toastEl.setAttribute('role', 'alert');
            toastEl.innerHTML = '<div class="d-flex"><div class="toast-body">' + message + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            container.appendChild(toastEl);
            setTimeout(function() { toastEl.remove(); }, 3500);
        }

        // ==================== ĐẶT HÀNG (CHECKOUT) ====================
        function checkoutOrder() {
            if (cart.length === 0) return showShopToast('Vui lòng chọn ít nhất 1 món ăn vào giỏ hàng!', 'warning');
            
            const phoneEl = document.getElementById('custPhone');
            const phone = phoneEl ? phoneEl.value.trim() : '';
            if (!phone) {
                if (phoneEl) phoneEl.focus();
                return showShopToast('Vui lòng nhập số điện thoại nhận hàng (bắt buộc)!', 'warning');
            }
            const cleanPhone = phone.replace(/[\s.-]/g, '');
            if (!/^[0-9]{9,11}$/.test(cleanPhone)) {
                if (phoneEl) phoneEl.focus();
                return showShopToast('Số điện thoại không hợp lệ (cần từ 9 đến 11 chữ số)!', 'warning');
            }

            const addrEl = document.getElementById('deliveryAddress');
            const address = addrEl ? addrEl.value.trim() : '';
            if (!address) {
                if (addrEl) addrEl.focus();
                return showShopToast('Vui lòng nhập địa chỉ nhận hàng!', 'warning');
            }

            const nameEl = document.getElementById('custName');
            const name = nameEl ? nameEl.value.trim() : '';
            const methodEl = document.getElementById('payMethod');
            const method = methodEl ? methodEl.value : 'COD';
            const btn = document.getElementById('btnSubmitOrder');

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý đơn...';
            }

            fetch('/Shop/Checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Items: cart,
                    Address: address,
                    PaymentMethod: method,
                    ShippingFee: shippingFee,
                    CustomerPhone: phone,
                    CustomerName: name,
                    UsePoints: isUsingPoints,
                    PointsToUse: pointsToUse
                })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    if (data.isRedirect && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        document.getElementById('shopSuccessOrderCode').textContent = data.orderCode;
                        const shipperEl = document.getElementById('shopSuccessShipper');
                        if (data.driverName) {
                            shipperEl.textContent = data.driverName + ' (' + (data.driverPhone || '') + ')';
                            document.getElementById('shopSuccessShipperRow').style.display = 'flex';
                        } else {
                            document.getElementById('shopSuccessShipperRow').style.display = 'none';
                        }

                        const pointsUsedRow = document.getElementById('shopSuccessPointsUsedRow');
                        if (pointsUsedRow) {
                            if (data.pointsUsed > 0) {
                                document.getElementById('shopSuccessPointsUsed').textContent = '-' + data.pointsUsed + ' điểm (-' + formatMoney(data.discountAmount || (data.pointsUsed * 1000)) + ')';
                                pointsUsedRow.style.display = 'flex';
                            } else {
                                pointsUsedRow.style.display = 'none';
                            }
                        }

                        const pointsEarnedRow = document.getElementById('shopSuccessPointsEarnedRow');
                        if (pointsEarnedRow) {
                            if (data.pointsEarned > 0) {
                                document.getElementById('shopSuccessPointsEarned').textContent = '+' + data.pointsEarned + ' điểm';
                                pointsEarnedRow.style.display = 'flex';
                            } else {
                                pointsEarnedRow.style.display = 'none';
                            }
                        }

                        const pointsRemainRow = document.getElementById('shopSuccessPointsRemainingRow');
                        if (pointsRemainRow) {
                            if (data.remainingPoints !== undefined) {
                                document.getElementById('shopSuccessPointsRemaining').textContent = data.remainingPoints + ' điểm';
                                pointsRemainRow.style.display = 'flex';
                            } else {
                                pointsRemainRow.style.display = 'none';
                            }
                        }

                        const successModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('shopOrderSuccessModal'));
                        successModal.show();

                        cart = [];
                        isUsingPoints = false;
                        pointsDiscountAmount = 0;
                        pointsToUse = 0;
                        const chkPoints = document.getElementById('chkUseLoyaltyPoints');
                        if (chkPoints) chkPoints.checked = false;
                        const lWrap = document.getElementById('loyaltyPointsInputWrap');
                        if (lWrap) lWrap.classList.add('d-none');
                        renderCart();
                        if (document.getElementById('deliveryAddress')) document.getElementById('deliveryAddress').value = '';
                        if (document.getElementById('deliveryFeeStatus')) document.getElementById('deliveryFeeStatus').innerHTML = '';
                    }
                } else {
                    showShopToast('Lỗi: ' + (data.message || 'Không thể đặt hàng.'), 'error');
                }
            })
            .catch(function() { showShopToast('Lỗi kết nối khi gửi đơn hàng!', 'error'); })
            .finally(function() {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = 'XÁC NHẬN ĐẶT HÀNG';
                }
            });
        }

        // ==================== THEO DÕI ĐƠN HÀNG THỜI GIAN THỰC ====================
        var activeTrackOrder = null;
        var trackPollInterval = null;

        function openTrackOrderModal(prefillCode) {
            if (trackIntervalId) {
                clearInterval(trackIntervalId);
                trackIntervalId = null;
            }
            if (trackPollInterval) {
                clearInterval(trackPollInterval);
                trackPollInterval = null;
            }
            const phoneEl = document.getElementById('custPhone');
            const query = prefillCode || (phoneEl ? phoneEl.value.trim() : '') || (currentCustomerPhone || '');
            const input = document.getElementById('trackQueryInput');
            if (input && query) input.value = query;
            const modalEl = document.getElementById('trackOrderModal');
            if (modalEl) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
                if (input && input.value.trim()) queryTrackOrder(false);
            }
        }

        function queryTrackOrder(isSilent) {
            const queryInput = document.getElementById('trackQueryInput');
            const query = queryInput ? queryInput.value.trim() : '';
            const loading = document.getElementById('trackLoadingState');
            const alertBox = document.getElementById('trackErrorAlert');
            const resultCard = document.getElementById('trackResultCard');

            if (!query) {
                if (!isSilent) {
                    alertBox.textContent = 'Vui lòng nhập mã đơn hàng hoặc số điện thoại!';
                    alertBox.classList.remove('d-none');
                    resultCard.classList.add('d-none');
                }
                return;
            }

            if (!isSilent) {
                loading.classList.remove('d-none');
                alertBox.classList.add('d-none');
                resultCard.classList.add('d-none');
            }

            fetch('/Shop/TrackOrder?query=' + encodeURIComponent(query))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    loading.classList.add('d-none');
                    if (data.success && data.order) {
                        alertBox.classList.add('d-none');
                        renderTrackUI(data.order);
                    } else {
                        if (!isSilent) {
                            alertBox.textContent = data.message || 'Không tìm thấy thông tin đơn hàng!';
                            alertBox.classList.remove('d-none');
                            resultCard.classList.add('d-none');
                        }
                    }
                })
                .catch(function() {
                    loading.classList.add('d-none');
                    if (!isSilent) {
                        alertBox.textContent = 'Lỗi kết nối máy chủ khi tra cứu đơn hàng!';
                        alertBox.classList.remove('d-none');
                    }
                });
        }

        function renderTrackUI(order) {
            activeTrackOrder = order;
            const resultCard = document.getElementById('trackResultCard');
            resultCard.classList.remove('d-none');

            document.getElementById('trackOrderCode').textContent = order.orderCode;
            document.getElementById('trackOrderDate').textContent = order.orderDate;
            document.getElementById('trackShipperName').textContent = order.shipperName;
            document.getElementById('trackShipperPhone').textContent = order.shipperPhone;
            document.getElementById('trackAddress').textContent = order.shippingAddress || 'Nhận tại quầy';
            document.getElementById('trackPayMethod').textContent = order.paymentMethod;
            document.getElementById('trackTotalAmount').textContent = formatMoney(order.totalAmount);

            const itemsEl = document.getElementById('trackItemsList');
            itemsEl.innerHTML = '';
            if (order.items && order.items.length) {
                order.items.forEach(function(it) {
                    itemsEl.innerHTML += '<div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light"><div><span class="fw-semibold text-dark">' + it.productName + '</span><small class="text-muted ms-1">x' + it.quantity + '</small></div><span class="text-danger fw-bold">' + formatMoney(it.lineTotal) + '</span></div>';
                });
            }

            if (trackIntervalId) {
                clearInterval(trackIntervalId);
                trackIntervalId = null;
            }

            trackCurrentSeconds = order.elapsedSeconds || 0;
            updateTrackDisplay(order, trackCurrentSeconds);

            // Nếu đơn chưa hoàn tất hoặc chưa hủy thì cập nhật thời gian đếm tiến trình
            if (!order.isCompleted && !order.isCancelled && order.step !== 3 && order.step !== 0) {
                trackIntervalId = setInterval(function() {
                    trackCurrentSeconds += 1;
                    updateTrackDisplay(activeTrackOrder, trackCurrentSeconds);
                }, 1000);
            }

            // Tự động làm mới đồng bộ trạng thái đơn hàng mỗi 4 giây nếu modal đang mở
            if (!trackPollInterval) {
                trackPollInterval = setInterval(function() {
                    const modalEl = document.getElementById('trackOrderModal');
                    if (modalEl && modalEl.classList.contains('show')) {
                        queryTrackOrder(true);
                    } else {
                        clearInterval(trackPollInterval);
                        trackPollInterval = null;
                    }
                }, 4000);
            }
        }

        function updateTrackDisplay(order, seconds) {
            const step1Icon = document.getElementById('stepIcon1');
            const step2Icon = document.getElementById('stepIcon2');
            const step3Icon = document.getElementById('stepIcon3');
            const step1Text = document.getElementById('stepText1');
            const step2Text = document.getElementById('stepText2');
            const step3Text = document.getElementById('stepText3');
            const progressBar = document.getElementById('trackProgressBar');
            const titleEl = document.getElementById('trackStatusTitle');
            const descEl = document.getElementById('trackStatusDesc');
            const timerBadge = document.getElementById('trackTimerBadge');
            const timerText = document.getElementById('trackTimerText');

            if (!step1Icon || !titleEl) return;

            const isCancelled = order ? (order.isCancelled || order.orderStatus === 'Đã hủy' || order.orderStatus === 'Cancelled' || order.shippingStatus === 'Đã hủy đơn') : false;
            const isCompleted = order ? (order.isCompleted || order.step === 3 || order.orderStatus === 'Hoàn tất' || order.orderStatus === 'Completed' || order.orderStatus === 'Đã hoàn thành' || order.shippingStatus === 'Đã giao thành công' || order.shippingStatus === 'Đã giao hàng') : false;
            const isExplicitShipping = order ? (order.step === 2 || order.orderStatus === 'Đang giao' || order.shippingStatus === 'Đang giao hàng') : false;

            if (isCancelled) {
                progressBar.style.width = '100%';
                progressBar.className = 'progress-bar bg-danger';
                step1Icon.style.background = '#EF4444';
                step1Icon.style.color = '#fff';
                step1Icon.innerHTML = '<i class="fas fa-times"></i>';
                step2Icon.style.background = '#EF4444';
                step2Icon.style.color = '#fff';
                step2Icon.innerHTML = '<i class="fas fa-times"></i>';
                step3Icon.style.background = '#EF4444';
                step3Icon.style.color = '#fff';
                step3Icon.innerHTML = '<i class="fas fa-ban"></i>';

                step1Text.className = 'fw-bold small mt-2 text-muted';
                step2Text.className = 'fw-bold small mt-2 text-muted';
                step3Text.className = 'fw-bold small mt-2 text-danger';

                titleEl.textContent = 'Đơn hàng đã bị hủy';
                titleEl.className = 'fs-5 fw-bold text-danger mb-1';
                descEl.textContent = order.statusDesc || 'Đơn hàng này đã bị hủy.';
                timerBadge.className = 'badge bg-danger text-white py-2 px-3 rounded-pill fw-bold';
                timerText.innerHTML = '<i class="fas fa-ban me-1"></i> Đơn hàng đã hủy';
                return;
            }

            if (isCompleted) {
                progressBar.style.width = '100%';
                progressBar.className = 'progress-bar bg-success';
                step1Icon.style.background = '#10B981';
                step1Icon.style.color = '#fff';
                step1Icon.innerHTML = '<i class="fas fa-check"></i>';
                step2Icon.style.background = '#10B981';
                step2Icon.style.color = '#fff';
                step2Icon.innerHTML = '<i class="fas fa-check"></i>';
                step3Icon.style.background = '#10B981';
                step3Icon.style.color = '#fff';
                step3Icon.innerHTML = '<i class="fas fa-circle-check"></i>';

                step1Text.className = 'fw-bold small mt-2 text-success';
                step2Text.className = 'fw-bold small mt-2 text-success';
                step3Text.className = 'fw-bold small mt-2 text-success';

                titleEl.textContent = 'Đã Hoàn Tất / Giao Hàng Thành Công';
                titleEl.className = 'fs-5 fw-bold text-success mb-1';
                descEl.textContent = 'Đơn hàng đã được hoàn tất và giao thành công. Chúc bạn có bữa ăn thật ngon miệng!';
                timerBadge.className = 'badge bg-success text-white py-2 px-3 rounded-pill fw-bold';
                timerText.innerHTML = '<i class="fas fa-circle-check me-1"></i> Đã hoàn thành đơn hàng';
                return;
            }

            if (isExplicitShipping || (seconds >= 300 && seconds < 900)) {
                progressBar.style.width = '66%';
                progressBar.className = 'progress-bar bg-primary';
                step1Icon.style.background = '#10B981';
                step1Icon.style.color = '#fff';
                step1Icon.innerHTML = '<i class="fas fa-check"></i>';
                step2Icon.style.background = '#0284C7';
                step2Icon.style.color = '#fff';
                step2Icon.innerHTML = '<i class="fas fa-motorcycle"></i>';
                step3Icon.style.background = '#E2E8F0';
                step3Icon.style.color = '#64748B';
                step3Icon.innerHTML = '<i class="fas fa-circle-check"></i>';

                step1Text.className = 'fw-bold small mt-2 text-success';
                step2Text.className = 'fw-bold small mt-2 text-primary';
                step3Text.className = 'fw-bold small mt-2 text-muted';

                const remain = Math.max(0, 900 - seconds);
                const min = Math.floor(remain / 60);
                const sec = remain % 60;
                const fmt = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;

                titleEl.textContent = 'Đang Giao Hàng';
                titleEl.className = 'fs-5 fw-bold text-primary mb-1';
                descEl.textContent = 'Tài xế đang di chuyển giao hàng đến địa chỉ của bạn.';
                timerBadge.className = 'badge bg-primary text-white py-2 px-3 rounded-pill fw-bold';
                timerText.innerHTML = '<i class="fas fa-motorcycle me-1"></i> Đang giao hàng: dự kiến đến nơi sau <b>' + fmt + '</b>';
                return;
            }

            // Mặc định: Đang chuẩn bị món (Bước 1)
            progressBar.style.width = '33%';
            progressBar.className = 'progress-bar bg-danger';
            step1Icon.style.background = '#E11D48';
            step1Icon.style.color = '#fff';
            step1Icon.innerHTML = '<i class="fas fa-utensils"></i>';
            step2Icon.style.background = '#E2E8F0';
            step2Icon.style.color = '#64748B';
            step2Icon.innerHTML = '<i class="fas fa-motorcycle"></i>';
            step3Icon.style.background = '#E2E8F0';
            step3Icon.style.color = '#64748B';
            step3Icon.innerHTML = '<i class="fas fa-circle-check"></i>';

            step1Text.className = 'fw-bold small mt-2 text-danger';
            step2Text.className = 'fw-bold small mt-2 text-muted';
            step3Text.className = 'fw-bold small mt-2 text-muted';

            const remainPrep = Math.max(0, 300 - seconds);
            const minPrep = Math.floor(remainPrep / 60);
            const secPrep = remainPrep % 60;
            const fmtPrep = (minPrep < 10 ? '0' : '') + minPrep + ':' + (secPrep < 10 ? '0' : '') + secPrep;

            titleEl.textContent = 'Đang Chuẩn Bị Món';
            titleEl.className = 'fs-5 fw-bold text-danger mb-1';
            descEl.textContent = 'Đầu bếp đang chế biến các món ăn nóng hổi theo đơn của bạn.';
            timerBadge.className = 'badge bg-warning text-dark py-2 px-3 rounded-pill fw-bold';
            timerText.innerHTML = '<i class="fas fa-clock me-1"></i> Bếp đang làm món: chuyển giao hàng sau <b>' + fmtPrep + '</b>';
        }

        function trackFromSuccess() {
            const codeEl = document.getElementById('shopSuccessOrderCode');
            const code = codeEl ? codeEl.textContent.trim() : '';
            const modalEl = document.getElementById('shopOrderSuccessModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            }
            openTrackOrderModal(code);
        }

        function sendQuickPrompt(promptText) {
            const input = document.getElementById('botInput');
            if (input) input.value = promptText;
            sendBotMessage();
        }

        function formatBotMarkdown(text) {
            if (!text) return '';
            let html = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // In đậm **text**
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            // In nghiêng *text*
            html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
            // Mã `code`
            html = html.replace(/`(.*?)`/g, '<code class="bg-light px-1 rounded text-danger border">$1</code>');
            // Xuống dòng
            html = html.replace(/\n/g, '<br>');

            // Khôi phục các thẻ link an toàn đã được server cung cấp nếu có
            return html;
        }

        function sendBotMessage(overrideMsg) {
            const input = document.getElementById('botInput');
            const msg = (overrideMsg || (input ? input.value : '') || '').trim();
            if (!msg) return;

            const chatLogs = document.getElementById('chatLogs');
            chatLogs.innerHTML += '<div class="msg-bubble msg-user">' + msg.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</div>';
            if (input) input.value = '';
            chatLogs.scrollTop = chatLogs.scrollHeight;

            const tempId = 'bot-temp-' + Date.now();
            chatLogs.innerHTML += '<div id="' + tempId + '" class="msg-bubble msg-bot text-muted"><i class="fas fa-spinner fa-spin me-1 text-primary"></i> Trợ lý AI đang xử lý...</div>';
            chatLogs.scrollTop = chatLogs.scrollHeight;

            fetch('/Shop/ChatBot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, Message: msg })
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                const tempEl = document.getElementById(tempId);
                if (tempEl) tempEl.remove();

                let replyContent = res.reply || 'Dạ tôi đã ghi nhận thông tin!';
                let formatted = '';

                // Nếu trong reply có thẻ html từ server (như nút thanh toán VNPAY)
                if (replyContent.includes("<div") || replyContent.includes("<a")) {
                    const parts = replyContent.split(/\n\n(?=<div)/);
                    const textPart = parts[0] || '';
                    const htmlPart = parts.slice(1).join('\n\n') || '';
                    formatted = formatBotMarkdown(textPart) + (htmlPart ? '<div class="mt-2">' + htmlPart + '</div>' : '');
                } else {
                    formatted = formatBotMarkdown(replyContent);
                }

                // Nếu có mã đơn mới tạo từ AI, thêm nút bấm theo dõi nhanh
                if (res.orderCode) {
                    formatted += '<div class="mt-2 pt-2 border-top d-flex gap-2">' +
                        '<button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 rounded-2 fw-bold" onclick="openTrackOrderModal(\'' + res.orderCode + '\')">' +
                        '<i class="fas fa-truck-fast me-1"></i> Theo dõi đơn ' + res.orderCode + '</button>' +
                        '</div>';
                }

                chatLogs.innerHTML += '<div class="msg-bubble msg-bot shadow-sm"><span class="badge bg-primary me-1" style="font-size: 0.65rem;">AI</span> ' + formatted + '</div>';
                chatLogs.scrollTop = chatLogs.scrollHeight;
            })
            .catch(function(err) {
                console.error('ChatBot UI Error:', err);
                const tempEl = document.getElementById(tempId);
                if (tempEl) tempEl.remove();
                chatLogs.innerHTML += '<div class="msg-bubble msg-bot text-danger"><i class="fas fa-triangle-exclamation me-1"></i> Lỗi kết nối đến máy chủ AI. Vui lòng thử lại!</div>';
                chatLogs.scrollTop = chatLogs.scrollHeight;
            });
        }

        function switchRightPanel(tab) {
            const tabCart = document.getElementById('tabBtnCart');
            const tabAi = document.getElementById('tabBtnAi');
            const cartWrap = document.getElementById('cartPanelWrap');
            const botWrap = document.getElementById('botCardWrap');

            if (tab === 'ai') {
                if (tabCart) { 
                    tabCart.classList.remove('btn-dark', 'text-white', 'active'); 
                    tabCart.classList.add('text-muted'); 
                }
                if (tabAi) { 
                    tabAi.classList.add('btn-primary', 'text-white', 'active'); 
                    tabAi.classList.remove('text-muted'); 
                }
                if (cartWrap) { cartWrap.style.display = 'none'; }
                if (botWrap) { 
                    botWrap.style.display = 'flex'; 
                    botWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    setTimeout(function() {
                        const botIn = document.getElementById('botInput');
                        if (botIn) botIn.focus();
                    }, 250);
                }
            } else {
                if (tabAi) { 
                    tabAi.classList.remove('btn-primary', 'text-white', 'active'); 
                    tabAi.classList.add('text-muted'); 
                }
                if (tabCart) { 
                    tabCart.classList.add('btn-dark', 'text-white', 'active'); 
                    tabCart.classList.remove('text-muted'); 
                }
                if (cartWrap) { 
                    cartWrap.style.display = 'block'; 
                    cartWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                if (window.innerWidth < 992) {
                    if (botWrap) botWrap.style.display = 'none';
                } else {
                    if (botWrap) botWrap.style.display = 'flex';
                }
            }
        }

        function openFloatingAiChat() {
            switchRightPanel('ai');
            const botWrap = document.getElementById('botCardWrap') || document.getElementById('shopSidebarRight');
            if (botWrap) {
                botWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            setTimeout(function() {
                const botIn = document.getElementById('botInput');
                if (botIn) botIn.focus();
            }, 300);
        }

        // ==================== ĐÁNH GIÁ & KHIẾU NẠI DỊCH VỤ (GOOGLE PLAY STORE STYLE) ====================
        var currentFeedbackRating = 5;
        var ratingLabels = {
            1: '1/5 sao - Rất tệ (Cần quán cải thiện gấp!)',
            2: '2/5 sao - Chưa hài lòng',
            3: '3/5 sao - Bình thường / Ổn',
            4: '4/5 sao - Hài lòng & ngon miệng',
            5: '5/5 sao - Cực kỳ hài lòng & tuyệt vời! ✨'
        };

        function setFeedbackRating(star) {
            currentFeedbackRating = star;
            const input = document.getElementById('fbRating');
            if (input) input.value = star;
            const labelEl = document.getElementById('ratingLabelText');
            if (labelEl) labelEl.textContent = ratingLabels[star] || (star + '/5 sao');
            renderModalStars(star);
        }

        function previewStars(star) {
            renderModalStars(star);
            const labelEl = document.getElementById('ratingLabelText');
            if (labelEl) labelEl.textContent = ratingLabels[star] || (star + '/5 sao');
        }

        function resetPreviewStars() {
            renderModalStars(currentFeedbackRating);
            const labelEl = document.getElementById('ratingLabelText');
            if (labelEl) labelEl.textContent = ratingLabels[currentFeedbackRating] || (currentFeedbackRating + '/5 sao');
        }

        function renderModalStars(star) {
            const stars = document.querySelectorAll('#modalStarPicker .star-btn');
            stars.forEach(function(s, idx) {
                if (idx < star) {
                    s.className = 'fas fa-star text-warning star-btn';
                } else {
                    s.className = 'fas fa-star text-muted opacity-25 star-btn';
                }
            });
        }

        function setFeedbackCategory(cat, btnEl) {
            const input = document.getElementById('fbCategory');
            if (input) input.value = cat;
            const chips = document.querySelectorAll('#fbCategoryChips .category-chip');
            chips.forEach(function(c) {
                c.classList.remove('btn-dark', 'active');
                c.classList.add('btn-outline-secondary');
            });
            if (btnEl) {
                btnEl.classList.remove('btn-outline-secondary');
                btnEl.classList.add('btn-dark', 'active');
            }
        }

        function filterReviews(filterType, btnEl) {
            const buttons = document.querySelectorAll('#reviewFilterChips .review-filter-btn');
            buttons.forEach(function(b) {
                b.classList.remove('btn-dark', 'active');
                b.classList.add('btn-outline-secondary');
            });
            if (btnEl) {
                btnEl.classList.remove('btn-outline-secondary');
                btnEl.classList.add('btn-dark', 'active');
            }

            const items = document.querySelectorAll('#reviewCardsList .review-item');
            items.forEach(function(item) {
                const itemRating = parseInt(item.getAttribute('data-rating') || '5', 10);
                const hasReply = item.getAttribute('data-has-reply') === 'true';

                if (filterType === 'all') {
                    item.style.display = 'block';
                } else if (filterType === 'replied') {
                    item.style.display = hasReply ? 'block' : 'none';
                } else {
                    const targetStar = parseInt(filterType, 10);
                    item.style.display = (itemRating === targetStar) ? 'block' : 'none';
                }
            });
        }

        function voteReviewHelpful(reviewId, isHelpful, btnEl) {
            if (btnEl) btnEl.disabled = true;
            fetch('/Shop/VoteReview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: reviewId, isHelpful: isHelpful })
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    const yesEl = document.getElementById('voteYes_' + reviewId);
                    const noEl = document.getElementById('voteNo_' + reviewId);
                    if (yesEl && res.helpfulYes !== undefined) yesEl.textContent = res.helpfulYes;
                    if (noEl && res.helpfulNo !== undefined) noEl.textContent = res.helpfulNo;
                    showShopToast('Cảm ơn bạn đã phản hồi tính hữu ích!', 'success');
                }
            })
            .catch(function(err) {
                console.error('Vote review error:', err);
            });
        }

        function sendComplaint() {
            const nameEl = document.getElementById('fbName');
            const phoneEl = document.getElementById('fbPhone');
            const contentEl = document.getElementById('fbContent');
            const ratingEl = document.getElementById('fbRating');
            const catEl = document.getElementById('fbCategory');

            const name = nameEl ? nameEl.value.trim() : '';
            const phone = phoneEl ? phoneEl.value.trim() : '';
            const content = contentEl ? contentEl.value.trim() : '';
            const rating = ratingEl ? parseInt(ratingEl.value, 10) : 5;
            const category = catEl ? catEl.value.trim() : 'Chất lượng món ăn';

            if (!content && rating <= 3) {
                return showShopToast('Vui lòng nhập nội dung góp ý để quán hoàn thiện dịch vụ nhé!', 'warning');
            }

            const modalEl = document.getElementById('feedbackModal');
            const submitBtn = document.getElementById('btnSubmitFeedback');
            const originalText = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang gửi đánh giá...';
            }

            fetch('/Shop/SendComplaint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    CustomerName: name,
                    Phone: phone,
                    Content: content,
                    Rating: rating,
                    Category: category
                })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    showShopToast(data.message || 'Đã gửi đánh giá thành công!', 'success');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    if (contentEl) contentEl.value = '';

                    // Cập nhật thẻ bài đánh giá mới ngay trên trang
                    if (data.review) {
                        const r = data.review;
                        const initial = (r.CustomerName || 'K').trim().charAt(0).toUpperCase();
                        let starsHtml = '';
                        for (let i = 1; i <= 5; i++) {
                            starsHtml += '<i class="fas fa-star ' + (i <= r.Rating ? '' : 'text-muted opacity-25') + '"></i>';
                        }

                        const newCardHtml = 
                            '<div class="review-item border-bottom pb-4 animate__animated animate__fadeInDown" data-rating="' + r.Rating + '" data-has-reply="false">' +
                                '<div class="d-flex align-items-center justify-content-between mb-2">' +
                                    '<div class="d-flex align-items-center gap-3">' +
                                        '<div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; background-color: #0b57d0; font-size: 0.95rem;">' +
                                            initial +
                                        '</div>' +
                                        '<div>' +
                                            '<div class="fw-bold text-dark small">' + (r.CustomerName || 'Khách hàng') + ' <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.65rem;">Vừa đăng</span></div>' +
                                            '<div class="d-flex align-items-center gap-2 mt-0">' +
                                                '<div class="text-warning" style="font-size: 0.8rem;">' + starsHtml + '</div>' +
                                                '<span class="text-muted" style="font-size: 0.75rem;">Vừa xong</span>' +
                                                '<span class="badge bg-light text-muted border px-2 py-0" style="font-size: 0.7rem;">' + (r.Category || 'Góp ý') + '</span>' +
                                            '</div>' +
                                        '</div>' +
                                    '</div>' +
                                '</div>' +
                                '<p class="text-secondary small mb-3 lh-base ps-1" style="font-size: 0.9rem;">' + (r.Content || 'Đánh giá ' + r.Rating + ' sao') + '</p>' +
                                '<div class="d-flex align-items-center gap-2 mb-3 ps-1 small text-muted" style="font-size: 0.8rem;">' +
                                    '<span>Bài đánh giá này có hữu ích không?</span>' +
                                    '<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-0 fw-semibold" style="font-size: 0.78rem;" onclick="voteReviewHelpful(' + r.ReviewId + ', true, this)">Có (<span id="voteYes_' + r.ReviewId + '">0</span>)</button>' +
                                    '<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-0 fw-semibold" style="font-size: 0.78rem;" onclick="voteReviewHelpful(' + r.ReviewId + ', false, this)">Không (<span id="voteNo_' + r.ReviewId + '">0</span>)</button>' +
                                '</div>' +
                            '</div>';

                        const listEl = document.getElementById('reviewCardsList');
                        if (listEl) {
                            listEl.insertAdjacentHTML('afterbegin', newCardHtml);
                        }
                    }

                    // Cập nhật số liệu thống kê nếu có
                    if (data.stats) {
                        const s = data.stats;
                        const scoreEl = document.getElementById('summaryAvgScore');
                        if (scoreEl) scoreEl.textContent = (s.avgFormatted || '5.0').replace('.', ',');
                        const countEl = document.getElementById('summaryTotalCount');
                        if (countEl) countEl.innerHTML = '<span class="fw-semibold">' + s.total.toLocaleString('vi-VN') + '</span> đánh giá • <span class="text-muted">616.585</span> lượt phục vụ';

                        [5, 4, 3, 2, 1].forEach(function(star) {
                            const bar = document.getElementById('barStar' + star);
                            if (bar && s.starPercentages) {
                                bar.style.width = (s.starPercentages[star] || 0) + '%';
                            }
                            const cnt = document.getElementById('countStar' + star);
                            if (cnt && s.starCounts) {
                                cnt.textContent = (s.starCounts[star] || 0);
                            }
                        });
                    }
                } else {
                    showShopToast(data.message || 'Không thể gửi đánh giá!', 'warning');
                }
            })
            .catch(function(err) {
                console.error('Send complaint error:', err);
                showShopToast('Lỗi khi gửi phản hồi!', 'error');
            })
            .finally(function() {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        }

        window.addEventListener('DOMContentLoaded', function() {
            const savedTrackCode = localStorage.getItem('fastfood_track_code');
            if (savedTrackCode) {
                localStorage.removeItem('fastfood_track_code');
                setTimeout(function() {
                    openTrackOrderModal(savedTrackCode);
                }, 300);
            }

            const phoneEl = document.getElementById('custPhone');
            const phone = phoneEl ? phoneEl.value.trim() : '';
            if (phone && phone.length >= 9) {
                handlePhoneBlur();
            }
        });
    </script>
