                    <!-- 1. Chọn mức sao -->
                    <div class="text-center mb-4 p-3 bg-light rounded-3 border">
                        <label class="form-label small fw-bold text-dark text-uppercase d-block mb-2">Mức độ hài lòng của bạn:</label>
                        <div class="d-inline-flex align-items-center gap-2 fs-2 cursor-pointer" id="modalStarPicker">
